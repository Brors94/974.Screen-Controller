","style":{"weight":"1.2"},"text":"screens_save","type":"switch","value":"false","visible":true},{"style":{"weight":"0.5"},"type":"space"}],"style":{"weight":"1.2"},"type":"vertical"},{"components":[{"name":"screens_select","options":[],"selectionType":"multi","style":{"weight":"1.2"},"text":"screens_select","type":"select","values":[],"visible":true},{"style":{"weight":"0.5"},"type":"space"}],"style":{"weight":"1.2"},"type":"vertical"},{"components":[{"name":"info_lux","style":{"weight":"1.2"},"text":"info_lux","type":"label","visible":true},{"style":{"weight":"0.5"},"type":"space"}],"style":{"weight":"1.2"},"type":"vertical"},{"components":[{"name":"lux_save","style":{"weight":"1.2"},"text":"Save Lux Sensor","type":"button","visible":true},{"style":{"weight":"0.5"},"type":"space"}],"style":{"weight":"1.2"},"type":"vertical"},{"components":[{"name":"lux_select","options":[],"selectionType":"single","style":{"weight":"1.2"},"text":"Lux Sensor","type":"select","values":[],"visible":true},{"style":{"weight":"0.5"},"type":"space"}],"style":{"weight":"1.2"},"type":"vertical"},{"components":[{"name":"info_wind","style":{"weight":"1.2"},"text":"info_wind","type":"label","visible":true},{"style":{"weight":"0.5"},"type":"space"}],"style":{"weight":"1.2"},"type":"vertical"},{"components":[{"name":"wind_save","style":{"weight":"1.2"},"text":"wind_save","type":"switch","value":"false","visible":true},{"style":{"weight":"0.5"},"type":"space"}],"style":{"weight":"1.2"},"type":"vertical"},{"components":[{"name":"wind_select","options":[],"selectionType":"single","style":{"weight":"1.2"},"text":"wind_select","type":"select","values":[],"visible":true},{"style":{"weight":"0.5"},"type":"space"}],"style":{"weight":"1.2"},"type":"vertical"},{"components":[{"name":"space","style":{"weight":"1.2"},"text":"space","type":"label","visible":true},{"style":{"weight":"0.5"},"type":"space"}],"style":{"weight":"1.2"},"type":"vertical"},{"components":[{"name":"info_manual","style":{"weight":"1.2