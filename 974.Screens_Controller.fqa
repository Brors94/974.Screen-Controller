:["onLongPressDown","val_p","$event.value"]},"type":"deviceAction"}],"onLongPressReleased":[{"params":{"actionName":"UIAction","args":["onLongPressReleased","val_p","$event.value"]},"type":"deviceAction"}],"onReleased":[{"params":{"actionName":"UIAction","args":["onReleased","val_p","$event.value"]},"type":"deviceAction"}]},"name":"val_p","style":{"weight":"0.50"},"text":"val_p","type":"switch","value":"false","visible":true}],"style":{"weight":"1.0"},"type":"horizontal"},{"components":[{"eventBinding":{"onLongPressDown":[{"params":{"actionName":"UIAction","args":["onLongPressDown","change","$event.value"]},"type":"deviceAction"}],"onLongPressReleased":[{"params":{"actionName":"UIAction","args":["onLongPressReleased","change","$event.value"]},"type":"deviceAction"}],"onReleased":[{"params":{"actionName":"UIAction","args":["onReleased","change","$event.value"]},"type":"deviceAction"}]},"name":"change","style":{"weight":"0.50"},"text":"change","type":"switch","value":"false","visible":true},{"eventBinding":{"onLongPressDown":[{"params":{"actionName":"UIAction","args":["onLongPressDown","button_ID_11_2"]},"type":"deviceAction"}],"onLongPressReleased":[{"params":{"actionName":"UIAction","args":["onLongPressReleased","button_ID_11_2"]},"type":"deviceAction"}],"onReleased":[{"params":{"actionName":"UIAction","args":["onReleased","button_ID_11_2"]},"type":"deviceAction"}]},"name":"button_ID_11_2","style":{"weight":"0.50"},"text":" ","type":"button","visible":false}],"style":{"weight":"1.0"},"type":"horizontal"},{"components":[{"eventBinding":{"onLongPressDown":[{"params":{"actionName":"UIAction","args":["onLongPressDown","automation_disable","$event.value"]},"type":"deviceAction"}],"onLongPressReleased":[{"params":{"actionName":"UIAction","args":["onLongPressReleased","automation_disable","$event.value"]},"type":"deviceAction"}],"onReleased":[{"params":{"actionName":"UIAction","args":["onReleased","automation_disable","$event.value"]},"type":"deviceAction"}]},"name":"autom