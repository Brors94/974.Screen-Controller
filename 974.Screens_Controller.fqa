nts":[{"name":"info_lux","style":{"weight":"1.0"},"text":"info_lux","type":"label","visible":true}],"style":{"weight":"1.0"},"type":"horizontal"},{"components":[{"eventBinding":{"onLongPressDown":[{"params":{"actionName":"UIAction","args":["onLongPressDown","lux_save"]},"type":"deviceAction"}],"onLongPressReleased":[{"params":{"actionName":"UIAction","args":["onLongPressReleased","lux_save"]},"type":"deviceAction"}],"onReleased":[{"params":{"actionName":"UIAction","args":["onReleased","lux_save"]},"type":"deviceAction"}]},"name":"lux_save","style":{"weight":"1.0"},"text":"Save Lux Sensor","type":"button","visible":true}],"style":{"weight":"1.0"},"type":"horizontal"},{"components":[{"eventBinding":{"onToggled":[{"params":{"actionName":"UIAction","args":["onToggled","lux_select","$event.value"]},"type":"deviceAction"}]},"name":"lux_select","options":[],"selectionType":"single","style":{"weight":"1.0"},"text":"Lux Sensor","type":"select","values":[],"visible":true}],"style":{"weight":"1.0"},"type":"horizontal"},{"components":[{"name":"info_wind","style":{"weight":"1.0"},"text":"info_wind","type":"label","visible":true}],"style":{"weight":"1.0"},"type":"horizontal"},{"components":[{"eventBinding":{"onLongPressDown":[{"params":{"actionName":"UIAction","args":["onLongPressDown","wind_save","$event.value"]},"type":"deviceAction"}],"onLongPressReleased":[{"params":{"actionName":"UIAction","args":["onLongPressReleased","wind_save","$event.value"]},"type":"deviceAction"}],"onReleased":[{"params":{"actionName":"UIAction","args":["onReleased","wind_save","$event.value"]},"type":"deviceAction"}]},"name":"wind_save","style":{"weight":"1.0"},"text":"wind_save","type":"switch","value":"false","visible":true}],"style":{"weight":"1.0"},"type":"horizontal"},{"components":[{"eventBinding":{"onToggled":[{"params":{"actionName":"UIAction","args":["onToggled","wind_select","$event.value"]},"type":"deviceAction"}]},"name":"wind_select","options":[],"selectionType":"single","style":{"weight":"1.0"},"text":"wind_select","type":"select","values":[],"visible":true}],"style":{"weight":"1.0"},"type":"horizontal"},{"components":[{"name":"space","style":{"weight":"1.0"},"text":"space","type":"label","visible":true}],"style":{"weight":"1.0"},"type":"horizontal"},{"components":[{"name":"info_manual","style":{"weight":"1.0"},"text":"info_manual","type":"label","visible":true}],"style":{"weight":"1.0"},"type":"horizontal"},{"components":[{"name":"info_language","style":{"weight":"1.0"},"text":"info_language","type":"label","visible":true}],"style":{"weight":"1.0"},"type":"horizontal"},{"components":[{"eventBinding":{"onLongPressDown":[{"params":{"actionName":"UIAction","args":["onLongPressDown","language_save"]},"type":"deviceAction"}],"onLongPressReleased":[{"params":{"actionName":"UIAction","args":["onLongPressReleased","language_save"]},"type":"deviceAction"}],"onReleased":[{"params":{"actionName":"UIAction","args":["onReleased","language_save"]},"type":"deviceAction"}]},"name":"language_save","style":{"weight":"1.0"},"text":"Save Language","type":"button","visible":true}],"style":{"weight":"1.0"},"type":"horizontal"},{"components":[{"eventBinding":{"onToggled":[{"params":{"actionName":"UIAction","args":["onToggled","language_select","$event.value"]},"type":"deviceAction"}]},"name":"language_select","options":[],"selectionType":"single","style":{"weight":"1.0"},"text":"Language","type":"select","values":[],"visible":true}],"style":{"weight":"1.0"},"type":"horizontal"},{"components":[{"name":"error_status","style":{"weight":"1.0"},"text":"error_status","type":"label","visible":true}],"style":{"weight":"1.0"},"type":"horizontal"},{"components":[{"name":"space2","style":{"weight":"1.0"},"text":"space2","type":"label","visible":true}],"style":{"weight":"1.0"},"type":"horizontal"}],"useUiView":false,"uiCallbacks":[{"callback":"val_n","eventType":"onReleased","name":"val_n"},{"callback":"val_n_ld","eventType":"onLongPressDown","name":"val_n"},{"callback":"val_n_lr","eventType":"onLongPressReleased","name":"val_n"},{"callback":"val_p","eventType":"onReleased","name":"val_p"},{"callback":"val_p_ld","eventType":"onLongPressDown","name":"val_p"},{"callback":"val_p_lr","eventType":"onLongPressReleased","name":"val_p"},{"callback":"change","eventType":"onReleased","name":"change"},{"callback":"change_ld","eventType":"onLongPressDown","name":"change"},{"callback":"change_lr","eventType":"onLongPressReleased","name":"change"},{"callback":"a","eventType":"onReleased","name":"button_ID_11_2"},{"callback":"a","eventType":"onLongPressDown","name":"button_ID_11_2"},{"callback":"a","eventType":"onLongPressReleased","name":"button_ID_11_2"},{"callback":"automation_disable","eventType":"onReleased","name":"automation_disable"},{"callback":"automation_disable_ld","eventType":"onLongPressDown","name":"automation_disable"},{"callback":"automation_disable_lr","eventType":"onLongPressReleased","name":"automation_disable"},{"callback":"a","eventType":"onReleased","name":"button_ID_20_2"},{"callback":"a","eventType":"onLongPressDown","name":"button_ID_20_2"},{"callback":"a","eventType":"onLongPressReleased","name":"button_ID_20_2"},{"callback":"screens_save","eventType":"onReleased","name":"screens_save"},{"callback":"screens_save_ld","eventType":"onLongPressDown","name":"screens_save"},{"callback":"screens_save_lr","eventType":"onLongPressReleased","name":"screens_save"},{"callback":"screens_select","eventType":"onToggled","name":"screens_select"},{"callback":"lux_save","eventType":"onReleased","name":"lux_save"},{"callback":"","eventType":"onLongPressDown","name":"lux_save"},{"callback":"","eventType":"onLongPressReleased","name":"lux_save"},{"callback":"lux_select","eventType":"onToggled","name":"lux_select"},{"callback":"wind_save","eventType":"onReleased","name":"wind_save"},{"callback":"wind_save_ld","eventType":"onLongPressDown","name":"wind_save"},{"callback":"wind_save_lr","eventType":"onLongPressReleased","name":"wind_save"},{"callback":"wind_select","eventType":"onToggled","name":"wind_select"},{"callback":"language_save","eventType":"onReleased","name":"language_save"},{"callback":"","eventType":"onLongPressDown","name":"language_save"},{"callback":"","eventType":"onLongPressReleased","name":"language_save"},{"callback":"language_select","eventType":"onToggled","name":"language_select"}],"quickAppVariables":[{"name":"Debug","value":"false"}],"typeTemplateInitialized":true,"userDescription":"Screens/Base Shutters Controller\nVersion: v1.0.0\nLux sensor: ID: 697  Name: Lux Level setup\nWind sensor: ID: 888  Name: Test Wind Sensor\nScreens: 694:test screen\n890:test screen\nLux Screen Up: 5000 Lux\nLux Screen Down: 7000 Lux\nWind speed: 19 m/s\nWind below timer: 00:00:10\nDisable timer: 07:59:00\nScreen up timer: 00:00:10\nScreen down timer: 00:00:00\nStartup scan enabled"},"initialInterfaces":[],"files":[{"name":"main","isMain":true,"isOpen":false,"content":"--%%name:974.Screens Controller\n--%%type:com.fibaro.deviceController\n--%%project:974\n--%%manufacturer:JBS\n--%%model:Screens Controller\n--%%description:Controller for screens and base shutters with saved lux sensor selection.\n--%%var:Debug=\"false\"\n--%%file:C:\\Users\\GREENCOM\\Workspace\\PLUA\\Librarys\\Eventlib.lua,Eventlib\n--%%file:974.Screens Controller\\974_Screens_Controller_696_Config.lua,Config\n--%%file:974.Screens Controller\\974_Screens_Controller_696_Language.lua,Language\n--%%file:974.Screens Controller\\974_Screens_Controller_696_Icon.lua,Icon\n\n--%%u:{label=\"info\",text=\"\"}\n--%%u:{{switch=\"val_n\",text=\"➖\",value=\"false\",onLongPressDown=\"val_n_ld\",onLongPressReleased=\"val_n_lr\",onReleased=\"val_n\"},{switch=\"change\",text=\"Change\",value=\"false\",onLongPressDown=\"change_ld\",onLongPressReleased=\"change_lr\",onReleased=\"change\"},{switch=\"val_p\",text=\"➕\",value=\"false\",onLongPressDown=\"val_p_ld\",onLongPressReleased=\"val_p_lr\",onReleased=\"val_p\"}}\n--%%u:{switch=\"automation_disable\",text=\"Lux automation ON\",value=\"true\",onReleased=\"automation_disable\"}\n\n\n--%%u:{label=\"info_events\",text=\"\"}\n--%%u:{button=\"screens_save\",text=\"Save Screens\",onReleased=\"screens_save\"}\n--%%u:{multi=\"screens_select\",text=\"Screens\",value=\"\",onToggled=\"screens_select\",options={}}\n--%%u:{label=\"info_screens\",text=\"\"}\n\n--%%u:{label=\"info_lux\",text=\"\"}\n--%%u:{button=\"lux_save\",text=\"Save Lux Sensor\",onReleased=\"lux_save\"}\n--%%u:{select=\"lux_select\",text=\"Lux Sensor\",value=\"\",onToggled=\"lux_select\",options={}}\n\n--%%u:{label=\"info_wind\",text=\"\"}\n--%%u:{button=\"wind_save\",text=\"Save Wind Sensor\",onReleased=\"wind_save\"}\n--%%u:{select=\"wind_select\",text=\"Wind Sensor\",value=\"\",onToggled=\"wind_select\",options={}}\n\n\n--%%u:{label=\"space\",text=\"\"}\n\n--%%u:{label=\"info_manual\",text=\"\"}\n\n--%%u:{label=\"info_language\",text=\"\"}\n--%%u:{button=\"language_save\",text=\"Save Language\",onReleased=\"language_save\"}\n--%%u:{select=\"language_select\",text=\"Language\",value=\"\",onToggled=\"language_select\",options={}}\n\n--%%u:{label=\"error_status\",text=\"\"}\n--%%u:{label=\"space2\",text=\"\"}\n\nlocal qa_type = \"974.Screens Controller\"\nlocal version = \"v1.0.0\"\nlocal revision_date = \"02/05/26 03:19:28\"\n\n--[[\nMIT License\n\nCopyright (c) 2026 Joachim Brors Sommerfeld\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n\n(Source: opensource.org)\n]]\n\n---@diagnostic disable\n\n-- ===========================================================\n-- ---------------Configuration----------------\n-- ===========================================================\n\nlocal CONFIG = ScreensControllerConfig or {}\nCONFIG.quickAppUuid = CONFIG.quickAppUuid or \"JBS974\"\nCONFIG.storageKeys = CONFIG.storageKeys or {}\nCONFIG.storageKeys.luxSensorId = CONFIG.storageKeys.luxSensorId or \"lux_sensor_id\"\nCONFIG.storageKeys.windSensorId = CONFIG.storageKeys.windSensorId or \"wind_sensor_id\"\nCONFIG.storageKeys.screenDeviceIds = CONFIG.storageKeys.screenDeviceIds or \"screen_device_ids\"\nCONFIG.storageKeys.windSpeed = CONFIG.storageKeys.windSpeed or \"wind_speed\"\nCONFIG.storageKeys.windBelowTimerSeconds = CONFIG.storageKeys.windBelowTimerSeconds or \"wind_below_t\"\nCONFIG.storageKeys.disableTimerSeconds = CONFIG.storageKeys.disableTimerSeconds or \"disable_timer\"\nCONFIG.storageKeys.screenUpTimerSeconds = CONFIG.storageKeys.screenUpTimerSeconds or \"screen_up_timer\"\nCONFIG.storageKeys.screenDownTimerSeconds = CONFIG.storageKeys.screenDownTimerSeconds or \"screen_down_timer\"\nCONFIG.storageKeys.luxThreshold = CONFIG.storageKeys.luxThreshold or \"lux_threshold\"\nCONFIG.storageKeys.luxUp = CONFIG.storageKeys.luxUp or \"lux_up\"\nCONFIG.storageKeys.luxDown = CONFIG.storageKeys.luxDown or \"lux_down\"\nCONFIG.storageKeys.languageCode = CONFIG.storageKeys.languageCode or \"ui_language\"\nCONFIG.storageKeys.statusLog = CONFIG.storageKeys.statusLog or \"status_log\"\nCONFIG.storageKeys.eventLog = CONFIG.storageKeys.eventLog or \"event_log\"\nCONFIG.storageKeys.memMaxKb = CONFIG.storageKeys.memMaxKb or \"mem_max_kb\"\nCONFIG.storageKeys.cpuMaxPct = CONFIG.storageKeys.cpuMaxPct or \"cpu_max_pct\"\nCONFIG.lux = CONFIG.lux or {}\nCONFIG.lux.typeQuery = CONFIG.lux.typeQuery or \"com.fibaro.lightSensor\"\nCONFIG.lux.unit = CONFIG.lux.unit or \"Lux\"\nCONFIG.wind = CONFIG.wind or {}\nCONFIG.wind.typeQuery = CONFIG.wind.typeQuery or \"com.fibaro.windSensor\"\nCONFIG.wind.speed = CONFIG.wind.speed or {}\nCONFIG.timer = CONFIG.timer or {}\nCONFIG.screens = CONFIG.screens or {}\nCONFIG.screens.typeQueries = CONFIG.screens.typeQueries or {\n  \"com.fibaro.rollerShutter\",\n  \"com.fibaro.baseShutter\",\n  \"com.fibaro.windowCovering\",\n  \"com.fibaro.multilevelSwitch\",\n}\nlocal start_clock = os.clock()\nlocal LANGUAGE_OPTIONS = {}\nlocal LANGUAGE_INDEX = {}\nlocal ADJUST_CONFIG = type(CONFIG.adjust) == \"table\" and CONFIG.adjust or {}\nlocal LEGACY_LUX_THRESHOLD_STORAGE_KEY = ((CONFIG.storageKeys or {}).luxThreshold) or \"lux_threshold\"\nlocal LUX_UP_STORAGE_KEY = ((CONFIG.storageKeys or {}).luxUp) or \"lux_up\"\nlocal LUX_DOWN_STORAGE_KEY = ((CONFIG.storageKeys or {}).luxDown) or \"lux_down\"\nlocal LUX_THRESHOLD_MIN = tonumber(ADJUST_CONFIG.minValue) or 0\nlocal LUX_THRESHOLD_MAX = tonumber(ADJUST_CONFIG.maxValue) or 50000\nlocal LUX_THRESHOLD_TAP_STEP = tonumber(ADJUST_CONFIG.tapStep) or 100\nlocal LUX_THRESHOLD_HOLD_STEP = tonumber(ADJUST_CONFIG.holdStep) or 1000\nlocal LUX_THRESHOLD_HOLD_DELAY_MS = tonumber(ADJUST_CONFIG.holdDelayMs) or 2000\nlocal LUX_THRESHOLD_HOLD_REPEAT_MS = tonumber(ADJUST_CONFIG.holdRepeatMs) or 300\nlocal LUX_THRESHOLD_PERSIST_DELAY_MS = tonumber(ADJUST_CONFIG.persistDelayMs) or 5000\nlocal LUX_THRESHOLD_DEFAULT = tonumber(ADJUST_CONFIG.defaultValue) or 0\nlocal LUX_UNIT = tostring(CONFIG.lux.unit or \"Lux\")\nlocal WIND_SPEED_CONFIG = type((CONFIG.wind or {}).speed) == \"table\" and CONFIG.wind.speed or {}\nlocal WIND_SPEED_STORAGE_KEY = CONFIG.storageKeys.windSpeed\nlocal WIND_SPEED_MIN = tonumber(WIND_SPEED_CONFIG.minValue) or 0\nlocal WIND_SPEED_MAX = tonumber(WIND_SPEED_CONFIG.maxValue) or 50\nlocal WIND_SPEED_TAP_STEP = tonumber(WIND_SPEED_CONFIG.tapStep) or 1\nlocal WIND_SPEED_HOLD_STEP = tonumber(WIND_SPEED_CONFIG.holdStep) or 5\nlocal WIND_SPEED_DEFAULT = tonumber(WIND_SPEED_CONFIG.defaultValue) or 10\nlocal LEGACY_TIMER_SECONDS_STORAGE_KEY = \"timer_seconds\"\nlocal WIND_BELOW_TIMER_SECONDS_STORAGE_KEY = CONFIG.storageKeys.windBelowTimerSeconds\nlocal DISABLE_TIMER_SECONDS_STORAGE_KEY = CONFIG.storageKeys.disableTimerSeconds\nlocal SCREEN_UP_TIMER_SECONDS_STORAGE_KEY = CONFIG.storageKeys.screenUpTimerSeconds\nlocal SCREEN_DOWN_TIMER_SECONDS_STORAGE_KEY = CONFIG.storageKeys.screenDownTimerSeconds\nlocal TIMER_SECONDS_MIN = tonumber(CONFIG.timer.minSeconds) or 0\nlocal TIMER_SECONDS_MAX = tonumber(CONFIG.timer.maxSeconds) or 3600\nlocal DISABLE_TIMER_SECONDS_MAX = tonumber(CONFIG.timer.disableMaxSeconds) or 86400\nlocal TIMER_SECONDS_TAP_STEP = tonumber(CONFIG.timer.tapStepSeconds) or 10\nlocal TIMER_SECONDS_HOLD_STEP = tonumber(CONFIG.timer.holdStepSeconds) or 60\nlocal TIMER_SECONDS_HOLD_FAST_STEP = tonumber(CONFIG.timer.holdFastStepSeconds) or 3600\nlocal SCREEN_UP_TIMER_SECONDS_DEFAULT = tonumber(CONFIG.timer.defaultUpSeconds) or 900\nlocal SCREEN_DOWN_TIMER_SECONDS_DEFAULT = tonumber(CONFIG.timer.defaultDownSeconds) or 0\nlocal WIND_BELOW_TIMER_SECONDS_DEFAULT = tonumber(CONFIG.timer.defaultWindBelowSeconds) or 300\nlocal DISABLE_TIMER_SECONDS_DEFAULT = tonumber(CONFIG.timer.defaultDisableSeconds) or 300\nlocal CONTROL_FEEDBACK_MS = 180\nlocal UNSELECT_OPTION_VALUE = \"__unselect__\"\n\n-- ===========================================================\n-- ---------------EventLib Fallback----------------\n-- ===========================================================\n\nif type(Event_std) ~= \"table\" then\n  local fallback_event_state = {\n    attached = false,\n    subscriber = nil,\n    registrations = {},\n    pending = nil,\n    id = nil,\n    tag = nil,\n    tagColor = nil,\n  }\n\n  -- Flatten one id or id-list into a plain array.\n  -------------------------------------------------------------------------------------------\n  local function fallback_event_ids(value)\n    local ids = {}\n    if type(value) ~= \"table\" then\n      local single = value ~= nil and (tonumber(value) or value) or nil\n      if single ~= nil then ids[1] = single end\n      return ids\n    end\n\n    for _, item in ipairs(value) do\n      if type(item) == \"table\" then\n        for _, nested in ipairs(fallback_event_ids(item)) do\n          ids[#ids + 1] = nested\n        end\n      else\n        local normalized = tonumber(item) or item\n        if normalized ~= nil then ids[#ids + 1] = normalized end\n      end\n    end\n\n    return ids\n  end\n\n  -- Match one translated device event against one registration.\n  -------------------------------------------------------------------------------------------\n  local function fallback_event_matches(registration, event)\n    if tostring(registration.type or \"\") ~= \"device\" then return false end\n    if tostring(event.type or \"\") ~= \"device\" then return false end\n\n    local wanted_property = tostring(registration.property or \"\")\n    if wanted_property ~= \"\" and wanted_property ~= tostring(event.property or \"\") then return false end\n\n    local event_id = tostring(event.id or \"\")\n    for _, wanted_id in ipairs(registration.ids or {}) do\n      if tostring(wanted_id) == event_id then return true end\n    end\n\n    return false\n  end\n\n  -- Translate one refresh-state event into the EventLib-style device shape.\n  -------------------------------------------------------------------------------------------\n  local function fallback_translate_event(event)\n    if type(event) ~= \"table\" or tostring(event.type or \"\") ~= \"DevicePropertyUpdatedEvent\" then return nil end\n\n    local data = type(event.data) == \"table\" and event.data or {}\n    return {\n      type = \"device\",\n      id = data.id,\n      property = data.property,\n      value = data.newValue,\n      old = data.oldValue,\n    }\n  end\n\n  -- Dispatch one translated refresh-state event to matching registrations.\n  -------------------------------------------------------------------------------------------\n  local function fallback_dispatch_event(event_object, translated_event)\n    for _, registration in ipairs(fallback_event_state.registrations) do\n      if fallback_event_matches(registration, translated_event) then\n        registration.handler(event_object, translated_event)\n      end\n    end\n  end\n\n  local fallback_event_methods = {}\n\n  -- Start one RefreshStateSubscriber that feeds registered device listeners.\n  -------------------------------------------------------------------------------------------\n  function fallback_event_methods:attachRefreshstate()\n    if fallback_event_state.attached then return true end\n    if type(RefreshStateSubscriber) ~= \"function\" then return false, \"RefreshStateSubscriber unavailable\" end\n\n    fallback_event_state.subscriber = RefreshStateSubscriber()\n    fallback_event_state.subscriber:subscribe(\n      function(event)\n        return type(event) == \"table\" and tostring(event.type or \"\") == \"DevicePropertyUpdatedEvent\"\n      end,\n      function(event)\n        local translated = fallback_translate_event(event)\n        if translated ~= nil then fallback_dispatch_event(self, translated) end\n      end\n    )\n    fallback_event_state.subscriber:run()\n    fallback_event_state.attached = true\n\n    fibaro = fibaro or {}\n    fibaro._APP = fibaro._APP or {}\n    fibaro._APP.trigger = fibaro._APP.trigger or {}\n    fibaro._APP.trigger.stop = function()\n      if Event_std and type(Event_std.stop) == \"function\" then Event_std:stop() end\n    end\n\n    return true\n  end\n\n  -- Stop the active fallback refresh-state subscriber.\n  -------------------------------------------------------------------------------------------\n  function fallback_event_methods:stop()\n    if fallback_event_state.subscriber ~= nil then\n      pcall(function() fallback_event_state.subscriber:stop() end)\n      fallback_event_state.subscriber = nil\n    end\n    fallback_event_state.attached = false\n  end\n\n  local fallback_event_mt = {}\n\n  -- Support Event_std{...} registration syntax used by this QA.\n  -------------------------------------------------------------------------------------------\n  function fallback_event_mt.__call(self, definition)\n    fallback_event_state.pending = {\n      id = tostring(fallback_event_state.id or \"_\"),\n      tag = tostring(fallback_event_state.tag or \"\"),\n      tagColor = tostring(fallback_event_state.tagColor or \"\"),\n      definition = type(definition) == \"table\" and definition or {},\n    }\n    return self\n  end\n\n  -- Expose fallback Event_std methods plus the stored field values.\n  -------------------------------------------------------------------------------------------\n  function fallback_event_mt.__index(_, key)\n    if fallback_event_methods[key] ~= nil then return fallback_event_methods[key] end\n    return fallback_event_state[key]\n  end\n\n  -- Capture handler registrations after Event_std{...}.\n  -------------------------------------------------------------------------------------------\n  function fallback_event_mt.__newindex(_, key, value)\n    if key == \"handler\" and type(value) == \"function\" and type(fallback_event_state.pending) == \"table\" then\n      local definition = type(fallback_event_state.pending.definition) == \"table\" and fallback_event_state.pending.definition or {}\n      fallback_event_state.registrations[#fallback_event_state.registrations + 1] = {\n        id = fallback_event_state.pending.id,\n        tag = fallback_event_state.pending.tag,\n        tagColor = fallback_event_state.pending.tagColor,\n        type = tostring(definition.type or \"\"),\n        property = tostring(definition.property or \"\"),\n        ids = fallback_event_ids(definition.id),\n        handler = value,\n      }\n      fallback_event_state.pending = nil\n      return\n    end\n\n    fallback_event_state[key] = value\n  end\n\n  Event_std = setmetatable({}, fallback_event_mt)\nend\n\nfor _, item in ipairs(CONFIG.languageChoices or {}) do\n  local code = tostring(item.code or \"\")\n  if code ~= \"\" then\n    LANGUAGE_INDEX[string.lower(code)] = code\n    LANGUAGE_OPTIONS[#LANGUAGE_OPTIONS + 1] = {\n      text = string.format(\"%s (%s)\", tostring(item.label or code), code),\n      type = \"option\",\n      value = code,\n    }\n  end\nend\n\n-- ===========================================================\n-- ---------------Generic helpers----------------\n-- ===========================================================\n\n-- Escape HTML so label content renders safely in the QA.\n-------------------------------------------------------------------------------------------\nlocal function html_escape(value)\n  local text = tostring(value or \"\")\n  text = text:gsub(\"&\", \"&amp;\")\n  text = text:gsub(\"<\", \"&lt;\")\n  text = text:gsub(\">\", \"&gt;\")\n  text = text:gsub(\"\\\"\", \"&quot;\")\n  return text\nend\n\n-- Wrap a text value in a color tag.\n-------------------------------------------------------------------------------------------\nlocal function paint(text, color)\n  return \"<font color=\\\"\" .. tostring(color or \"#ffffff\") .. \"\\\">\" .. tostring(text or \"\") .. \"</font>\"\nend\n\n-- Round a numeric value to the requested decimal count.\n-------------------------------------------------------------------------------------------\nlocal function round_number(value, decimals)\n  local factor = 10 ^ (tonumber(decimals) or 0)\n  local number = tonumber(value) or 0\n  return math.floor(number * factor + 0.5) / factor\nend\n\n-- Clamp a number between the requested lower and upper bounds.\n-------------------------------------------------------------------------------------------\nlocal function clamp_number(value, minimum, maximum)\n  local number = tonumber(value) or 0\n  local lower = tonumber(minimum) or number\n  local upper = tonumber(maximum) or number\n  if number < lower then return lower end\n  if number > upper then return upper end\n  return number\nend\n\n-- Return the hold step from the current repeat count.\n-------------------------------------------------------------------------------------------\nlocal function get_hold_step(repeat_count, tap_step, hold_step, fast_step)\n  local count = math.max(0, math.floor(tonumber(repeat_count) or 0))\n  local elapsed = count * LUX_THRESHOLD_HOLD_REPEAT_MS\n  if elapsed < LUX_THRESHOLD_HOLD_DELAY_MS then return tonumber(tap_step) or LUX_THRESHOLD_TAP_STEP end\n  if fast_step ~= nil then return tonumber(fast_step) or tonumber(hold_step) or LUX_THRESHOLD_HOLD_STEP end\n  return tonumber(hold_step) or LUX_THRESHOLD_HOLD_STEP\nend\n\n-- Format seconds as compact HH:MM:SS for timer settings.\n-------------------------------------------------------------------------------------------\nlocal function format_timer_seconds(value)\n  local seconds = math.max(0, math.floor(tonumber(value) or 0))\n  local hours = math.floor(seconds / 3600)\n  local minutes = math.floor((seconds % 3600) / 60)\n  local rest = seconds % 60\n  return string.format(\"%02d:%02d:%02d\", hours, minutes, rest)\nend\n\n-- Read Lua memory usage in kB when the runtime exposes collectgarbage().\n-------------------------------------------------------------------------------------------\nlocal function read_memory_kb()\n  if type(collectgarbage) ~= \"function\" then return 0 end\n\n  pcall(collectgarbage, \"collect\")\n  local ok, value = pcall(collectgarbage, \"count\")\n  if not ok then return 0 end\n  return round_number(value, 0)\nend\n\n-- Format timestamps for UI cards and logs.\n-------------------------------------------------------------------------------------------\nlocal function format_datetime(timestamp)\n  local number = tonumber(timestamp) or 0\n  if number <= 0 then return \"waiting\" end\n  return os.date(\"%Y-%m-%d %H:%M:%S\", number)\nend\n\n-- Format timestamps for the diagnostics log.\n-------------------------------------------------------------------------------------------\nlocal function format_status_timestamp(timestamp)\n  local number = tonumber(timestamp) or 0\n  if number <= 0 then return \"waiting\" end\n  return os.date(\"%d.%m.%y    %H:%M\", number)\nend\n\n-- Normalize a device id into a plain integer string.\n-------------------------------------------------------------------------------------------\nlocal function normalize_device_id(value)\n  local number = tonumber(value)\n  if number == nil then return nil end\n  number = math.floor(number)\n  if number <= 0 then return nil end\n  return tostring(number)\nend\n\n-- Normalize a value or list of values into unique device id strings.\n-------------------------------------------------------------------------------------------\nlocal function normalize_device_id_list(value)\n  local ids = {}\n  local seen = {}\n  local source = type(value) == \"table\" and value or { value }\n\n  for _, item in ipairs(source) do\n    local id = normalize_device_id(item)\n    if id ~= nil and not seen[id] then\n      seen[id] = true\n      ids[#ids + 1] = id\n    end\n  end\n\n  table.sort(ids, function(left, right) return (tonumber(left) or 0) < (tonumber(right) or 0) end)\n  return ids\nend\n\n-- Normalize configured language codes to the supported option list.\n-------------------------------------------------------------------------------------------\nlocal function normalize_language_code(value)\n  local text = tostring(value or \"\")\n  if text == \"\" then return nil end\n  return LANGUAGE_INDEX[string.lower(text)] or nil\nend\n\n-- Return true when a device advertises the requested role.\n-------------------------------------------------------------------------------------------\nlocal function device_has_role(device, expected_role)\n  local properties = type(device.properties) == \"table\" and device.properties or {}\n  if tostring(properties.deviceRole or \"\"):lower() == tostring(expected_role or \"\"):lower() then\n    return true\n  end\n\n  local roles = properties.supportedDeviceRoles\n  if type(roles) ~= \"table\" then return false end\n\n  for _, role in ipairs(roles) do\n    if tostring(role or \"\"):lower() == tostring(expected_role or \"\"):lower() then\n      return true\n    end\n  end\n  return false\nend\n\n-- Return true when the device looks like a lux sensor.\n-------------------------------------------------------------------------------------------\nlocal function is_lux_sensor_device(device)\n  if type(device) ~= \"table\" then return false end\n  if device.enabled == false then return false end\n\n  local properties = type(device.properties) == \"table\" and device.properties or {}\n  local unit = tostring(properties.unit or \"\"):lower()\n  local device_type = tostring(device.type or \"\"):lower()\n  local base_type = tostring(device.baseType or \"\"):lower()\n\n  if device_type == \"com.fibaro.lightsensor\" then return true end\n  if device_has_role(device, \"LightSensor\") then return true end\n  if device_type == \"com.fibaro.multilevelsensor\" and base_type == \"com.fibaro.sensor\" and (unit == \"lux\" or unit == \"lx\") then return true end\n  return unit == \"lux\" or unit == \"lx\"\nend\n\n-- Return true when the device looks like a wind sensor.\n-------------------------------------------------------------------------------------------\nlocal function is_wind_sensor_device(device)\n  if type(device) ~= \"table\" then return false end\n  if device.enabled == false then return false end\n\n  local properties = type(device.properties) == \"table\" and device.properties or {}\n  local unit = tostring(properties.unit or \"\"):lower()\n  local device_type = tostring(device.type or \"\"):lower()\n  local base_type = tostring(device.baseType or \"\"):lower()\n\n  if device_type == \"com.fibaro.windsensor\" then return true end\n  if device_has_role(device, \"WindSensor\") then return true end\n  if device_type == \"com.fibaro.multilevelsensor\" and base_type == \"com.fibaro.sensor\" then\n    return unit == \"m/s\" or unit == \"km/h\" or unit == \"mph\" or unit == \"kn\" or unit == \"bft\"\n  end\n  return unit == \"m/s\" or unit == \"km/h\" or unit == \"mph\" or unit == \"kn\" or unit == \"bft\"\nend\n\n-- Return true when the device looks like a controllable screen/shutter.\n-------------------------------------------------------------------------------------------\nlocal function is_screen_device(device)\n  if type(device) ~= \"table\" then return false end\n  if device.enabled == false then return false end\n\n  local properties = type(device.properties) == \"table\" and device.properties or {}\n  local device_type = tostring(device.type or \"\"):lower()\n  local base_type = tostring(device.baseType or \"\"):lower()\n  local role = tostring(properties.deviceRole or \"\"):lower()\n  local name = tostring(device.name or \"\"):lower()\n  local actions = type(device.actions) == \"table\" and device.actions or {}\n\n  if device_type == \"com.fibaro.rollershutter\" then return true end\n  if device_type == \"com.fibaro.baseshutter\" then return true end\n  if device_type == \"com.fibaro.windowcovering\" then return true end\n  if role == \"rollershutter\" or role == \"windowcovering\" or role == \"blind\" or role == \"blindswithoutpositioning\" then return true end\n  if actions.open ~= nil and actions.close ~= nil and actions.stop ~= nil then return true end\n  if base_type == \"com.fibaro.multilevelswitch\" and (name:find(\"screen\", 1, true) or name:find(\"shutter\", 1, true) or name:find(\"markise\", 1, true)) then return true end\n  return false\nend\n\n-- Build a compact HTML info card used by the QA labels.\n-------------------------------------------------------------------------------------------\nlocal function build_info_table(title, rows)\n  local parts = {}\n  parts[#parts + 1] = \"<table width=\\\"\" .. tostring(CONFIG.ui.widthPx or 420) .. \"\\\" border=\\\"0\\\" style=\\\"table-layout:fixed;\\\">\"\n  parts[#parts + 1] = \"<tr><td colspan=\\\"2\\\" align=\\\"center\\\"><font size=\\\"\" ..\n    tostring(CONFIG.ui.titleFontSize or 4) .. \"\\\">\" ..\n    paint(\"<b>\" .. html_escape(title) .. \"</b>\", CONFIG.colors.title) ..\n    \"</font></td></tr>\"\n\n  for _, row in ipairs(rows or {}) do\n    if row.fullWidth then\n      parts[#parts + 1] = \"<tr><td colspan=\\\"2\\\" align=\\\"left\\\"><font size=\\\"\" ..\n        tostring(CONFIG.ui.bodyFontSize or 2) .. \"\\\">\" ..\n        paint(html_escape(row.label or \"\"), row.labelColor or CONFIG.colors.title) ..\n        \"</font><br><font size=\\\"\" .. tostring(CONFIG.ui.bodyFontSize or 2) .. \"\\\">\" ..\n        paint(html_escape(row.value or \"\"):gsub(\"\\n\", \"<br>\"), row.valueColor or CONFIG.colors.ok) ..\n        \"</font></td></tr>\"\n    else\n      parts[#parts + 1] = \"<tr><td align=\\\"left\\\"><font size=\\\"\" ..\n        tostring(CONFIG.ui.bodyFontSize or 2) .. \"\\\">\" ..\n        paint(html_escape(row.label or \"\"), row.labelColor or CONFIG.colors.title) ..\n        \"</font></td><td align=\\\"right\\\"><font size=\\\"\" ..\n        tostring(CONFIG.ui.bodyFontSize or 2) .. \"\\\">\" ..\n        paint(html_escape(row.value or \"\"), row.valueColor or CONFIG.colors.ok) ..\n        \"</font></td></tr>\"\n    end\n  end\n\n  parts[#parts + 1] = \"</table>\"\n  return table.concat(parts)\nend\n\n-- Return the color used for a log entry level.\n-------------------------------------------------------------------------------------------\nlocal function log_level_color(level)\n  local text = tostring(level or \"\"):lower()\n  if text == \"error\" then return CONFIG.colors.error end\n  if text == \"warn\" or text == \"warning\" then return CONFIG.colors.title end\n  return CONFIG.colors.info\nend\n\n-- Build the diagnostics card for the error_status label.\n-------------------------------------------------------------------------------------------\nlocal function build_error_status_table(title, rows, log_entries)\n  local parts = {}\n  parts[#parts + 1] = \"<table width=\\\"\" .. tostring(CONFIG.ui.widthPx or 420) .. \"\\\" border=\\\"0\\\" style=\\\"table-layout:fixed;\\\">\"\n  parts[#parts + 1] = \"<tr><td colspan=\\\"2\\\" align=\\\"center\\\"><font size=\\\"\" ..\n    tostring(CONFIG.ui.titleFontSize or 4) .. \"\\\">\" ..\n    paint(\"<b>\" .. html_escape(title) .. \"</b>\", CONFIG.colors.title) ..\n    \"</font></td></tr>\"\n\n  for _, row in ipairs(rows or {}) do\n    parts[#parts + 1] = \"<tr><td align=\\\"left\\\"><font size=\\\"\" ..\n      tostring(CONFIG.ui.bodyFontSize or 2) .. \"\\\">\" ..\n      paint(html_escape(row.label or \"\"), row.labelColor or CONFIG.colors.title) ..\n      \"</font></td><td align=\\\"right\\\"><font size=\\\"\" ..\n      tostring(CONFIG.ui.bodyFontSize or 2) .. \"\\\">\" ..\n      paint(html_escape(row.value or \"\"), row.valueColor or CONFIG.colors.info) ..\n      \"</font></td></tr>\"\n  end\n\n  if type(log_entries) == \"table\" and #log_entries > 0 then\n    parts[#parts + 1] = \"<tr><td colspan=\\\"2\\\"><hr style=\\\"border:1px solid \" .. tostring(CONFIG.colors.title) .. \";\\\"></td></tr>\"\n    for _, entry in ipairs(log_entries) do\n      local color = log_level_color(entry.level)\n      local line = string.format(\n        \"%s  %s\",\n        format_status_timestamp(entry.at),\n        tostring(entry.message or \"\")\n      )\n      parts[#parts + 1] = \"<tr><td colspan=\\\"2\\\" align=\\\"left\\\"><font size=\\\"\" ..\n        tostring(CONFIG.ui.logFontSize or 1) .. \"\\\">\" ..\n        paint(html_escape(line), color) ..\n        \"</font></td></tr>\"\n    end\n  end\n\n  parts[#parts + 1] = \"</table>\"\n  return table.concat(parts)\nend\n\nlocal INLINE_TRANSLATIONS = {\n  en = {\n    qa_title = \"Screens Controller\", qa_version = \"QA version\", revision_date = \"Revision\",\n    lux_sensor_count = \"Lux sensors\", lux_sensor_panel = \"Lux Sensor\", lux_sensor_dropdown = \"Lux Sensor\",\n    save_lux_sensor = \"Save Lux Sensor\", available_sensors = \"Available\", saved_sensor = \"Saved sensor\",\n    current_lux_value = \"Current lux\", last_value_update = \"Last update\", waiting_for_event = \"Waiting for value\",\n    selected_sensor = \"Selected\", last_scan = \"Last scan\", status = \"Status\", pending_save = \"Pending save\",\n    not_selected = \"Not selected\", unselect = \"Unselect\", missing_sensor = \"Missing sensor\", no_lux_sensors = \"No lux sensors found\",\n    no_valid_lux_sensor = \"No valid lux sensor selected\", wind_sensor_count = \"Wind sensors\",\n    wind_sensor_panel = \"Wind Sensor\", wind_sensor_dropdown = \"Wind Sensor\",\n    save_wind_sensor = \"Save Wind Sensor\", saved_wind_sensor = \"Saved wind sensor\",\n    no_wind_sensors = \"No wind sensors found\", no_valid_wind_sensor = \"No valid wind sensor selected\",\n    screen_count = \"Screens\", screen_panel = \"Screens\", screen_dropdown = \"Screens\",\n    save_screens = \"Save Screens\", saved_screens = \"Saved screens\", selected_screens = \"Selected screens\",\n    no_screens = \"No screens found\", no_valid_screens = \"No valid screens selected\",\n    settings = \"Settings\", wind_speed = \"Wind Speed Above\", screen_up_timer = \"Screen up timer\",\n    screen_down_timer = \"Screen down timer\", wind_below_timer = \"Wind speed below timer\", disable_timer = \"Disable Lux automation timer\", seconds = \"seconds\",\n    language_panel = \"Language\",\n    language_dropdown = \"Language\", save_language = \"Save Language\", qa_language = \"QA language\",\n    hub_default_language = \"Hub default\", selected_language = \"Selected\", manual_title = \"Manual\",\n    manual_step_1 = \"Step 1\", manual_step_2 = \"Step 2\", manual_step_3 = \"Step 3\",\n    manual_select_lux = \"Select a lux and wind sensor in the dropdown\",\n    manual_save_lux = \"Press Save Sensors to store the choice\",\n    manual_startup_scan = \"Startup scans HC3 for all lux sensors\",\n    manual_adjust_lux = \"Change selects a setting, minus / plus adjusts the selected value\",\n    manual_how_it_works = \"How it works\",\n    manual_lux_logic = \"Lux Screen Up below runs when lux is below the up threshold and has been that for the screen up timer; Screen Down runs when lux is above the down threshold and has been that for the screen down timer\",\n    manual_wind_logic = \"Wind protection uses the saved wind sensor, forces screens up above the wind threshold, and resumes lux control after the wind below timer\",\n    manual_screen_label = \"Screens and will force the up position on the screen.\",\n    manual_screen_logic = \"Only saved screens are controlled\",\n    manual_auto_save = \"Changed settings are saved automatically after the countdown\",\n    automation_disabled = \"Lux automation disabled\", automation_enabled = \"Lux automation enabled\",\n    lux_automation_on = \"Lux automation ON\", lux_automation_off = \"Lux automation OFF\",\n    event_log = \"Events\", no_events = \"Waiting for screen events\",\n    current_value = \"Current value\", value_range = \"Value range\", tap_step = \"Single click\",\n    hold_step = \"Hold 0-2 sec / over 2 sec\", save_state = \"Save state\", saved = \"Saved\",\n    lux_values = \"Lux values\", lux_up = \"Lux Screen Up below\", lux_down = \"Lux Screen Down Above\", selected_value = \"Selected value\",\n    above = \"Above\", below = \"Below\",\n    lux_threshold = \"Lux threshold\", change_button = \"Change\", diagnostics = \"Diagnostics\",\n    last_error = \"Last error\", none = \"None\",\n  },\n  no = {\n    qa_title = \"Screens Controller\", qa_version = \"QA versjon\", revision_date = \"Revisjon\",\n    lux_sensor_count = \"Lux sensorer\", lux_sensor_panel = \"Lux sensor\", lux_sensor_dropdown = \"Lux sensor\",\n    save_lux_sensor = \"Lagre lux sensor\", available_sensors = \"Tilgjengelige\", saved_sensor = \"Lagret sensor\",\n    current_lux_value = \"Lux verdi\", last_value_update = \"Siste oppdatering\", waiting_for_event = \"Venter pa verdi\",\n    selected_sensor = \"Valgt\", last_scan = \"Siste scan\", status = \"Status\", pending_save = \"Venter pa lagring\",\n    not_selected = \"Ikke valgt\", unselect = \"Fjern valg\", missing_sensor = \"Sensor mangler\", no_lux_sensors = \"Fant ingen lux sensorer\",\n    no_valid_lux_sensor = \"Ingen gyldig lux sensor er valgt\", wind_sensor_count = \"Wind sensorer\",\n    wind_sensor_panel = \"Wind sensor\", wind_sensor_dropdown = \"Wind sensor\",\n    save_wind_sensor = \"Lagre wind sensor\", saved_wind_sensor = \"Lagret wind sensor\",\n    no_wind_sensors = \"Fant ingen wind sensorer\", no_valid_wind_sensor = \"Ingen gyldig wind sensor er valgt\",\n    screen_count = \"Screens\", screen_panel = \"Screens\", screen_dropdown = \"Screens\",\n    save_screens = \"Lagre screens\", saved_screens = \"Lagrede screens\", selected_screens = \"Valgte screens\",\n    no_screens = \"Fant ingen screens\", no_valid_screens = \"Ingen gyldige screens er valgt\",\n    settings = \"Innstillinger\", wind_speed = \"Vindhastighet over\", screen_up_timer = \"Skjerm opp timer\",\n    screen_down_timer = \"Skjerm ned timer\", wind_below_timer = \"Vindhastighet under timer\", disable_timer = \"Deaktiver lux timer\", seconds = \"sekunder\",\n    language_panel = \"Sprak\",\n    language_dropdown = \"Sprak\", save_language = \"Lagre sprak\", qa_language = \"QA sprak\",\n    hub_default_language = \"Hub standardsprak\", selected_language = \"Valgt\", manual_title = \"Manual\",\n    manual_step_1 = \"Steg 1\", manual_step_2 = \"Steg 2\", manual_step_3 = \"Steg 3\",\n    manual_select_lux = \"Select a lux and wind sensor in the dropdown\",\n    manual_save_lux = \"Press Save Sensors to store the choice\",\n    manual_startup_scan = \"Oppstart scanner HC3 etter alle lux sensorer\",\n    manual_adjust_lux = \"Change velger innstilling, minus / pluss justerer valgt verdi\",\n    manual_how_it_works = \"How it works\",\n    manual_lux_logic = \"Lux Screen Up below runs when lux is below the up threshold and has been that for the screen up timer; Screen Down runs when lux is above the down threshold and has been that for the screen down timer\",\n    manual_wind_logic = \"Wind protection uses the saved wind sensor, forces screens up above the wind threshold, and resumes lux control after the wind below timer\",\n    manual_screen_label = \"Screens and will force the up position on the screen.\",\n    manual_screen_logic = \"Only saved screens are controlled\",\n    manual_auto_save = \"Changed settings are saved automatically after the countdown\",\n    automation_disabled = \"Lux automatikk er deaktivert\", automation_enabled = \"Lux automatikk er aktiv\",\n    lux_automation_on = \"Lux automatikk PÅ\", lux_automation_off = \"Lux automatikk AV\",\n    event_log = \"Events\", no_events = \"Waiting for screen events\",\n    current_value = \"Naverdi\", value_range = \"Verdiomrade\", tap_step = \"Enkelt trykk\",\n    hold_step = \"Hold 0-2 sek / over 2 sek\", save_state = \"Lagringsstatus\", saved = \"Lagret\",\n    lux_values = \"Lux verdier\", lux_up = \"Screen Opp, under:\", lux_down = \"Screen Ned, over:\", selected_value = \"Valgt verdi\",\n    above = \"Over\", below = \"Under\",\n    lux_threshold = \"Lux grense\", change_button = \"Change\", diagnostics = \"Diagnostikk\",\n    last_error = \"Siste feil\", none = \"Ingen\",\n  },\n}\n\n-- Return one translated string with inline fallback when helper files are unavailable.\n-------------------------------------------------------------------------------------------\nlocal function translate_text(language_code, key, fallback)\n  local provider = nil\n  if type(_G) == \"table\" then provider = _G.ScreensControllerLanguage end\n  if type(provider) == \"table\" and type(provider.get) == \"function\" then\n    return provider.get(language_code, key, fallback)\n  end\n\n  local selected = INLINE_TRANSLATIONS[tostring(language_code or \"en\"):lower()] or INLINE_TRANSLATIONS.en or {}\n  local english = INLINE_TRANSLATIONS.en or {}\n  local wanted_key = tostring(key or \"\")\n  return selected[wanted_key] or english[wanted_key] or fallback or wanted_key\nend\n\n-- Return the translated text for the currently active QA language.\n-------------------------------------------------------------------------------------------\nlocal function tt(self, key, fallback)\n  local selected = normalize_language_code(self.runtime.pendingLanguageCode)\n    or normalize_language_code(self.store[CONFIG.storageKeys.languageCode])\n    or normalize_language_code(self.runtime.hubLanguageCode)\n    or \"en\"\n  return translate_text(selected, key, fallback)\nend\n\n-- Normalize the active lux value selector to one supported runtime key.\n-------------------------------------------------------------------------------------------\nlocal function normalize_lux_value_key(value)\n  local text = tostring(value or \"\"):lower()\n  if text == \"luxdown\" or text == \"lux_down\" or text == \"down\" then return \"luxDown\" end\n  if text == \"windspeed\" or text == \"wind_speed\" or text == \"wind\" then return \"windSpeed\" end\n  if text == \"windbelowtimerseconds\" or text == \"wind_below_timer_seconds\" or text == \"wind_below_timer\" or text == \"windbelowtimer\" then return \"windBelowTimerSeconds\" end\n  if text == \"disabletimerseconds\" or text == \"disable_timer_seconds\" or text == \"disable_timer\" or text == \"disabletimer\" then return \"disableTimerSeconds\" end\n  if text == \"screenuptimerseconds\" or text == \"screen_up_timer_seconds\" or text == \"screen_up_timer\" or text == \"uptimer\" then return \"screenUpTimerSeconds\" end\n  if text == \"screendowntimerseconds\" or text == \"screen_down_timer_seconds\" or text == \"screen_down_timer\" or text == \"downtimer\" then return \"screenDownTimerSeconds\" end\n  if text == \"timerseconds\" or text == \"timer_seconds\" or text == \"timer\" then return \"screenDownTimerSeconds\" end\n  return \"luxUp\"\nend\n\n-- Return the currently saved lux sensor id.\n-------------------------------------------------------------------------------------------\nlocal function get_saved_lux_sensor_id(self)\n  return normalize_device_id(self.store[CONFIG.storageKeys.luxSensorId])\nend\n\n-- Return the lux sensor id selected in the dropdown or the saved fallback.\n-------------------------------------------------------------------------------------------\nlocal function get_selected_lux_sensor_id(self)\n  if self.runtime.pendingLuxSensorId == UNSELECT_OPTION_VALUE then return nil end\n  return normalize_device_id(self.runtime.pendingLuxSensorId) or get_saved_lux_sensor_id(self)\nend\n\n-- Return the currently saved wind sensor id.\n-------------------------------------------------------------------------------------------\nlocal function get_saved_wind_sensor_id(self)\n  return normalize_device_id(self.store[CONFIG.storageKeys.windSensorId])\nend\n\n-- Return the wind sensor id selected in the dropdown or the saved fallback.\n-------------------------------------------------------------------------------------------\nlocal function get_selected_wind_sensor_id(self)\n  if self.runtime.pendingWindSensorId == UNSELECT_OPTION_VALUE then return nil end\n  return normalize_device_id(self.runtime.pendingWindSensorId) or get_saved_wind_sensor_id(self)\nend\n\n-- Return the currently saved screen device ids.\n-------------------------------------------------------------------------------------------\nlocal function get_saved_screen_device_ids(self)\n  return normalize_device_id_list(self.store[CONFIG.storageKeys.screenDeviceIds])\nend\n\n-- Return the screen ids selected in the dropdown or the saved fallback.\n-------------------------------------------------------------------------------------------\nlocal function get_selected_screen_device_ids(self)\n  local pending = normalize_device_id_list(self.runtime.pendingScreenDeviceIds)\n  if #pending > 0 then return pending end\n  return get_saved_screen_device_ids(self)\nend\n\n-- Return the currently saved QA language code.\n-------------------------------------------------------------------------------------------\nlocal function get_saved_language_code(self)\n  return normalize_language_code(self.store[CONFIG.storageKeys.languageCode])\n    or normalize_language_code(self.runtime.hubLanguageCode)\n    or \"en\"\nend\n\n-- Return the language code shown in the dropdown.\n-------------------------------------------------------------------------------------------\nlocal function get_dropdown_language_code(self)\n  return normalize_language_code(self.runtime.pendingLanguageCode)\n    or get_saved_language_code(self)\nend\n\n-- ===========================================================\n-- ---------------Storage and runtime----------------\n-- ===========================================================\n\n-- Set up a write-through cache over HC3 internal storage.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:setupStorage()\n  self.cache = {}\n  local qa = self\n\n  for _, key in pairs(CONFIG.storageKeys or {}) do\n    local value = qa:internalStorageGet(key)\n    if value ~= nil then qa.cache[key] = value end\n  end\n\n  local storage = {}\n\n  function storage:__index(key)\n    local cached = qa.cache[key]\n    if cached ~= nil then return cached end\n\n    local value = qa:internalStorageGet(key)\n    if value ~= nil then qa.cache[key] = value end\n    return value\n  end\n\n  function storage:__newindex(key, value)\n    if value == nil then\n      qa.cache[key] = nil\n      qa:internalStorageRemove(key)\n      return\n    end\n\n    qa.cache[key] = value\n    qa:internalStorageSet(key, value)\n  end\n\n  return setmetatable({}, storage)\nend\n\n-- Create the runtime table used for non-persistent QA state.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:buildRuntimeState()\n  return {\n    debugEnabled = tostring(self:getVariable(\"Debug\") or \"false\"):lower() == \"true\",\n    pendingLuxSensorId = nil,\n    pendingWindSensorId = nil,\n    pendingScreenDeviceIds = nil,\n    pendingLanguageCode = nil,\n    savedLuxSensorValue = nil,\n    savedLuxSensorUnit = \"lux\",\n    savedLuxSensorUpdatedAt = 0,\n    savedLuxEventState = nil,\n    luxEventListenerRegistered = false,\n    savedWindSensorValue = nil,\n    savedWindSensorUnit = \"m/s\",\n    savedWindSensorUpdatedAt = 0,\n    savedWindEventState = nil,\n    windProtectionActive = false,\n    windBelowTimer = nil,\n    windEventListenerRegistered = false,\n    automationDisabledUntil = 0,\n    automationDisableTimer = nil,\n    luxUp = clamp_number(self.store[LUX_UP_STORAGE_KEY], LUX_THRESHOLD_MIN, LUX_THRESHOLD_MAX),\n    luxDown = clamp_number(self.store[LUX_DOWN_STORAGE_KEY], LUX_THRESHOLD_MIN, LUX_THRESHOLD_MAX),\n    windSpeed = clamp_number(self.store[WIND_SPEED_STORAGE_KEY], WIND_SPEED_MIN, WIND_SPEED_MAX),\n    windBelowTimerSeconds = clamp_number(self.store[WIND_BELOW_TIMER_SECONDS_STORAGE_KEY], TIMER_SECONDS_MIN, TIMER_SECONDS_MAX),\n    disableTimerSeconds = clamp_number(self.store[DISABLE_TIMER_SECONDS_STORAGE_KEY], TIMER_SECONDS_MIN, DISABLE_TIMER_SECONDS_MAX),\n    screenUpTimerSeconds = clamp_number(self.store[SCREEN_UP_TIMER_SECONDS_STORAGE_KEY], TIMER_SECONDS_MIN, TIMER_SECONDS_MAX),\n    screenDownTimerSeconds = clamp_number(self.store[SCREEN_DOWN_TIMER_SECONDS_STORAGE_KEY], TIMER_SECONDS_MIN, TIMER_SECONDS_MAX),\n    activeLuxValueKey = \"luxUp\",\n    luxValuesDirty = false,\n    luxValuesPersistTimer = nil,\n    luxValuesPersistDeadline = 0,\n    luxValuesCountdownTimer = nil,\n    screenActionTimer = nil,\n    screenActionTimerAction = nil,\n    screenActionTimerReason = nil,\n    screenCanGoDown = false,\n    luxSensors = {},\n    windSensors = {},\n    screenDevices = {},\n    hubLanguageCode = \"en\",\n    lastLuxScanAt = 0,\n    lastWindScanAt = 0,\n    lastScreenScanAt = 0,\n    lastError = \"\",\n    changeHoldTimer = nil,\n    valNHoldTimer = nil,\n    valPHoldTimer = nil,\n    changeHoldTimerRepeatCount = 0,\n    valNHoldTimerRepeatCount = 0,\n    valPHoldTimerRepeatCount = 0,\n    changeHoldChanged = false,\n    valNHoldChanged = false,\n    valPHoldChanged = false,\n    changeJustReleased = false,\n    valNJustReleased = false,\n    valPJustReleased = false,\n    memKb = read_memory_kb(),\n    cpuUsagePct = 0,\n    cpuTime = os.time(),\n    cpuClock = os.clock(),\n    cpuSampleReady = false,\n    metricsTimer = nil,\n  }\nend\n\n-- Initialise persisted defaults on the first QA run.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:setupDefaultStore()\n  local legacy_threshold = clamp_number(self.store[LEGACY_LUX_THRESHOLD_STORAGE_KEY], LUX_THRESHOLD_MIN, LUX_THRESHOLD_MAX)\n\n  if self.store[CONFIG.storageKeys.languageCode] == nil then\n    self.store[CONFIG.storageKeys.languageCode] = self.runtime.hubLanguageCode or \"en\"\n  end\n  if self.store[LEGACY_LUX_THRESHOLD_STORAGE_KEY] == nil then self.store[LEGACY_LUX_THRESHOLD_STORAGE_KEY] = legacy_threshold end\n  if self.store[LUX_UP_STORAGE_KEY] == nil then self.store[LUX_UP_STORAGE_KEY] = legacy_threshold end\n  if self.store[LUX_DOWN_STORAGE_KEY] == nil then self.store[LUX_DOWN_STORAGE_KEY] = legacy_threshold end\n  if self.store[WIND_SPEED_STORAGE_KEY] == nil then self.store[WIND_SPEED_STORAGE_KEY] = WIND_SPEED_DEFAULT end\n  if self.store[WIND_BELOW_TIMER_SECONDS_STORAGE_KEY] == nil then\n    self.store[WIND_BELOW_TIMER_SECONDS_STORAGE_KEY] = WIND_BELOW_TIMER_SECONDS_DEFAULT\n  end\n  if self.store[DISABLE_TIMER_SECONDS_STORAGE_KEY] == nil then\n    self.store[DISABLE_TIMER_SECONDS_STORAGE_KEY] = DISABLE_TIMER_SECONDS_DEFAULT\n  end\n  local legacy_timer = clamp_number(self.store[LEGACY_TIMER_SECONDS_STORAGE_KEY], TIMER_SECONDS_MIN, TIMER_SECONDS_MAX)\n  if self.store[SCREEN_UP_TIMER_SECONDS_STORAGE_KEY] == nil then\n    self.store[SCREEN_UP_TIMER_SECONDS_STORAGE_KEY] = legacy_timer > 0 and legacy_timer or SCREEN_UP_TIMER_SECONDS_DEFAULT\n  end\n  if self.store[SCREEN_DOWN_TIMER_SECONDS_STORAGE_KEY] == nil then\n    self.store[SCREEN_DOWN_TIMER_SECONDS_STORAGE_KEY] = legacy_timer > 0 and legacy_timer or SCREEN_DOWN_TIMER_SECONDS_DEFAULT\n  end\n  if self.store[CONFIG.storageKeys.statusLog] == nil then self.store[CONFIG.storageKeys.statusLog] = {} end\n  if self.store[CONFIG.storageKeys.eventLog] == nil then self.store[CONFIG.storageKeys.eventLog] = {} end\n  self.store[CONFIG.storageKeys.memMaxKb] = self.runtime.memKb\n  self.store[CONFIG.storageKeys.cpuMaxPct] = 0\n  self.runtime.luxUp = clamp_number(self.store[LUX_UP_STORAGE_KEY], LUX_THRESHOLD_MIN, LUX_THRESHOLD_MAX)\n  self.runtime.luxDown = clamp_number(self.store[LUX_DOWN_STORAGE_KEY], LUX_THRESHOLD_MIN, LUX_THRESHOLD_MAX)\n  self.runtime.windSpeed = clamp_number(self.store[WIND_SPEED_STORAGE_KEY], WIND_SPEED_MIN, WIND_SPEED_MAX)\n  self.runtime.windBelowTimerSeconds = clamp_number(self.store[WIND_BELOW_TIMER_SECONDS_STORAGE_KEY], TIMER_SECONDS_MIN, TIMER_SECONDS_MAX)\n  self.runtime.disableTimerSeconds = clamp_number(self.store[DISABLE_TIMER_SECONDS_STORAGE_KEY], TIMER_SECONDS_MIN, DISABLE_TIMER_SECONDS_MAX)\n  self.runtime.screenUpTimerSeconds = clamp_number(self.store[SCREEN_UP_TIMER_SECONDS_STORAGE_KEY], TIMER_SECONDS_MIN, TIMER_SECONDS_MAX)\n  self.runtime.screenDownTimerSeconds = clamp_number(self.store[SCREEN_DOWN_TIMER_SECONDS_STORAGE_KEY], TIMER_SECONDS_MIN, TIMER_SECONDS_MAX)\n  self.runtime.automationDisabledUntil = 0\n  self.runtime.automationDisableTimer = nil\n  self.runtime.activeLuxValueKey = normalize_lux_value_key(self.runtime.activeLuxValueKey)\nend\n\n-- Update a UI element without crashing if the HC3 rejects the change.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:safeUpdateView(widget_id, property_name, value)\n  local ok, err = pcall(self.updateView, self, widget_id, property_name, value)\n  if not ok then\n    self:warning(\"updateView failed [\" .. tostring(widget_id) .. \".\" ..\n      tostring(property_name) .. \"]: \" .. tostring(err))\n  end\n  return ok\nend\n\n-- Write debug output only when the Debug QA variable is enabled.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:debugLog(message)\n  if self.runtime.debugEnabled then self:debug(tostring(message or \"\")) end\nend\n\n-- Return the stored diagnostics log as a table.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:getStatusLog()\n  if type(self.store[CONFIG.storageKeys.statusLog]) ~= \"table\" then\n    self.store[CONFIG.storageKeys.statusLog] = {}\n  end\n  return self.store[CONFIG.storageKeys.statusLog]\nend\n\n-- Add one entry to the diagnostics log and keep only the newest items.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:addStatusLog(level, message)\n  local log = self:getStatusLog()\n  log[#log + 1] = {\n    at = os.time(),\n    level = tostring(level or \"info\"),\n    message = tostring(message or \"\"),\n  }\n\n  while #log > (tonumber(CONFIG.statusLogMax) or 20) do\n    table.remove(log, 1)\n  end\n\n  self.store[CONFIG.storageKeys.statusLog] = log\nend\n\n-- Return the stored screen/lux/wind event log as a table.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:getEventLog()\n  if type(self.store[CONFIG.storageKeys.eventLog]) ~= \"table\" then\n    self.store[CONFIG.storageKeys.eventLog] = {}\n  end\n  return self.store[CONFIG.storageKeys.eventLog]\nend\n\n-- Add one entry to the user-facing event log above the screen selection panel.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:addEventLog(level, message)\n  local log = self:getEventLog()\n  log[#log + 1] = {\n    at = os.time(),\n    level = tostring(level or \"info\"),\n    message = tostring(message or \"\"),\n  }\n\n  while #log > (tonumber(CONFIG.eventLogMax) or 12) do\n    table.remove(log, 1)\n  end\n\n  self.store[CONFIG.storageKeys.eventLog] = log\nend\n\n-- Return true while manual lux automation disable is active.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:isLuxAutomationDisabled()\n  return (tonumber(self.runtime.automationDisabledUntil) or 0) > os.time()\nend\n\n-- Re-enable lux automation and clear any pending disable timer.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:enableAutomation(reason)\n  if self.runtime.automationDisableTimer ~= nil then\n    clearTimeout(self.runtime.automationDisableTimer)\n    self.runtime.automationDisableTimer = nil\n  end\n  self.runtime.automationDisabledUntil = 0\n  self:addEventLog(\"info\", tostring(reason or tt(self, \"automation_enabled\", \"Lux automation enabled\")))\n  self:refreshValueControls()\n  self:refreshInfoLabel()\n  self:refreshEventLogLabel()\nend\n\n-- Finish the disable period and re-check the current lux state.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:finishLuxAutomationDisable()\n  self.runtime.automationDisableTimer = nil\n  self:enableAutomation(tt(self, \"automation_enabled\", \"Lux automation enabled\"))\n  self.runtime.savedLuxEventState = nil\n  self:logLuxEventState(self.runtime.savedLuxSensorValue)\nend\n\n-- Keep the disable switch fresh and re-enable lux automation when the deadline passes.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:startLuxAutomationDisableCountdown()\n  if self.runtime.automationDisableTimer ~= nil then clearTimeout(self.runtime.automationDisableTimer) end\n\n  local function tick()\n    local ok, err = pcall(function()\n      if not self:isLuxAutomationDisabled() then\n        self:finishLuxAutomationDisable()\n        return\n      end\n\n      self:refreshValueControls()\n      self.runtime.automationDisableTimer = setTimeout(tick, 1000)\n    end)\n    if not ok then self:storeError(\"lux automation disable countdown failed: \" .. tostring(err)) end\n  end\n\n  self.runtime.automationDisableTimer = setTimeout(tick, 1000)\nend\n\n-- Disable lux automation for the configured disable timer.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:disableAutomation(reason)\n  local delay = self:getLuxValue(\"disableTimerSeconds\")\n  self:cancelScreenActionTimer(\"automation disabled\")\n  self.runtime.automationDisabledUntil = os.time() + delay\n  self:addEventLog(\"warn\", tostring(reason or tt(self, \"automation_disabled\", \"Lux automation disabled\")) ..\n    \" for \" .. format_timer_seconds(delay))\n\n  if delay <= 0 then\n    self:finishLuxAutomationDisable()\n    return\n  end\n\n  self:startLuxAutomationDisableCountdown()\n\n  self:refreshValueControls()\n  self:refreshInfoLabel()\n  self:refreshEventLogLabel()\nend\n\n-- Remember the latest error and mirror it to the diagnostics log.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:storeError(message)\n  local text = tostring(message or \"\")\n  self.runtime.lastError = text\n  self:addStatusLog(\"error\", text)\n  self:error(text)\nend\n\n-- ===========================================================\n-- ---------------Lux sensor helpers----------------\n-- ===========================================================\n\n-- Read the current hub default language once during startup.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:readHubDefaultLanguage()\n  local ok, result = pcall(function()\n    return api.get(\"/settings/info\")\n  end)\n  if not ok or type(result) ~= \"table\" then return \"en\" end\n  return normalize_language_code(result.defaultLanguage) or \"en\"\nend\n\n-- Return a sorted list of available lux sensors.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:readLuxSensorDevices()\n  local device_map = {}\n\n  local ok, typed_devices = pcall(function()\n    return api.get(\"/devices?type=\" .. tostring(CONFIG.lux.typeQuery or \"com.fibaro.lightSensor\"))\n  end)\n\n  if ok and type(typed_devices) == \"table\" then\n    for _, device in ipairs(typed_devices) do\n      local sensor_id = normalize_device_id(device and device.id)\n      if sensor_id ~= nil then device_map[sensor_id] = device end\n    end\n  end\n\n  local ok_all, all_devices = pcall(function()\n    return api.get(\"/devices\")\n  end)\n  if not ok_all or type(all_devices) ~= \"table\" then\n    return nil, \"Failed to load devices from HC3\"\n  end\n\n  local lux_devices = {}\n  for _, device in ipairs(all_devices) do\n    if is_lux_sensor_device(device) then\n      local sensor_id = normalize_device_id(device and device.id)\n      if sensor_id ~= nil then device_map[sensor_id] = device end\n    end\n  end\n\n  for _, device in pairs(device_map) do\n    lux_devices[#lux_devices + 1] = device\n  end\n\n  table.sort(lux_devices, function(left, right)\n    local left_name = tostring(left.name or \"\"):lower()\n    local right_name = tostring(right.name or \"\"):lower()\n    if left_name == right_name then return (tonumber(left.id) or 0) < (tonumber(right.id) or 0) end\n    return left_name < right_name\n  end)\n\n  return lux_devices, nil\nend\n\n-- Refresh the cached list of lux sensors from HC3.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:reloadLuxSensors()\n  local devices, err = self:readLuxSensorDevices()\n  self.runtime.lastLuxScanAt = os.time()\n  if devices == nil then\n    self.runtime.luxSensors = {}\n    self:storeError(\"Lux sensor scan failed: \" .. tostring(err))\n    return false\n  end\n\n  self.runtime.luxSensors = devices\n  self.runtime.lastError = \"\"\n  self:addStatusLog(\"info\", \"Lux sensor scan found \" .. tostring(#devices) .. \" sensor(s)\")\n  if #devices == 0 then\n    self:addStatusLog(\"warn\", \"No lux sensors found on startup scan\")\n  end\n  return true\nend\n\n-- Return true when the selected id exists in the cached lux sensor list.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:hasLuxSensorId(sensor_id)\n  local wanted = normalize_device_id(sensor_id)\n  if wanted == nil then return false end\n\n  for _, device in ipairs(self.runtime.luxSensors or {}) do\n    if normalize_device_id(device.id) == wanted then return true end\n  end\n  return false\nend\n\n-- Return the display string for a lux sensor id.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:getLuxSensorDisplay(sensor_id)\n  local wanted = normalize_device_id(sensor_id)\n  if wanted == nil then return tt(self, \"not_selected\", \"Not selected\") end\n\n  for _, device in ipairs(self.runtime.luxSensors or {}) do\n    if normalize_device_id(device.id) == wanted then\n      return string.format(\"ID: %s  Name: %s\", wanted, tostring(device.name or \"Unnamed sensor\"))\n    end\n  end\n\n  return string.format(\"%s (ID: %s)\", tt(self, \"missing_sensor\", \"Missing sensor\"), wanted)\nend\n\n-- Return the cached lux sensor table for one sensor id.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:getLuxSensorDevice(sensor_id)\n  local wanted = normalize_device_id(sensor_id)\n  if wanted == nil then return nil end\n\n  for _, device in ipairs(self.runtime.luxSensors or {}) do\n    if normalize_device_id(device.id) == wanted then return device end\n  end\n\n  return nil\nend\n\n-- Return the preferred lux unit for one sensor id.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:getLuxSensorUnit(sensor_id)\n  local device = self:getLuxSensorDevice(sensor_id)\n  local properties = type(device) == \"table\" and device.properties or nil\n  local unit = type(properties) == \"table\" and tostring(properties.unit or \"\") or \"\"\n  if unit == \"\" then unit = \"lux\" end\n  return unit\nend\n\n-- Format one lux value for the UI.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:formatLuxSensorValue(value, unit)\n  local number = tonumber(value)\n  if number == nil then return tt(self, \"waiting_for_event\", \"Waiting for value\") end\n\n  local rounded = round_number(number, math.abs(number - math.floor(number)) > 0 and 1 or 0)\n  local text = tostring(rounded)\n  if math.abs(rounded - math.floor(rounded)) < 0.001 then text = tostring(math.floor(rounded)) end\n\n  local suffix = tostring(unit or \"\")\n  if suffix ~= \"\" then return text .. \" \" .. suffix end\n  return text\nend\n\n-- Return the current lux threshold state for event logging.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:getLuxEventState(value)\n  local number = tonumber(value)\n  if number == nil then return nil, nil end\n\n  if number < self:getLuxValue(\"luxUp\") then\n    return \"below_up\", \"Lux \" .. self:formatLuxSensorValue(number, LUX_UNIT) ..\n      \" is below Screen Up threshold \" .. self:formatSettingValue(\"luxUp\")\n  end\n  if number > self:getLuxValue(\"luxDown\") then\n    return \"above_down\", \"Lux \" .. self:formatLuxSensorValue(number, LUX_UNIT) ..\n      \" is above Screen Down threshold \" .. self:formatSettingValue(\"luxDown\")\n  end\n\n  return \"between\", \"Lux \" .. self:formatLuxSensorValue(number, LUX_UNIT) .. \" is between screen thresholds\"\nend\n\n-- Log saved lux sensor state changes in the Events panel.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:logLuxEventState(value)\n  local state, message = self:getLuxEventState(value)\n  if state == nil then return end\n  if state == self.runtime.savedLuxEventState then return end\n  if self:isLuxAutomationDisabled() then\n    self.runtime.savedLuxEventState = state\n    self:addEventLog(\"info\", message .. \" but lux automation is disabled\")\n    self:refreshEventLogLabel()\n    return\n  end\n  if self.runtime.windProtectionActive then\n    self:addEventLog(\"info\", message .. \" but wind protection is active\")\n    self:refreshEventLogLabel()\n    self.runtime.savedLuxEventState = state\n    return\n  end\n\n  if state == \"below_up\" then\n    self:scheduleScreenAction(\"up\", self:getLuxValue(\"screenUpTimerSeconds\"), message)\n  elseif state == \"above_down\" then\n    if self.runtime.screenCanGoDown then\n      self:scheduleScreenAction(\"down\", self:getLuxValue(\"screenDownTimerSeconds\"), message)\n    else\n      self:cancelScreenActionTimer(\"screen down blocked until QA has completed screen up\")\n      self:addEventLog(\"info\", message .. \" but screen down is blocked until QA has completed screen up\")\n    end\n  else\n    self:cancelScreenActionTimer(\"lux is between thresholds\")\n  end\n\n  self.runtime.savedLuxEventState = state\n  self:addEventLog(\"info\", message)\n  self:refreshEventLogLabel()\nend\n\n-- Clear the cached live lux value for the saved sensor.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:clearSavedLuxSensorValue()\n  self.runtime.savedLuxSensorValue = nil\n  self.runtime.savedLuxSensorUnit = \"lux\"\n  self.runtime.savedLuxSensorUpdatedAt = 0\n  self.runtime.savedLuxEventState = nil\nend\n\n-- Refresh the saved lux sensor value from the device state on HC3.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:refreshSavedLuxSensorValue()\n  local saved_sensor_id = get_saved_lux_sensor_id(self)\n  if saved_sensor_id == nil or not self:hasLuxSensorId(saved_sensor_id) then\n    self:clearSavedLuxSensorValue()\n    return false\n  end\n\n  local ok, device = pcall(function()\n    return api.get(\"/devices/\" .. saved_sensor_id)\n  end)\n  if not ok or type(device) ~= \"table\" then\n    self:clearSavedLuxSensorValue()\n    self.runtime.savedLuxSensorUnit = self:getLuxSensorUnit(saved_sensor_id)\n    self:debugLog(\"Unable to refresh lux sensor value for device \" .. tostring(saved_sensor_id))\n    return false\n  end\n\n  local properties = type(device.properties) == \"table\" and device.properties or {}\n  self.runtime.savedLuxSensorValue = properties.value\n  self.runtime.savedLuxSensorUnit = tostring(properties.unit or self:getLuxSensorUnit(saved_sensor_id) or \"lux\")\n  self.runtime.savedLuxSensorUpdatedAt = os.time()\n  self:logLuxEventState(properties.value)\n  return true\nend\n\n-- Apply one incoming lux sensor value event when it belongs to the saved sensor.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:handleSavedLuxSensorValueEvent(event)\n  local event_sensor_id = normalize_device_id(event and event.id)\n  local saved_sensor_id = get_saved_lux_sensor_id(self)\n  if event_sensor_id == nil or saved_sensor_id == nil or event_sensor_id ~= saved_sensor_id then return end\n\n  self.runtime.savedLuxSensorValue = event and event.value or nil\n  self.runtime.savedLuxSensorUnit = self:getLuxSensorUnit(saved_sensor_id)\n  self.runtime.savedLuxSensorUpdatedAt = os.time()\n  self:logLuxEventState(event and event.value)\n  self:refreshLuxControls()\nend\n\n-- Register one EventLib listener for all discovered lux sensor value updates.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:registerLuxSensorValueListener()\n  if self.runtime.luxEventListenerRegistered then return true end\n  if type(Event_std) ~= \"table\" then\n    self:addStatusLog(\"warn\", \"EventLib unavailable for lux sensor listener\")\n    return false\n  end\n\n  local sensor_ids = {}\n  for _, device in ipairs(self.runtime.luxSensors or {}) do\n    local sensor_id = tonumber(normalize_device_id(device.id))\n    if sensor_id ~= nil then sensor_ids[#sensor_ids + 1] = sensor_id end\n  end\n\n  if #sensor_ids == 0 then return false end\n\n  local qa = self\n  local Event = Event_std\n  local ok, err = pcall(function()\n    Event:attachRefreshstate()\n    Event.id = \"screens_lux_value_\" .. tostring(qa.id)\n    Event.tag = \"Lux sensor event\"\n    Event.tagColor = \"blue\"\n    Event{type = \"device\", id = sensor_ids, property = \"value\"}\n    function Event:handler(event)\n      local handled, handler_err = pcall(function()\n        qa:handleSavedLuxSensorValueEvent(event)\n      end)\n      if not handled then qa:storeError(\"Lux sensor listener failed: \" .. tostring(handler_err)) end\n    end\n  end)\n\n  if not ok then\n    self:addStatusLog(\"warn\", \"EventLib lux listener failed: \" .. tostring(err))\n    return false\n  end\n\n  self.runtime.luxEventListenerRegistered = true\n  self:addStatusLog(\"info\", \"EventLib lux listener registered for \" .. tostring(#sensor_ids) .. \" sensor(s)\")\n  return true\nend\n\n-- Build the single-select options used by the lux dropdown.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:buildLuxOptions()\n  local options = {\n    { text = tt(self, \"unselect\", \"Unselect\"), type = \"option\", value = UNSELECT_OPTION_VALUE },\n  }\n  for _, device in ipairs(self.runtime.luxSensors or {}) do\n    local sensor_id = normalize_device_id(device.id)\n    if sensor_id ~= nil then\n      options[#options + 1] = {\n        text = string.format(\"ID: %s  Name: %s\", sensor_id, tostring(device.name or \"Unnamed sensor\")),\n        type = \"option\",\n        value = sensor_id,\n      }\n    end\n  end\n\n  if #(self.runtime.luxSensors or {}) == 0 then\n    options[#options + 1] = {\n      text = tt(self, \"no_lux_sensors\", \"No lux sensors found\"),\n      type = \"option\",\n      value = \"__no_lux_sensors__\",\n    }\n  end\n\n  return options\nend\n\n-- Return a sorted list of available wind sensors.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:readWindSensorDevices()\n  local device_map = {}\n\n  local ok, typed_devices = pcall(function()\n    return api.get(\"/devices?type=\" .. tostring((CONFIG.wind or {}).typeQuery or \"com.fibaro.windSensor\"))\n  end)\n\n  if ok and type(typed_devices) == \"table\" then\n    for _, device in ipairs(typed_devices) do\n      local sensor_id = normalize_device_id(device and device.id)\n      if sensor_id ~= nil then device_map[sensor_id] = device end\n    end\n  end\n\n  local ok_all, all_devices = pcall(function()\n    return api.get(\"/devices\")\n  end)\n  if not ok_all or type(all_devices) ~= \"table\" then\n    return nil, \"Failed to load devices from HC3\"\n  end\n\n  for _, device in ipairs(all_devices) do\n    if is_wind_sensor_device(device) then\n      local sensor_id = normalize_device_id(device and device.id)\n      if sensor_id ~= nil then device_map[sensor_id] = device end\n    end\n  end\n\n  local wind_devices = {}\n  for _, device in pairs(device_map) do\n    wind_devices[#wind_devices + 1] = device\n  end\n\n  table.sort(wind_devices, function(left, right)\n    local left_name = tostring(left.name or \"\"):lower()\n    local right_name = tostring(right.name or \"\"):lower()\n    if left_name == right_name then return (tonumber(left.id) or 0) < (tonumber(right.id) or 0) end\n    return left_name < right_name\n  end)\n\n  return wind_devices, nil\nend\n\n-- Refresh the cached list of wind sensors from HC3.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:reloadWindSensors()\n  local devices, err = self:readWindSensorDevices()\n  self.runtime.lastWindScanAt = os.time()\n  if devices == nil then\n    self.runtime.windSensors = {}\n    self:storeError(\"Wind sensor scan failed: \" .. tostring(err))\n    return false\n  end\n\n  self.runtime.windSensors = devices\n  self.runtime.lastError = \"\"\n  self:addStatusLog(\"info\", \"Wind sensor scan found \" .. tostring(#devices) .. \" sensor(s)\")\n  if #devices == 0 then\n    self:addStatusLog(\"warn\", \"No wind sensors found on startup scan\")\n  end\n  return true\nend\n\n-- Return true when the selected id exists in the cached wind sensor list.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:hasWindSensorId(sensor_id)\n  local wanted = normalize_device_id(sensor_id)\n  if wanted == nil then return false end\n\n  for _, device in ipairs(self.runtime.windSensors or {}) do\n    if normalize_device_id(device.id) == wanted then return true end\n  end\n  return false\nend\n\n-- Return the display string for a wind sensor id.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:getWindSensorDisplay(sensor_id)\n  local wanted = normalize_device_id(sensor_id)\n  if wanted == nil then return tt(self, \"not_selected\", \"Not selected\") end\n\n  for _, device in ipairs(self.runtime.windSensors or {}) do\n    if normalize_device_id(device.id) == wanted then\n      return string.format(\"ID: %s  Name: %s\", wanted, tostring(device.name or \"Unnamed sensor\"))\n    end\n  end\n\n  return string.format(\"%s (ID: %s)\", tt(self, \"missing_sensor\", \"Missing sensor\"), wanted)\nend\n\n-- Return the cached wind sensor table for one sensor id.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:getWindSensorDevice(sensor_id)\n  local wanted = normalize_device_id(sensor_id)\n  if wanted == nil then return nil end\n\n  for _, device in ipairs(self.runtime.windSensors or {}) do\n    if normalize_device_id(device.id) == wanted then return device end\n  end\n\n  return nil\nend\n\n-- Return the preferred wind speed unit for one sensor id.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:getWindSensorUnit(sensor_id)\n  local device = self:getWindSensorDevice(sensor_id)\n  local properties = type(device) == \"table\" and device.properties or nil\n  local unit = type(properties) == \"table\" and tostring(properties.unit or \"\") or \"\"\n  if unit == \"\" then unit = \"m/s\" end\n  return unit\nend\n\n-- Return the current wind threshold state for event logging.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:getWindEventState(value)\n  local number = tonumber(value)\n  if number == nil then return nil, nil end\n\n  local formatted_value = self:formatLuxSensorValue(number, self.runtime.savedWindSensorUnit)\n  if number > self:getLuxValue(\"windSpeed\") then\n    return \"above\", \"Wind \" .. formatted_value .. \" is above threshold \" .. self:formatSettingValue(\"windSpeed\")\n  end\n\n  return \"normal\", \"Wind \" .. formatted_value .. \" is below threshold \" .. self:formatSettingValue(\"windSpeed\")\nend\n\n-- Log saved wind sensor state changes in the Events panel.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:logWindEventState(value)\n  local state, message = self:getWindEventState(value)\n  if state == nil then return end\n  if state == self.runtime.savedWindEventState then return end\n  if state == \"above\" then\n    self.runtime.windProtectionActive = true\n    if self.runtime.windBelowTimer ~= nil then\n      clearTimeout(self.runtime.windBelowTimer)\n      self.runtime.windBelowTimer = nil\n      self:addEventLog(\"info\", \"Cancelled wind below timer because wind is above threshold again\")\n    end\n    self:runScreenAction(\"up\", message)\n  elseif self.runtime.windProtectionActive then\n    self:startWindBelowTimer(message)\n  end\n\n  self.runtime.savedWindEventState = state\n  self:addEventLog(\"info\", message)\n  self:refreshEventLogLabel()\nend\n\n-- Start the wind-below delay before lux automation is allowed again.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:startWindBelowTimer(reason)\n  local delay = self:getLuxValue(\"windBelowTimerSeconds\")\n  if self.runtime.windBelowTimer ~= nil then return end\n  if delay <= 0 then\n    self.runtime.windProtectionActive = false\n    self:addEventLog(\"info\", \"Wind below threshold; lux control resumed\")\n    self.runtime.savedLuxEventState = nil\n    self:logLuxEventState(self.runtime.savedLuxSensorValue)\n    self:refreshEventLogLabel()\n    return\n  end\n\n  self.runtime.windBelowTimer = setTimeout(function()\n    self.runtime.windBelowTimer = nil\n    self.runtime.windProtectionActive = false\n    self:addEventLog(\"info\", \"Wind stayed below threshold for \" .. format_timer_seconds(delay) .. \"; lux control resumed\")\n    self.runtime.savedLuxEventState = nil\n    self:logLuxEventState(self.runtime.savedLuxSensorValue)\n    self:refreshEventLogLabel()\n  end, delay * 1000)\n\n  self:addEventLog(\"info\", \"Wind below timer started for \" .. format_timer_seconds(delay) .. \": \" .. tostring(reason or \"wind below threshold\"))\n  self:refreshEventLogLabel()\nend\n\n-- Clear the cached live wind value for the saved sensor.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:clearSavedWindSensorValue()\n  self.runtime.savedWindSensorValue = nil\n  self.runtime.savedWindSensorUnit = \"m/s\"\n  self.runtime.savedWindSensorUpdatedAt = 0\n  self.runtime.savedWindEventState = nil\n  self.runtime.windProtectionActive = false\n  if self.runtime.windBelowTimer ~= nil then\n    clearTimeout(self.runtime.windBelowTimer)\n    self.runtime.windBelowTimer = nil\n  end\nend\n\n-- Refresh the saved wind sensor value from the device state on HC3.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:refreshSavedWindSensorValue()\n  local saved_sensor_id = get_saved_wind_sensor_id(self)\n  if saved_sensor_id == nil or not self:hasWindSensorId(saved_sensor_id) then\n    self:clearSavedWindSensorValue()\n    return false\n  end\n\n  local ok, device = pcall(function()\n    return api.get(\"/devices/\" .. saved_sensor_id)\n  end)\n  if not ok or type(device) ~= \"table\" then\n    self:clearSavedWindSensorValue()\n    self.runtime.savedWindSensorUnit = self:getWindSensorUnit(saved_sensor_id)\n    self:debugLog(\"Unable to refresh wind sensor value for device \" .. tostring(saved_sensor_id))\n    return false\n  end\n\n  local properties = type(device.properties) == \"table\" and device.properties or {}\n  self.runtime.savedWindSensorValue = properties.value\n  self.runtime.savedWindSensorUnit = tostring(properties.unit or self:getWindSensorUnit(saved_sensor_id) or \"m/s\")\n  self.runtime.savedWindSensorUpdatedAt = os.time()\n  self:logWindEventState(properties.value)\n  return true\nend\n\n-- Apply one incoming wind sensor value event when it belongs to the saved sensor.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:handleSavedWindSensorValueEvent(event)\n  local event_sensor_id = normalize_device_id(event and event.id)\n  local saved_sensor_id = get_saved_wind_sensor_id(self)\n  if event_sensor_id == nil or saved_sensor_id == nil or event_sensor_id ~= saved_sensor_id then return end\n\n  self.runtime.savedWindSensorValue = event and event.value or nil\n  self.runtime.savedWindSensorUnit = self:getWindSensorUnit(saved_sensor_id)\n  self.runtime.savedWindSensorUpdatedAt = os.time()\n  self:logWindEventState(event and event.value)\n  self:refreshWindControls()\n  self:refreshInfoLabel()\nend\n\n-- Register one EventLib listener for all discovered wind sensor value updates.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:registerWindSensorValueListener()\n  if self.runtime.windEventListenerRegistered then return true end\n  if type(Event_std) ~= \"table\" then\n    self:addStatusLog(\"warn\", \"EventLib unavailable for wind sensor listener\")\n    return false\n  end\n\n  local sensor_ids = {}\n  for _, device in ipairs(self.runtime.windSensors or {}) do\n    local sensor_id = tonumber(normalize_device_id(device.id))\n    if sensor_id ~= nil then sensor_ids[#sensor_ids + 1] = sensor_id end\n  end\n\n  if #sensor_ids == 0 then return false end\n\n  local qa = self\n  local Event = Event_std\n  local ok, err = pcall(function()\n    Event:attachRefreshstate()\n    Event.id = \"screens_wind_value_\" .. tostring(qa.id)\n    Event.tag = \"Wind sensor event\"\n    Event.tagColor = \"blue\"\n    Event{type = \"device\", id = sensor_ids, property = \"value\"}\n    function Event:handler(event)\n      local handled, handler_err = pcall(function()\n        qa:handleSavedWindSensorValueEvent(event)\n      end)\n      if not handled then qa:storeError(\"Wind sensor listener failed: \" .. tostring(handler_err)) end\n    end\n  end)\n\n  if not ok then\n    self:addStatusLog(\"warn\", \"EventLib wind listener failed: \" .. tostring(err))\n    return false\n  end\n\n  self.runtime.windEventListenerRegistered = true\n  self:addStatusLog(\"info\", \"EventLib wind listener registered for \" .. tostring(#sensor_ids) .. \" sensor(s)\")\n  return true\nend\n\n-- Build the single-select options used by the wind dropdown.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:buildWindOptions()\n  local options = {\n    { text = tt(self, \"unselect\", \"Unselect\"), type = \"option\", value = UNSELECT_OPTION_VALUE },\n  }\n  for _, device in ipairs(self.runtime.windSensors or {}) do\n    local sensor_id = normalize_device_id(device.id)\n    if sensor_id ~= nil then\n      options[#options + 1] = {\n        text = string.format(\"ID: %s  Name: %s\", sensor_id, tostring(device.name or \"Unnamed sensor\")),\n        type = \"option\",\n        value = sensor_id,\n      }\n    end\n  end\n\n  if #(self.runtime.windSensors or {}) == 0 then\n    options[#options + 1] = {\n      text = tt(self, \"no_wind_sensors\", \"No wind sensors found\"),\n      type = \"option\",\n      value = \"__no_wind_sensors__\",\n    }\n  end\n\n  return options\nend\n\n-- Return a sorted list of available screen/shutter devices.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:readScreenDevices()\n  local device_map = {}\n\n  for _, device_type in ipairs((CONFIG.screens or {}).typeQueries or {}) do\n    local ok, typed_devices = pcall(function()\n      return api.get(\"/devices?type=\" .. tostring(device_type))\n    end)\n    if ok and type(typed_devices) == \"table\" then\n      for _, device in ipairs(typed_devices) do\n        local device_id = normalize_device_id(device and device.id)\n        if device_id ~= nil then device_map[device_id] = device end\n      end\n    end\n  end\n\n  local ok_all, all_devices = pcall(function()\n    return api.get(\"/devices\")\n  end)\n  if not ok_all or type(all_devices) ~= \"table\" then\n    return nil, \"Failed to load devices from HC3\"\n  end\n\n  for _, device in ipairs(all_devices) do\n    if is_screen_device(device) then\n      local device_id = normalize_device_id(device and device.id)\n      if device_id ~= nil then device_map[device_id] = device end\n    end\n  end\n\n  local screen_devices = {}\n  for _, device in pairs(device_map) do\n    screen_devices[#screen_devices + 1] = device\n  end\n\n  table.sort(screen_devices, function(left, right)\n    local left_name = tostring(left.name or \"\"):lower()\n    local right_name = tostring(right.name or \"\"):lower()\n    if left_name == right_name then return (tonumber(left.id) or 0) < (tonumber(right.id) or 0) end\n    return left_name < right_name\n  end)\n\n  return screen_devices, nil\nend\n\n-- Refresh the cached list of screen/shutter devices from HC3.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:reloadScreenDevices()\n  local devices, err = self:readScreenDevices()\n  self.runtime.lastScreenScanAt = os.time()\n  if devices == nil then\n    self.runtime.screenDevices = {}\n    self:storeError(\"Screen scan failed: \" .. tostring(err))\n    return false\n  end\n\n  self.runtime.screenDevices = devices\n  self.runtime.lastError = \"\"\n  self:addStatusLog(\"info\", \"Screen scan found \" .. tostring(#devices) .. \" device(s)\")\n  if #devices == 0 then self:addStatusLog(\"warn\", \"No screens found on startup scan\") end\n  return true\nend\n\n-- Return true when the selected id exists in the cached screen list.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:hasScreenDeviceId(device_id)\n  local wanted = normalize_device_id(device_id)\n  if wanted == nil then return false end\n\n  for _, device in ipairs(self.runtime.screenDevices or {}) do\n    if normalize_device_id(device.id) == wanted then return true end\n  end\n  return false\nend\n\n-- Return only screen ids that are still present in the cached screen list.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:filterValidScreenDeviceIds(device_ids)\n  local valid = {}\n  for _, device_id in ipairs(normalize_device_id_list(device_ids)) do\n    if self:hasScreenDeviceId(device_id) then valid[#valid + 1] = device_id end\n  end\n  return valid\nend\n\n-- Return a compact display string for one or more screen device ids.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:getScreenDevicesDisplay(device_ids)\n  local ids = normalize_device_id_list(device_ids)\n  if #ids == 0 then return tt(self, \"not_selected\", \"Not selected\") end\n\n  local names = {}\n  for _, wanted in ipairs(ids) do\n    local label = nil\n    for _, device in ipairs(self.runtime.screenDevices or {}) do\n      if normalize_device_id(device.id) == wanted then\n        label = string.format(\"%s:%s\", wanted, tostring(device.name or \"Unnamed screen\"))\n        break\n      end\n    end\n    names[#names + 1] = label or string.format(\"%s:%s\", wanted, tt(self, \"missing_sensor\", \"Missing sensor\"))\n  end\n\n  return table.concat(names, \"\\n\")\nend\n\n-- Cancel any pending delayed screen movement.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:cancelScreenActionTimer(reason)\n  if self.runtime.screenActionTimer ~= nil then\n    clearTimeout(self.runtime.screenActionTimer)\n    self.runtime.screenActionTimer = nil\n    self:addEventLog(\"info\", \"Cancelled screen \" .. tostring(self.runtime.screenActionTimerAction or \"action\") ..\n      \" timer: \" .. tostring(reason or \"condition changed\"))\n    self:refreshEventLogLabel()\n  end\n  self.runtime.screenActionTimerAction = nil\n  self.runtime.screenActionTimerReason = nil\nend\n\n-- Send one open/close command to all saved screen devices.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:runScreenAction(action, reason)\n  self:cancelScreenActionTimer(\"running action now\")\n\n  local ids = self:filterValidScreenDeviceIds(get_saved_screen_device_ids(self))\n  if #ids == 0 then\n    self:addEventLog(\"warn\", \"No saved screens to run \" .. tostring(action))\n    self:refreshEventLogLabel()\n    return false\n  end\n\n  local command = action == \"down\" and \"close\" or \"open\"\n  local sent_count = 0\n  for _, device_id in ipairs(ids) do\n    local ok, err = pcall(function()\n      hub.call(tonumber(device_id), command)\n    end)\n    if not ok then\n      self:addEventLog(\"error\", \"Screen \" .. tostring(device_id) .. \" \" .. command .. \" failed: \" .. tostring(err))\n    else\n      sent_count = sent_count + 1\n    end\n  end\n\n  if sent_count > 0 then\n    if action == \"up\" then self.runtime.screenCanGoDown = true end\n    if action == \"down\" then self.runtime.screenCanGoDown = false end\n  end\n\n  self:addEventLog(\"info\", \"Screen \" .. tostring(action) .. \" sent to \" .. tostring(#ids) ..\n    \" screen(s): \" .. tostring(reason or \"threshold reached\"))\n  self:refreshEventLogLabel()\n  return true\nend\n\n-- Start or replace a delayed screen action timer.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:scheduleScreenAction(action, delay_seconds, reason)\n  local delay = math.max(0, math.floor(tonumber(delay_seconds) or 0))\n  if delay <= 0 then return self:runScreenAction(action, reason) end\n\n  if self.runtime.screenActionTimer ~= nil and self.runtime.screenActionTimerAction == action then return true end\n  self:cancelScreenActionTimer(\"new \" .. tostring(action) .. \" condition\")\n  self.runtime.screenActionTimerAction = action\n  self.runtime.screenActionTimerReason = reason\n  self.runtime.screenActionTimer = setTimeout(function()\n    self.runtime.screenActionTimer = nil\n    local saved_reason = self.runtime.screenActionTimerReason\n    self.runtime.screenActionTimerAction = nil\n    self.runtime.screenActionTimerReason = nil\n    self:runScreenAction(action, saved_reason)\n  end, delay * 1000)\n\n  self:addEventLog(\"info\", \"Screen \" .. tostring(action) .. \" timer started for \" .. format_timer_seconds(delay) ..\n    \": \" .. tostring(reason or \"threshold reached\"))\n  self:refreshEventLogLabel()\n  return true\nend\n\n-- Build the multi-select options used by the screens dropdown.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:buildScreenOptions()\n  local options = {}\n  for _, device in ipairs(self.runtime.screenDevices or {}) do\n    local device_id = normalize_device_id(device.id)\n    if device_id ~= nil then\n      options[#options + 1] = {\n        text = string.format(\"ID: %s  Name: %s\", device_id, tostring(device.name or \"Unnamed screen\")),\n        type = \"option\",\n        value = device_id,\n      }\n    end\n  end\n\n  if #options == 0 then\n    options[1] = {\n      text = tt(self, \"no_screens\", \"No screens found\"),\n      type = \"option\",\n      value = \"\",\n    }\n  end\n\n  return options\nend\n\n-- Normalize HC3 multiselect values, accepting both option values and option indexes.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:normalizeScreenSelectValues(values)\n  local selected_ids = {}\n  local seen = {}\n  local options = self:buildScreenOptions()\n  local source = values\n  if type(source) == \"table\" and type(source[1]) == \"table\" then source = source[1] end\n\n  local function add_id(value)\n    local id = normalize_device_id(value)\n    if id ~= nil and self:hasScreenDeviceId(id) and not seen[id] then\n      seen[id] = true\n      selected_ids[#selected_ids + 1] = id\n      return true\n    end\n    return false\n  end\n\n  for _, value in ipairs(type(source) == \"table\" and source or {}) do\n    if not add_id(value) then\n      local index = tonumber(value)\n      local option = index ~= nil and options[math.floor(index)] or nil\n      if type(option) == \"table\" then add_id(option.value) end\n    end\n  end\n\n  table.sort(selected_ids, function(left, right) return (tonumber(left) or 0) < (tonumber(right) or 0) end)\n  return selected_ids\nend\n\n-- Return the selected setting key currently edited by the UI controls.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:getActiveLuxValueKey()\n  self.runtime.activeLuxValueKey = normalize_lux_value_key(self.runtime.activeLuxValueKey)\n  return self.runtime.activeLuxValueKey\nend\n\n-- Return the translated label for one editable setting value.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:getLuxValueLabel(value_key)\n  local normalized = normalize_lux_value_key(value_key)\n  if normalized == \"luxDown\" then return tt(self, \"lux_down\", \"Lux Screen Down Above\") end\n  if normalized == \"windSpeed\" then return tt(self, \"wind_speed\", \"Wind Speed Above\") end\n  if normalized == \"windBelowTimerSeconds\" then return tt(self, \"wind_below_timer\", \"Wind speed below timer\") end\n  if normalized == \"disableTimerSeconds\" then return tt(self, \"disable_timer\", \"Disable Lux automation timer\") end\n  if normalized == \"screenUpTimerSeconds\" then return tt(self, \"screen_up_timer\", \"Screen up timer\") end\n  if normalized == \"screenDownTimerSeconds\" then return tt(self, \"screen_down_timer\", \"Screen down timer\") end\n  return tt(self, \"lux_up\", \"Lux Screen Up below\")\nend\n\n-- Return one editable setting definition.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:getSettingConfig(value_key)\n  local normalized = normalize_lux_value_key(value_key)\n  if normalized == \"windSpeed\" then\n    return WIND_SPEED_MIN, WIND_SPEED_MAX, WIND_SPEED_TAP_STEP, WIND_SPEED_HOLD_STEP, nil\n  end\n  if normalized == \"disableTimerSeconds\" then\n    return TIMER_SECONDS_MIN, DISABLE_TIMER_SECONDS_MAX, TIMER_SECONDS_TAP_STEP, TIMER_SECONDS_HOLD_STEP, TIMER_SECONDS_HOLD_FAST_STEP\n  end\n  if normalized == \"screenUpTimerSeconds\" or normalized == \"screenDownTimerSeconds\" or normalized == \"windBelowTimerSeconds\" or normalized == \"disableTimerSeconds\" then\n    return TIMER_SECONDS_MIN, TIMER_SECONDS_MAX, TIMER_SECONDS_TAP_STEP, TIMER_SECONDS_HOLD_STEP, TIMER_SECONDS_HOLD_FAST_STEP\n  end\n  return LUX_THRESHOLD_MIN, LUX_THRESHOLD_MAX, LUX_THRESHOLD_TAP_STEP, LUX_THRESHOLD_HOLD_STEP, nil\nend\n\n-- Return one editable setting value from runtime state.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:getLuxValue(value_key)\n  local normalized = normalize_lux_value_key(value_key)\n  local min_value, max_value = self:getSettingConfig(normalized)\n  return clamp_number(self.runtime[normalized], min_value, max_value)\nend\n\n-- Return one formatted editable setting value for the UI.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:formatSettingValue(value_key)\n  local normalized = normalize_lux_value_key(value_key)\n  local value = self:getLuxValue(normalized)\n  if normalized == \"luxUp\" or normalized == \"luxDown\" then return tostring(value) .. \" \" .. LUX_UNIT end\n  if normalized == \"windSpeed\" then\n    return tostring(value) .. \" \" .. self:getWindSensorUnit(get_selected_wind_sensor_id(self))\n  end\n  if normalized == \"screenUpTimerSeconds\" or normalized == \"screenDownTimerSeconds\" or normalized == \"windBelowTimerSeconds\" or normalized == \"disableTimerSeconds\" then return format_timer_seconds(value) end\n  return tostring(value)\nend\n\n-- Return the save state text with a countdown while debounced settings are pending.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:formatSaveState()\n  if not self.runtime.luxValuesDirty then return tt(self, \"saved\", \"Saved\") end\n\n  local deadline = tonumber(self.runtime.luxValuesPersistDeadline) or 0\n  local remaining = math.max(0, math.ceil(deadline - os.time()))\n  return tt(self, \"pending_save\", \"Pending save\") .. \" \" .. tostring(remaining) .. \" \" .. tt(self, \"seconds\", \"seconds\")\nend\n\n-- Return the editable lux value currently selected in the UI.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:getActiveLuxValue()\n  return self:getLuxValue(self:getActiveLuxValueKey())\nend\n\n-- Switch the editable target between lux up and lux down.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:cycleActiveLuxValue()\n  local current_key = self:getActiveLuxValueKey()\n  local order = { \"luxUp\", \"luxDown\", \"windSpeed\", \"windBelowTimerSeconds\", \"screenUpTimerSeconds\", \"screenDownTimerSeconds\", \"disableTimerSeconds\" }\n  local next_key = order[1]\n  for index, key in ipairs(order) do\n    if key == current_key then\n      next_key = order[index + 1] or order[1]\n      break\n    end\n  end\n  self.runtime.activeLuxValueKey = next_key\n  self:refreshValueControls()\n  self:refreshInfoLabel()\nend\n\n-- Update one switch value safely so hold feedback resets cleanly.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:setSwitchValue(widget_id, is_active)\n  self:safeUpdateView(widget_id, \"value\", is_active and \"true\" or \"false\")\nend\n\n-- Pulse a switch for quick tap feedback.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:pulseSwitch(widget_id)\n  self:setSwitchValue(widget_id, true)\n  setTimeout(function()\n    if self and self.setSwitchValue then self:setSwitchValue(widget_id, false) end\n  end, CONTROL_FEEDBACK_MS)\nend\n\n-- Persist the runtime setting values after a short idle delay.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:scheduleLuxValuesPersist()\n  if self.runtime.luxValuesPersistTimer ~= nil then\n    clearTimeout(self.runtime.luxValuesPersistTimer)\n    self.runtime.luxValuesPersistTimer = nil\n  end\n  if self.runtime.luxValuesCountdownTimer ~= nil then\n    clearTimeout(self.runtime.luxValuesCountdownTimer)\n    self.runtime.luxValuesCountdownTimer = nil\n  end\n\n  self.runtime.luxValuesDirty = true\n  self.runtime.luxValuesPersistDeadline = os.time() + math.ceil(LUX_THRESHOLD_PERSIST_DELAY_MS / 1000)\n  self:startLuxValuesCountdown()\n  self.runtime.luxValuesPersistTimer = setTimeout(function()\n    local ok, err = pcall(function()\n      self.runtime.luxValuesPersistTimer = nil\n      self.runtime.luxValuesDirty = false\n      self.runtime.luxValuesPersistDeadline = 0\n      if self.runtime.luxValuesCountdownTimer ~= nil then\n        clearTimeout(self.runtime.luxValuesCountdownTimer)\n        self.runtime.luxValuesCountdownTimer = nil\n      end\n      self.store[LUX_UP_STORAGE_KEY] = self:getLuxValue(\"luxUp\")\n      self.store[LUX_DOWN_STORAGE_KEY] = self:getLuxValue(\"luxDown\")\n      self.store[WIND_SPEED_STORAGE_KEY] = self:getLuxValue(\"windSpeed\")\n      self.store[WIND_BELOW_TIMER_SECONDS_STORAGE_KEY] = self:getLuxValue(\"windBelowTimerSeconds\")\n      self.store[DISABLE_TIMER_SECONDS_STORAGE_KEY] = self:getLuxValue(\"disableTimerSeconds\")\n      self.store[SCREEN_UP_TIMER_SECONDS_STORAGE_KEY] = self:getLuxValue(\"screenUpTimerSeconds\")\n      self.store[SCREEN_DOWN_TIMER_SECONDS_STORAGE_KEY] = self:getLuxValue(\"screenDownTimerSeconds\")\n      self:addStatusLog(\"info\", \"Saved settings\")\n      self:addEventLog(\"info\", \"Saved threshold and timer settings\")\n      self.runtime.savedLuxEventState = nil\n      self.runtime.savedWindEventState = nil\n      self:logLuxEventState(self.runtime.savedLuxSensorValue)\n      self:logWindEventState(self.runtime.savedWindSensorValue)\n      self:refreshEventLogLabel()\n      self:refreshInfoLabel()\n      self:refreshManualLabel()\n      self:refreshUserDescription()\n    end)\n    if not ok then\n      self.runtime.luxValuesPersistTimer = nil\n      self:storeError(\"scheduleLuxValuesPersist failed: \" .. tostring(err))\n    end\n  end, LUX_THRESHOLD_PERSIST_DELAY_MS)\nend\n\n-- Refresh the settings card once per second while pending values wait for save.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:startLuxValuesCountdown()\n  local function tick()\n    if not self.runtime.luxValuesDirty then\n      self.runtime.luxValuesCountdownTimer = nil\n      return\n    end\n\n    self:refreshInfoLabel()\n    self.runtime.luxValuesCountdownTimer = setTimeout(tick, 1000)\n  end\n\n  self:refreshInfoLabel()\n  self.runtime.luxValuesCountdownTimer = setTimeout(tick, 1000)\nend\n\n-- Apply one delta to the active setting value and refresh the UI immediately.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:applyActiveLuxValueDelta(delta)\n  local value_key = self:getActiveLuxValueKey()\n  local current_value = self:getLuxValue(value_key)\n  local min_value, max_value = self:getSettingConfig(value_key)\n  local next_value = clamp_number(current_value + (tonumber(delta) or 0), min_value, max_value)\n  if next_value == current_value then return false end\n\n  self.runtime[value_key] = next_value\n  self.runtime.lastError = \"\"\n  self:scheduleLuxValuesPersist()\n  self:refreshValueControls()\n  self:refreshInfoLabel()\n  return true\nend\n\n-- Start one repeating hold timer that runs every 300 ms and ramps after 2 seconds.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:startThresholdHold(timer_key, changed_key, widget_id, delta_sign)\n  if self.runtime[timer_key] ~= nil then return end\n\n  local repeat_count_key = tostring(timer_key) .. \"RepeatCount\"\n  local sign = tonumber(delta_sign) or 0\n  self.runtime[changed_key] = false\n  self.runtime[repeat_count_key] = 0\n  self:setSwitchValue(widget_id, true)\n\n  local function repeat_step()\n    if self.runtime[timer_key] == nil then return end\n\n    local repeat_count = math.max(0, math.floor(tonumber(self.runtime[repeat_count_key]) or 0)) + 1\n    self.runtime[repeat_count_key] = repeat_count\n    local _, _, tap_step, hold_step, fast_step = self:getSettingConfig(self:getActiveLuxValueKey())\n    local step = get_hold_step(repeat_count, tap_step, hold_step, fast_step)\n    local changed = self:applyActiveLuxValueDelta(sign * step)\n    if changed then self.runtime[changed_key] = true end\n    self.runtime[timer_key] = setTimeout(repeat_step, LUX_THRESHOLD_HOLD_REPEAT_MS)\n  end\n\n  self.runtime[timer_key] = setTimeout(repeat_step, LUX_THRESHOLD_HOLD_REPEAT_MS)\nend\n\n-- Stop one hold timer, reset its switch state, and suppress the phantom release event.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:stopThresholdHold(timer_key, changed_key, just_released_key, widget_id)\n  local repeat_count_key = tostring(timer_key) .. \"RepeatCount\"\n\n  if self.runtime[timer_key] ~= nil then\n    clearTimeout(self.runtime[timer_key])\n    self.runtime[timer_key] = nil\n  end\n\n  self.runtime[repeat_count_key] = 0\n  self.runtime[just_released_key] = true\n  self:setSwitchValue(widget_id, false)\n  self.runtime[changed_key] = false\nend\n\n-- ===========================================================\n-- ---------------UI refresh----------------\n-- ===========================================================\n\n-- Keep the requested QA widgets visible.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:showUiWidgets()\n  local widget_ids = {\n    \"info\",\n    \"val_n\",\n    \"change\",\n    \"val_p\",\n    \"automation_disable\",\n    \"space\",\n    \"info_lux\",\n    \"lux_save\",\n    \"lux_select\",\n    \"info_wind\",\n    \"wind_save\",\n    \"wind_select\",\n    \"info_events\",\n    \"info_screens\",\n    \"screens_save\",\n    \"screens_select\",\n    \"info_language\",\n    \"language_save\",\n    \"language_select\",\n    \"info_manual\",\n    \"error_status\",\n    \"space2\",\n  }\n\n  for _, widget_id in ipairs(widget_ids) do\n    self:safeUpdateView(widget_id, \"visible\", true)\n  end\nend\n\n-- Apply standard QuickApp metadata used by this controller.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:applyStandardProperties()\n  self:updateProperty(\"log\", \"QA Started\")\n  self:updateProperty(\"deviceRole\", \"Other\")\n  self:updateProperty(\"categories\", { \"other\" })\n  self:updateProperty(\"quickAppUuid\", tostring(CONFIG.quickAppUuid or \"JBS974\"))\nend\n\n-- Keep the user description aligned with the saved lux sensor.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:refreshUserDescription()\n  local saved_sensor = self:getLuxSensorDisplay(get_saved_lux_sensor_id(self))\n  local lines = {\n    \"Screens/Base Shutters Controller\",\n    \"Version: \" .. tostring(version),\n    \"Lux sensor: \" .. saved_sensor,\n    \"Wind sensor: \" .. self:getWindSensorDisplay(get_saved_wind_sensor_id(self)),\n    \"Screens: \" .. self:getScreenDevicesDisplay(get_saved_screen_device_ids(self)),\n    \"Lux Screen Up: \" .. self:formatSettingValue(\"luxUp\"),\n    \"Lux Screen Down: \" .. self:formatSettingValue(\"luxDown\"),\n    \"Wind speed: \" .. self:formatSettingValue(\"windSpeed\"),\n    \"Wind below timer: \" .. self:formatSettingValue(\"windBelowTimerSeconds\"),\n    \"Disable timer: \" .. self:formatSettingValue(\"disableTimerSeconds\"),\n    \"Screen up timer: \" .. self:formatSettingValue(\"screenUpTimerSeconds\"),\n    \"Screen down timer: \" .. self:formatSettingValue(\"screenDownTimerSeconds\"),\n    \"Startup scan enabled\",\n  }\n  self:updateProperty(\"userDescription\", table.concat(lines, \"\\n\"))\nend\n\n-- Refresh the top label with the editable lux up / lux down summary.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:refreshInfoLabel()\n  local active_value_key = self:getActiveLuxValueKey()\n  local min_value, max_value, tap_step, hold_step, fast_step = self:getSettingConfig(active_value_key)\n  local hold_step_text = tostring(tap_step) .. \" / \" .. tostring(hold_step)\n  if fast_step ~= nil then hold_step_text = hold_step_text .. \" / \" .. tostring(fast_step) end\n  local rows = {\n    { label = tt(self, \"lux_up\", \"Lux Screen Up below\"), value = self:formatSettingValue(\"luxUp\"), valueColor = active_value_key == \"luxUp\" and CONFIG.colors.ok or CONFIG.colors.info },\n    { label = tt(self, \"lux_down\", \"Lux Screen Down Above\"), value = self:formatSettingValue(\"luxDown\"), valueColor = active_value_key == \"luxDown\" and CONFIG.colors.ok or CONFIG.colors.info },\n    { label = tt(self, \"wind_speed\", \"Wind Speed Above\"), value = self:formatSettingValue(\"windSpeed\"), valueColor = active_value_key == \"windSpeed\" and CONFIG.colors.ok or CONFIG.colors.info },\n    { label = tt(self, \"wind_below_timer\", \"Wind speed below timer\"), value = self:formatSettingValue(\"windBelowTimerSeconds\"), valueColor = active_value_key == \"windBelowTimerSeconds\" and CONFIG.colors.ok or CONFIG.colors.info },\n    { label = tt(self, \"screen_up_timer\", \"Screen up timer\"), value = self:formatSettingValue(\"screenUpTimerSeconds\"), valueColor = active_value_key == \"screenUpTimerSeconds\" and CONFIG.colors.ok or CONFIG.colors.info },\n    { label = tt(self, \"screen_down_timer\", \"Screen down timer\"), value = self:formatSettingValue(\"screenDownTimerSeconds\"), valueColor = active_value_key == \"screenDownTimerSeconds\" and CONFIG.colors.ok or CONFIG.colors.info },\n    { label = tt(self, \"disable_timer\", \"Disable Lux automation timer\"), value = self:formatSettingValue(\"disableTimerSeconds\"), valueColor = active_value_key == \"disableTimerSeconds\" and CONFIG.colors.ok or CONFIG.colors.info },\n    { label = tt(self, \"selected_value\", \"Selected value\"), value = self:getLuxValueLabel(active_value_key), valueColor = CONFIG.colors.title },\n    { label = tt(self, \"value_range\", \"Value range\"), value = tostring(min_value) .. \" - \" .. tostring(max_value), valueColor = CONFIG.colors.info },\n    { label = tt(self, \"tap_step\", \"Single click\"), value = tostring(tap_step), valueColor = CONFIG.colors.info },\n    {\n      label = tt(self, \"hold_step\", \"Hold 0-2 sec / over 2 sec\"),\n      value = hold_step_text .. \" @ \" .. tostring(LUX_THRESHOLD_HOLD_REPEAT_MS) .. \" ms\",\n      valueColor = CONFIG.colors.info,\n    },\n    {\n      label = tt(self, \"save_state\", \"Save state\"),\n      value = self:formatSaveState(),\n      valueColor = self.runtime.luxValuesDirty and CONFIG.colors.title or CONFIG.colors.ok,\n    },\n  }\n\n  self:safeUpdateView(\"info\", \"text\", build_info_table(tt(self, \"settings\", \"Settings\"), rows))\nend\n\n-- Refresh the change / val_n / val_p control texts for the lux threshold.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:refreshValueControls()\n  local active_value_key = self:getActiveLuxValueKey()\n  self:safeUpdateView(\"val_n\", \"text\", \"➖\")\n  self:safeUpdateView(\"val_p\", \"text\", \"➕\")\n  self:safeUpdateView(\"change\", \"text\", \"🔁 \" .. self:getLuxValueLabel(active_value_key))\n  self:safeUpdateView(\"automation_disable\", \"text\", self:isLuxAutomationDisabled() and\n    \"⏸ \" .. tt(self, \"lux_automation_off\", \"Lux automation OFF\") or\n    \"▶ \" .. tt(self, \"lux_automation_on\", \"Lux automation ON\"))\n  self:setSwitchValue(\"val_n\", self.runtime.valNHoldTimer ~= nil)\n  self:setSwitchValue(\"val_p\", self.runtime.valPHoldTimer ~= nil)\n  self:setSwitchValue(\"change\", false)\n  self:setSwitchValue(\"automation_disable\", not self:isLuxAutomationDisabled())\nend\n\n-- Refresh the lux selection panel and dropdown.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:refreshLuxControls()\n  local selected_sensor_id = get_selected_lux_sensor_id(self)\n  local selected_sensor_value = self:hasLuxSensorId(selected_sensor_id) and selected_sensor_id or UNSELECT_OPTION_VALUE\n  local saved_sensor_id = get_saved_lux_sensor_id(self)\n  local lux_value_text = self:formatLuxSensorValue(self.runtime.savedLuxSensorValue, self.runtime.savedLuxSensorUnit)\n  local lux_value_color = self.runtime.savedLuxSensorValue ~= nil and CONFIG.colors.ok or CONFIG.colors.info\n  local lux_updated_at = tonumber(self.runtime.savedLuxSensorUpdatedAt) or 0\n  local rows = {\n    { label = tt(self, \"available_sensors\", \"Available\"), value = tostring(#(self.runtime.luxSensors or {})), valueColor = CONFIG.colors.ok },\n    { label = tt(self, \"saved_sensor\", \"Saved sensor\"), value = self:getLuxSensorDisplay(saved_sensor_id), valueColor = CONFIG.colors.ok },\n    { label = tt(self, \"selected_sensor\", \"Selected\"), value = self:getLuxSensorDisplay(selected_sensor_id), valueColor = CONFIG.colors.info },\n    { label = tt(self, \"current_lux_value\", \"Current lux\"), value = saved_sensor_id ~= nil and lux_value_text or tt(self, \"not_selected\", \"Not selected\"), valueColor = lux_value_color },\n    { label = tt(self, \"last_value_update\", \"Last update\"), value = lux_updated_at > 0 and format_datetime(lux_updated_at) or tt(self, \"waiting_for_event\", \"Waiting for value\"), valueColor = CONFIG.colors.info },\n    { label = tt(self, \"last_scan\", \"Last scan\"), value = format_datetime(self.runtime.lastLuxScanAt), valueColor = CONFIG.colors.info },\n  }\n\n  if selected_sensor_id ~= nil and selected_sensor_id ~= saved_sensor_id then\n    rows[#rows + 1] = {\n      label = tt(self, \"status\", \"Status\"),\n      value = tt(self, \"pending_save\", \"Pending save\"),\n      valueColor = CONFIG.colors.title,\n    }\n  end\n\n  self:safeUpdateView(\"lux_select\", \"options\", self:buildLuxOptions())\n  self:safeUpdateView(\"lux_select\", \"selectedItem\", selected_sensor_value)\n  self:safeUpdateView(\"lux_select\", \"text\", tt(self, \"lux_sensor_dropdown\", \"Lux Sensor\"))\n  self:safeUpdateView(\"lux_save\", \"text\", tt(self, \"save_lux_sensor\", \"Save Lux Sensor\"))\n  self:safeUpdateView(\"info_lux\", \"text\", build_info_table(tt(self, \"lux_sensor_panel\", \"Lux Sensor\"), rows))\nend\n\n-- Refresh the wind selection panel and dropdown.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:refreshWindControls()\n  local selected_sensor_id = get_selected_wind_sensor_id(self)\n  local selected_sensor_value = self:hasWindSensorId(selected_sensor_id) and selected_sensor_id or UNSELECT_OPTION_VALUE\n  local saved_sensor_id = get_saved_wind_sensor_id(self)\n  local wind_value_text = self:formatLuxSensorValue(self.runtime.savedWindSensorValue, self.runtime.savedWindSensorUnit)\n  local wind_value_color = self.runtime.savedWindSensorValue ~= nil and CONFIG.colors.ok or CONFIG.colors.info\n  local wind_updated_at = tonumber(self.runtime.savedWindSensorUpdatedAt) or 0\n  local rows = {\n    { label = tt(self, \"available_sensors\", \"Available\"), value = tostring(#(self.runtime.windSensors or {})), valueColor = CONFIG.colors.ok },\n    { label = tt(self, \"saved_wind_sensor\", \"Saved wind sensor\"), value = self:getWindSensorDisplay(saved_sensor_id), valueColor = CONFIG.colors.ok },\n    { label = tt(self, \"selected_sensor\", \"Selected\"), value = self:getWindSensorDisplay(selected_sensor_id), valueColor = CONFIG.colors.info },\n    { label = tt(self, \"current_value\", \"Current value\"), value = saved_sensor_id ~= nil and wind_value_text or tt(self, \"not_selected\", \"Not selected\"), valueColor = wind_value_color },\n    { label = tt(self, \"last_value_update\", \"Last update\"), value = wind_updated_at > 0 and format_datetime(wind_updated_at) or tt(self, \"waiting_for_event\", \"Waiting for value\"), valueColor = CONFIG.colors.info },\n    { label = tt(self, \"last_scan\", \"Last scan\"), value = format_datetime(self.runtime.lastWindScanAt), valueColor = CONFIG.colors.info },\n  }\n\n  if selected_sensor_id ~= nil and selected_sensor_id ~= saved_sensor_id then\n    rows[#rows + 1] = {\n      label = tt(self, \"status\", \"Status\"),\n      value = tt(self, \"pending_save\", \"Pending save\"),\n      valueColor = CONFIG.colors.title,\n    }\n  end\n\n  self:safeUpdateView(\"wind_select\", \"options\", self:buildWindOptions())\n  self:safeUpdateView(\"wind_select\", \"selectedItem\", selected_sensor_value)\n  self:safeUpdateView(\"wind_select\", \"text\", tt(self, \"wind_sensor_dropdown\", \"Wind Sensor\"))\n  self:safeUpdateView(\"wind_save\", \"text\", tt(self, \"save_wind_sensor\", \"Save Wind Sensor\"))\n  self:safeUpdateView(\"info_wind\", \"text\", build_info_table(tt(self, \"wind_sensor_panel\", \"Wind Sensor\"), rows))\nend\n\n-- Refresh the screens multi-select panel and dropdown.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:refreshScreenControls(update_dropdown)\n  local selected_ids = get_selected_screen_device_ids(self)\n  local valid_selected_ids = self:filterValidScreenDeviceIds(selected_ids)\n  local saved_ids = get_saved_screen_device_ids(self)\n  local rows = {\n    { label = tt(self, \"screen_count\", \"Screens\"), value = tostring(#(self.runtime.screenDevices or {})), valueColor = CONFIG.colors.ok },\n    { label = tt(self, \"saved_screens\", \"Saved screens\"), value = self:getScreenDevicesDisplay(saved_ids), valueColor = CONFIG.colors.ok, fullWidth = true },\n    { label = tt(self, \"selected_screens\", \"Selected screens\"), value = self:getScreenDevicesDisplay(valid_selected_ids), valueColor = CONFIG.colors.info, fullWidth = true },\n    { label = tt(self, \"last_scan\", \"Last scan\"), value = format_datetime(self.runtime.lastScreenScanAt), valueColor = CONFIG.colors.info },\n  }\n\n  if table.concat(valid_selected_ids, \",\") ~= table.concat(saved_ids, \",\") then\n    rows[#rows + 1] = {\n      label = tt(self, \"status\", \"Status\"),\n      value = tt(self, \"pending_save\", \"Pending save\"),\n      valueColor = CONFIG.colors.title,\n    }\n  end\n\n  if update_dropdown ~= false then\n    self:safeUpdateView(\"screens_select\", \"options\", self:buildScreenOptions())\n    self:safeUpdateView(\"screens_select\", \"selectedItems\", valid_selected_ids)\n    self:safeUpdateView(\"screens_select\", \"text\", tt(self, \"screen_dropdown\", \"Screens\"))\n    self:safeUpdateView(\"screens_save\", \"text\", tt(self, \"save_screens\", \"Save Screens\"))\n  end\n  self:safeUpdateView(\"info_screens\", \"text\", build_info_table(tt(self, \"screen_panel\", \"Screens\"), rows))\nend\n\n-- Refresh the screen action/event log shown above the screen selection panel.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:refreshEventLogLabel()\n  local rows = {}\n  local log = self:getEventLog()\n  if #log == 0 then\n    rows[1] = {\n      label = tt(self, \"status\", \"Status\"),\n      value = tt(self, \"no_events\", \"Waiting for screen events\"),\n      valueColor = CONFIG.colors.info,\n    }\n  else\n    for index = #log, 1, -1 do\n      local entry = log[index]\n      rows[#rows + 1] = {\n        label = format_status_timestamp(entry.at),\n        value = tostring(entry.message or \"\"),\n        valueColor = log_level_color(entry.level),\n        fullWidth = true,\n      }\n    end\n  end\n\n  self:safeUpdateView(\"info_events\", \"text\", build_info_table(tt(self, \"event_log\", \"Events\"), rows))\nend\n\n-- Refresh the QA language panel and dropdown.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:refreshLanguageControls()\n  local stored_language = get_saved_language_code(self)\n  local selected_language = get_dropdown_language_code(self)\n  local rows = {\n    { label = tt(self, \"qa_language\", \"QA language\"), value = stored_language, valueColor = CONFIG.colors.ok },\n    { label = tt(self, \"hub_default_language\", \"Hub default\"), value = tostring(self.runtime.hubLanguageCode or \"en\"), valueColor = CONFIG.colors.info },\n    { label = tt(self, \"selected_language\", \"Selected\"), value = selected_language, valueColor = CONFIG.colors.info },\n  }\n\n  if selected_language ~= stored_language then\n    rows[#rows + 1] = {\n      label = tt(self, \"status\", \"Status\"),\n      value = tt(self, \"pending_save\", \"Pending save\"),\n      valueColor = CONFIG.colors.title,\n    }\n  end\n\n  self:safeUpdateView(\"language_select\", \"options\", LANGUAGE_OPTIONS)\n  self:safeUpdateView(\"language_select\", \"selectedItem\", selected_language)\n  self:safeUpdateView(\"language_select\", \"text\", tt(self, \"language_dropdown\", \"Language\"))\n  self:safeUpdateView(\"language_save\", \"text\", tt(self, \"save_language\", \"Save Language\"))\n  self:safeUpdateView(\"info_language\", \"text\", build_info_table(tt(self, \"language_panel\", \"Language\"), rows))\nend\n\n-- Refresh the short help card shown above diagnostics.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:refreshManualLabel()\n  local rows = {\n    { label = tt(self, \"qa_version\", \"QA version\"), value = tostring(version), valueColor = CONFIG.colors.info },\n    { label = tt(self, \"manual_step_1\", \"Step 1\"), value = tt(self, \"manual_select_lux\", \"Select a lux and wind sensor in the dropdown\"), valueColor = CONFIG.colors.info },\n    { label = tt(self, \"manual_step_2\", \"Step 2\"), value = tt(self, \"manual_save_lux\", \"Press Save Sensors to store the choice\"), valueColor = CONFIG.colors.info },\n    { label = tt(self, \"manual_step_3\", \"Step 3\"), value = tt(self, \"manual_startup_scan\", \"Startup scans HC3 for all lux sensors\"), valueColor = CONFIG.colors.info },\n    { label = tt(self, \"change_button\", \"Change\"), value = tt(self, \"manual_adjust_lux\", \"Change selects a setting, minus / plus adjusts the selected value\"), valueColor = CONFIG.colors.info },\n    { label = tt(self, \"manual_how_it_works\", \"How it works\"), value = tt(self, \"manual_lux_logic\", \"Lux Screen Up below runs when lux is below the up threshold and has been that for the screen up timer; Screen Down runs when lux is above the down threshold and has been that for the screen down timer\"), valueColor = CONFIG.colors.info },\n    { label = tt(self, \"wind_speed\", \"Wind Speed Above\"), value = tt(self, \"manual_wind_logic\", \"Wind protection uses the saved wind sensor and triggers above the wind threshold\"), valueColor = CONFIG.colors.info },\n    { label = tt(self, \"manual_screen_label\", \"Screens and will force the up position on the screen.\"), value = tt(self, \"manual_screen_logic\", \"Only saved screens are controlled\"), valueColor = CONFIG.colors.info },\n    { label = tt(self, \"save_state\", \"Save state\"), value = tt(self, \"manual_auto_save\", \"Changed settings are saved automatically after the countdown\"), valueColor = CONFIG.colors.info },\n  }\n\n  self:safeUpdateView(\"info_manual\", \"text\", build_info_table(tt(self, \"manual_title\", \"Manual\"), rows))\nend\n\n-- Refresh the diagnostics card with runtime metrics and recent log entries.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:refreshErrorStatusLabel()\n  local rows = {\n    { label = \"CPU now\", value = tostring(round_number(self.runtime.cpuUsagePct or 0, 4)) .. \" %\", valueColor = CONFIG.colors.info },\n    { label = \"CPU max\", value = tostring(round_number(self.store[CONFIG.storageKeys.cpuMaxPct] or 0, 4)) .. \" %\", valueColor = CONFIG.colors.info },\n    { label = \"Mem now\", value = tostring(round_number(self.runtime.memKb or 0, 0)) .. \" kB\", valueColor = CONFIG.colors.info },\n    { label = \"Mem max\", value = tostring(round_number(self.store[CONFIG.storageKeys.memMaxKb] or 0, 0)) .. \" kB\", valueColor = CONFIG.colors.info },\n    {\n      label = tt(self, \"last_error\", \"Last error\"),\n      value = self.runtime.lastError ~= \"\" and self.runtime.lastError or tt(self, \"none\", \"None\"),\n      valueColor = self.runtime.lastError ~= \"\" and CONFIG.colors.error or CONFIG.colors.ok,\n    },\n  }\n\n  local spacer = string.rep(\"\\n\", tonumber(CONFIG.ui.errorSpacerLines) or 15)\n  self:safeUpdateView(\"error_status\", \"text\", spacer ..\n    build_error_status_table(tt(self, \"diagnostics\", \"Diagnostics\"), rows, self:getStatusLog()))\nend\n\n-- Refresh common spacing labels used by the standard startup layout.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:refreshSpacingLabels()\n  local space_text = string.rep(\"\\n\", tonumber(CONFIG.ui.sectionSpacerLines) or 2)\n  local bottom_space = string.rep(\"\\n\", tonumber(CONFIG.ui.bottomSpacerLines) or 20)\n  self:safeUpdateView(\"space\", \"text\", space_text)\n  self:safeUpdateView(\"space2\", \"text\", bottom_space)\nend\n\n-- Refresh every visible QA label and dropdown.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:refreshAllUi()\n  self:refreshSpacingLabels()\n  self:refreshInfoLabel()\n  self:refreshValueControls()\n  self:refreshLuxControls()\n  self:refreshWindControls()\n  self:refreshEventLogLabel()\n  self:refreshScreenControls()\n  self:refreshLanguageControls()\n  self:refreshManualLabel()\n  self:refreshErrorStatusLabel()\n  self:refreshUserDescription()\nend\n\n-- ===========================================================\n-- ---------------Metrics----------------\n-- ===========================================================\n\n-- Sample memory and CPU usage for the diagnostics panel.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:sampleRuntimeMetrics()\n  local now = os.time()\n  local cpu_now = os.clock()\n  local delta_time = now - (tonumber(self.runtime.cpuTime) or now)\n  local delta_cpu = cpu_now - (tonumber(self.runtime.cpuClock) or cpu_now)\n  local mem_kb = read_memory_kb()\n  local cpu_pct = tonumber(self.runtime.cpuUsagePct) or 0\n\n  if self.runtime.cpuSampleReady and delta_time > 0 then\n    cpu_pct = (delta_cpu / delta_time) * 100\n  else\n    cpu_pct = 0\n    self.runtime.cpuSampleReady = true\n  end\n\n  self.runtime.cpuTime = now\n  self.runtime.cpuClock = cpu_now\n  self.runtime.cpuUsagePct = cpu_pct\n  self.runtime.memKb = mem_kb\n  self.store[CONFIG.storageKeys.memMaxKb] = math.max(tonumber(self.store[CONFIG.storageKeys.memMaxKb]) or 0, mem_kb)\n  self.store[CONFIG.storageKeys.cpuMaxPct] = math.max(tonumber(self.store[CONFIG.storageKeys.cpuMaxPct]) or 0, cpu_pct)\nend\n\n-- Start the periodic runtime metrics loop.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:startMetricsLoop()\n  local delay_ms = (tonumber(CONFIG.monitor.sampleSeconds) or 60) * 1000\n\n  local function loop()\n    local ok, err = pcall(function()\n      self:sampleRuntimeMetrics()\n      self:refreshErrorStatusLabel()\n      self.runtime.metricsTimer = setTimeout(loop, delay_ms)\n    end)\n    if not ok then self:storeError(\"startMetricsLoop failed: \" .. tostring(err)) end\n  end\n\n  self.runtime.metricsTimer = setTimeout(loop, delay_ms)\nend\n\n-- Refresh startup data after HC3 has had time to render the UI.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:startupRefresh()\n  local ok, err = pcall(function()\n    self:reloadLuxSensors()\n    self:reloadWindSensors()\n    self:reloadScreenDevices()\n    self:registerLuxSensorValueListener()\n    self:registerWindSensorValueListener()\n    self:refreshSavedLuxSensorValue()\n    self:refreshSavedWindSensorValue()\n    self:sampleRuntimeMetrics()\n    self:refreshAllUi()\n  end)\n  if not ok then self:storeError(\"startupRefresh failed: \" .. tostring(err)) end\nend\n\n-- ===========================================================\n-- ---------------Callbacks----------------\n-- ===========================================================\n\n-- Handle one short threshold tap and suppress the phantom release after long hold.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:handleThresholdTap(just_released_key, widget_id, delta)\n  if self.runtime[just_released_key] then\n    self.runtime[just_released_key] = false\n    return\n  end\n\n  local changed = self:applyActiveLuxValueDelta(delta)\n  if changed then self:pulseSwitch(widget_id) end\nend\n\n-- Switch the active editable value between lux up and lux down.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:change(event)\n  if self.runtime.changeJustReleased then\n    self.runtime.changeJustReleased = false\n    return\n  end\n\n  self:cycleActiveLuxValue()\n  self:pulseSwitch(\"change\")\nend\n\n-- Keep the Change button visually active while it is held.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:change_ld(event)\n  self:setSwitchValue(\"change\", true)\nend\n\n-- Reset the Change button after a long hold and suppress the release event.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:change_lr(event)\n  self.runtime.changeJustReleased = true\n  self:setSwitchValue(\"change\", false)\nend\n\n-- Toggle manual automation disable for the configured disable timer.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:automation_disable(event)\n  local requested_on = event and event.values and event.values[1] == true\n  if requested_on then\n    self:enableAutomation(tt(self, \"automation_enabled\", \"Lux automation enabled\"))\n    self.runtime.savedLuxEventState = nil\n    self:logLuxEventState(self.runtime.savedLuxSensorValue)\n  else\n    self:disableAutomation(tt(self, \"automation_disabled\", \"Lux automation disabled\"))\n  end\nend\n\n-- Decrease the selected lux value by the single-click step.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:val_n(event)\n  local _, _, tap_step = self:getSettingConfig(self:getActiveLuxValueKey())\n  self:handleThresholdTap(\"valNJustReleased\", \"val_n\", -(tonumber(tap_step) or LUX_THRESHOLD_TAP_STEP))\nend\n\n-- Start repeating decrements every 300 ms while held.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:val_n_ld(event)\n  self:startThresholdHold(\"valNHoldTimer\", \"valNHoldChanged\", \"val_n\", -1)\nend\n\n-- Stop the repeating decrement and suppress the phantom release event.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:val_n_lr(event)\n  self:stopThresholdHold(\"valNHoldTimer\", \"valNHoldChanged\", \"valNJustReleased\", \"val_n\")\nend\n\n-- Increase the selected lux value by the single-click step.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:val_p(event)\n  local _, _, tap_step = self:getSettingConfig(self:getActiveLuxValueKey())\n  self:handleThresholdTap(\"valPJustReleased\", \"val_p\", tonumber(tap_step) or LUX_THRESHOLD_TAP_STEP)\nend\n\n-- Start repeating increments every 300 ms while held.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:val_p_ld(event)\n  self:startThresholdHold(\"valPHoldTimer\", \"valPHoldChanged\", \"val_p\", 1)\nend\n\n-- Stop the repeating increment and suppress the phantom release event.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:val_p_lr(event)\n  self:stopThresholdHold(\"valPHoldTimer\", \"valPHoldChanged\", \"valPJustReleased\", \"val_p\")\nend\n\n-- Store the pending lux sensor id from the single-select dropdown.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:lux_select(event)\n  local raw_value = event and event.values and event.values[1]\n  if tostring(raw_value or \"\") == UNSELECT_OPTION_VALUE or tostring(raw_value or \"\") == \"\" then\n    self.runtime.pendingLuxSensorId = UNSELECT_OPTION_VALUE\n    self:addStatusLog(\"info\", \"Lux dropdown selected Unselect\")\n    self:refreshLuxControls()\n    self:refreshInfoLabel()\n    return\n  end\n\n  local selected_id = normalize_device_id(raw_value)\n  if selected_id ~= nil and self:hasLuxSensorId(selected_id) then\n    self.runtime.pendingLuxSensorId = selected_id\n    self:addStatusLog(\"info\", \"Lux dropdown selected sensor ID \" .. selected_id)\n  else\n    self.runtime.pendingLuxSensorId = nil\n  end\n\n  self:refreshLuxControls()\n  self:refreshInfoLabel()\nend\n\n-- Save the currently selected lux sensor to persistent storage.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:lux_save(event)\n  local selected_id = get_selected_lux_sensor_id(self)\n  if self.runtime.pendingLuxSensorId == UNSELECT_OPTION_VALUE or selected_id == nil then\n    self.store[CONFIG.storageKeys.luxSensorId] = nil\n    self.runtime.pendingLuxSensorId = nil\n    self.runtime.lastError = \"\"\n    self:clearSavedLuxSensorValue()\n    self:addStatusLog(\"info\", \"Unselected lux sensor\")\n    self:refreshAllUi()\n    return\n  end\n\n  if not self:hasLuxSensorId(selected_id) then\n    self.runtime.lastError = tt(self, \"no_valid_lux_sensor\", \"No valid lux sensor selected\")\n    self:addStatusLog(\"warn\", self.runtime.lastError)\n    self:refreshAllUi()\n    return\n  end\n\n  self.store[CONFIG.storageKeys.luxSensorId] = selected_id\n  self.runtime.pendingLuxSensorId = nil\n  self.runtime.lastError = \"\"\n  self:refreshSavedLuxSensorValue()\n  self:addStatusLog(\"info\", \"Saved lux sensor ID \" .. selected_id)\n  self:addEventLog(\"info\", \"Saved lux sensor ID \" .. selected_id)\n  self:refreshAllUi()\nend\n\n-- Store the pending wind sensor id from the single-select dropdown.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:wind_select(event)\n  local raw_value = event and event.values and event.values[1]\n  if tostring(raw_value or \"\") == UNSELECT_OPTION_VALUE or tostring(raw_value or \"\") == \"\" then\n    self.runtime.pendingWindSensorId = UNSELECT_OPTION_VALUE\n    self:addStatusLog(\"info\", \"Wind dropdown selected Unselect\")\n    self:refreshWindControls()\n    self:refreshInfoLabel()\n    return\n  end\n\n  local selected_id = normalize_device_id(raw_value)\n  if selected_id ~= nil and self:hasWindSensorId(selected_id) then\n    self.runtime.pendingWindSensorId = selected_id\n    self:addStatusLog(\"info\", \"Wind dropdown selected sensor ID \" .. selected_id)\n  else\n    self.runtime.pendingWindSensorId = nil\n  end\n\n  self:refreshWindControls()\n  self:refreshInfoLabel()\nend\n\n-- Save the currently selected wind sensor to persistent storage.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:wind_save(event)\n  local selected_id = get_selected_wind_sensor_id(self)\n  if self.runtime.pendingWindSensorId == UNSELECT_OPTION_VALUE or selected_id == nil then\n    self.store[CONFIG.storageKeys.windSensorId] = nil\n    self.runtime.pendingWindSensorId = nil\n    self.runtime.lastError = \"\"\n    self:clearSavedWindSensorValue()\n    self:addStatusLog(\"info\", \"Unselected wind sensor\")\n    self:refreshAllUi()\n    return\n  end\n\n  if not self:hasWindSensorId(selected_id) then\n    self.runtime.lastError = tt(self, \"no_valid_wind_sensor\", \"No valid wind sensor selected\")\n    self:addStatusLog(\"warn\", self.runtime.lastError)\n    self:refreshAllUi()\n    return\n  end\n\n  self.store[CONFIG.storageKeys.windSensorId] = selected_id\n  self.runtime.pendingWindSensorId = nil\n  self.runtime.lastError = \"\"\n  self:refreshSavedWindSensorValue()\n  self:addStatusLog(\"info\", \"Saved wind sensor ID \" .. selected_id)\n  self:addEventLog(\"info\", \"Saved wind sensor ID \" .. selected_id)\n  self:refreshAllUi()\nend\n\n-- Store the pending screen ids from the multi-select dropdown.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:screens_select(event)\n  local raw_values = nil\n  if type(event) == \"table\" and type(event.values) == \"table\" then raw_values = event.values[1] end\n  if raw_values == nil and type(event) == \"table\" then raw_values = event.selectedItems or event.values end\n  local selected_ids = self:normalizeScreenSelectValues(raw_values)\n  self.runtime.pendingScreenDeviceIds = selected_ids\n  if #selected_ids > 0 then\n    self:addStatusLog(\"info\", \"Screens dropdown selected \" .. tostring(#selected_ids) .. \" device(s)\")\n  end\n\n  self:safeUpdateView(\"screens_select\", \"selectedItems\", selected_ids)\n  self:refreshScreenControls(false)\nend\n\n-- Save the currently selected screen devices to persistent storage.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:screens_save(event)\n  local selected_ids = self:filterValidScreenDeviceIds(get_selected_screen_device_ids(self))\n  if #selected_ids == 0 then\n    self.runtime.lastError = tt(self, \"no_valid_screens\", \"No valid screens selected\")\n    self:addStatusLog(\"warn\", self.runtime.lastError)\n    self:refreshAllUi()\n    return\n  end\n\n  self.store[CONFIG.storageKeys.screenDeviceIds] = selected_ids\n  self.runtime.pendingScreenDeviceIds = nil\n  self.runtime.lastError = \"\"\n  self:addStatusLog(\"info\", \"Saved \" .. tostring(#selected_ids) .. \" screen device(s)\")\n  self:addEventLog(\"info\", \"Saved \" .. tostring(#selected_ids) .. \" screen device(s)\")\n  self:refreshAllUi()\nend\n\n-- Store the pending QA language from the single-select dropdown.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:language_select(event)\n  local selected_language = normalize_language_code(event and event.values and event.values[1])\n  if selected_language ~= nil then\n    self.runtime.pendingLanguageCode = selected_language\n  else\n    self.runtime.pendingLanguageCode = nil\n  end\n\n  self:refreshAllUi()\nend\n\n-- Save the QA language to persistent storage.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:language_save(event)\n  local selected_language = get_dropdown_language_code(self)\n  self.store[CONFIG.storageKeys.languageCode] = selected_language\n  self.runtime.pendingLanguageCode = nil\n  self.runtime.lastError = \"\"\n  self:addStatusLog(\"info\", \"Saved QA language \" .. tostring(selected_language))\n  self:refreshAllUi()\nend\n\n-- ===========================================================\n-- ---------------QuickApp lifecycle----------------\n-- ===========================================================\n\n-- Initialise storage, runtime state, and the startup lux scan.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:onInit()\n  self:debug(self.name, self.id)\n  self.store = self:setupStorage()\n  self.runtime = self:buildRuntimeState()\n  self.runtime.hubLanguageCode = self:readHubDefaultLanguage()\n  self:setupDefaultStore()\n  self.runtime.automationDisabledUntil = 0\n  self.runtime.automationDisableTimer = nil\n  self:showUiWidgets()\n  self:applyStandardProperties()\n  self:addStatusLog(\"info\", \"QA started in \" .. tostring(round_number(os.clock() - start_clock, 4)) .. \" s\")\n  self:addEventLog(\"info\", \"QA started and waiting for lux/wind events\")\n  self:refreshAllUi()\n  self:startMetricsLoop()\n  setTimeout(function() self:startupRefresh() end, tonumber(CONFIG.ui.startupDelayMs) or 400)\nend\n\n-- Stop runtime timers when the QA is unloaded.\n-------------------------------------------------------------------------------------------\nfunction QuickApp:onDestroy()\n  if self.runtime and self.runtime.luxValuesPersistTimer ~= nil then\n    clearTimeout(self.runtime.luxValuesPersistTimer)\n    self.runtime.luxValuesPersistTimer = nil\n    if self.runtime.luxValuesCountdownTimer ~= nil then\n      clearTimeout(self.runtime.luxValuesCountdownTimer)\n      self.runtime.luxValuesCountdownTimer = nil\n    end\n    self.runtime.luxValuesPersistDeadline = 0\n    self.store[LUX_UP_STORAGE_KEY] = self:getLuxValue(\"luxUp\")\n    self.store[LUX_DOWN_STORAGE_KEY] = self:getLuxValue(\"luxDown\")\n    self.store[WIND_SPEED_STORAGE_KEY] = self:getLuxValue(\"windSpeed\")\n    self.store[WIND_BELOW_TIMER_SECONDS_STORAGE_KEY] = self:getLuxValue(\"windBelowTimerSeconds\")\n    self.store[DISABLE_TIMER_SECONDS_STORAGE_KEY] = self:getLuxValue(\"disableTimerSeconds\")\n    self.store[SCREEN_UP_TIMER_SECONDS_STORAGE_KEY] = self:getLuxValue(\"screenUpTimerSeconds\")\n    self.store[SCREEN_DOWN_TIMER_SECONDS_STORAGE_KEY] = self:getLuxValue(\"screenDownTimerSeconds\")\n  end\n  if self.runtime and self.runtime.changeHoldTimer ~= nil then clearTimeout(self.runtime.changeHoldTimer) end\n  if self.runtime and self.runtime.valNHoldTimer ~= nil then clearTimeout(self.runtime.valNHoldTimer) end\n  if self.runtime and self.runtime.valPHoldTimer ~= nil then clearTimeout(self.runtime.valPHoldTimer) end\n  if self.runtime and self.runtime.metricsTimer ~= nil then\n    clearTimeout(self.runtime.metricsTimer)\n    self.runtime.metricsTimer = nil\n  end\n  if self.runtime and self.runtime.screenActionTimer ~= nil then\n    clearTimeout(self.runtime.screenActionTimer)\n    self.runtime.screenActionTimer = nil\n  end\n  if self.runtime and self.runtime.windBelowTimer ~= nil then\n    clearTimeout(self.runtime.windBelowTimer)\n    self.runtime.windBelowTimer = nil\n  end\n  if self.runtime and self.runtime.automationDisableTimer ~= nil then\n    clearTimeout(self.runtime.automationDisableTimer)\n    self.runtime.automationDisableTimer = nil\n  end\n  if fibaro and fibaro._APP and fibaro._APP.trigger and type(fibaro._APP.trigger.stop) == \"function\" then\n    pcall(function() fibaro._APP.trigger.stop() end)\n  end\nend\n"},{"name":"Icon","isMain":false,"isOpen":false,"content":"local version = \"v1.0.0\"\nlocal revision_date = \"09/04/26 21:58:14\"\n\n--[[\nMIT License\n\nCopyright (c) 2026 Joachim Brors Sommerfeld\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n\n(Source: opensource.org)\n]]\n\n-- ===========================================================\n-- ---------------Icon Placeholder----------------\n-- ===========================================================\n\nScreensControllerIcon = ScreensControllerIcon or {}\n"},{"name":"Config","isMain":false,"isOpen":false,"content":"local qa_type = \"974.Screens Controller\"\nlocal version = \"v1.0.0\"\nlocal revision_date = \"02/05/26 03:19:28\"\n\n--[[\nMIT License\n\nCopyright (c) 2026 Joachim Brors Sommerfeld\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n\n(Source: opensource.org)\n]]\n\n-- ===========================================================\n-- ---------------Configuration----------------\n-- ===========================================================\n\nScreensControllerConfig = {\n  quickAppUuid = \"JBS974\",\n  colors = {\n    title = \"#e8890c\",\n    ok = \"#34c759\",\n    error = \"#ff3b30\",\n    info = \"#2196f3\",\n  },\n  ui = {\n    widthPx = 420,\n    titleFontSize = 4,\n    bodyFontSize = 2,\n    logFontSize = 1,\n    errorSpacerLines = 15,\n    sectionSpacerLines = 20,\n    bottomSpacerLines = 20,\n    startupDelayMs = 400,\n  },\n  monitor = {\n    sampleSeconds = 60,\n  },\n  adjust = {\n    minValue = 0,\n    maxValue = 50000,\n    tapStep = 100,\n    holdStep = 1000,\n    holdDelayMs = 2000,\n    holdRepeatMs = 300,\n    persistDelayMs = 5000,\n    defaultValue = 0,\n  },\n  lux = {\n    typeQuery = \"com.fibaro.lightSensor\",\n    unit = \"Lux\",\n  },\n  wind = {\n    typeQuery = \"com.fibaro.windSensor\",\n    speed = {\n      minValue = 0,\n      maxValue = 50,\n      tapStep = 1,\n      holdStep = 5,\n      defaultValue = 10,\n    },\n  },\n  timer = {\n    minSeconds = 0,\n    maxSeconds = 3600,\n    disableMaxSeconds = 86400,\n    tapStepSeconds = 10,\n    holdStepSeconds = 60,\n    holdFastStepSeconds = 3600,\n    defaultSeconds = 300,\n    defaultUpSeconds = 900,\n    defaultDownSeconds = 0,\n    defaultWindBelowSeconds = 300,\n    defaultDisableSeconds = 300,\n  },\n  screens = {\n    typeQueries = {\n      \"com.fibaro.rollerShutter\",\n      \"com.fibaro.baseShutter\",\n      \"com.fibaro.windowCovering\",\n      \"com.fibaro.multilevelSwitch\",\n    },\n  },\n  storageKeys = {\n    luxSensorId = \"lux_sensor_id\",\n    windSensorId = \"wind_sensor_id\",\n    screenDeviceIds = \"screen_device_ids\",\n    windSpeed = \"wind_speed\",\n    windBelowTimerSeconds = \"wind_below_t\",\n    disableTimerSeconds = \"disable_timer\",\n    screenUpTimerSeconds = \"screen_up_timer\",\n    screenDownTimerSeconds = \"screen_down_timer\",\n    luxThreshold = \"lux_threshold\",\n    luxUp = \"lux_up\",\n    luxDown = \"lux_down\",\n    languageCode = \"ui_language\",\n    statusLog = \"status_log\",\n    eventLog = \"event_log\",\n    memMaxKb = \"mem_max_kb\",\n    cpuMaxPct = \"cpu_max_pct\",\n  },\n  statusLogMax = 20,\n  eventLogMax = 10,\n  languageChoices = {\n    { code = \"en\", label = \"English\" },\n    { code = \"no\", label = \"Norwegian\" },\n    { code = \"en_US\", label = \"English (United States)\" },\n    { code = \"pl\", label = \"Polish\" },\n    { code = \"de\", label = \"German\" },\n    { code = \"fr\", label = \"French\" },\n    { code = \"es\", label = \"Spanish\" },\n    { code = \"it\", label = \"Italian\" },\n    { code = \"pt\", label = \"Portuguese\" },\n    { code = \"pt_br\", label = \"Portuguese (Brazil)\" },\n    { code = \"nl\", label = \"Dutch\" },\n    { code = \"da\", label = \"Danish\" },\n    { code = \"fi\", label = \"Finnish\" },\n    { code = \"sv\", label = \"Swedish\" },\n    { code = \"cs\", label = \"Czech\" },\n    { code = \"ru\", label = \"Russian\" },\n    { code = \"et\", label = \"Estonian\" },\n    { code = \"lt\", label = \"Lithuanian\" },\n    { code = \"hu\", label = \"Hungarian\" },\n    { code = \"sk\", label = \"Slovak\" },\n    { code = \"ka\", label = \"Georgian\" },\n    { code = \"ro\", label = \"Romanian\" },\n    { code = \"tr\", label = \"Turkish\" },\n    { code = \"zh_hans\", label = \"Chinese (Simplified)\" },\n    { code = \"ja\", label = \"Japanese\" },\n    { code = \"ar\", label = \"Arabic\" },\n  },\n}\n"},{"name":"Language","isMain":false,"isOpen":false,"content":"local qa_type = \"974.Screens Controller\"\nlocal version = \"v1.0.0\"\nlocal revision_date = \"02/05/26 02:42:15\"\n\n--[[\nMIT License\n\nCopyright (c) 2026 Joachim Brors Sommerfeld\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n\n(Source: opensource.org)\n]]\n\n-- ===========================================================\n-- ---------------Language Dictionary----------------\n-- ===========================================================\n\nScreensControllerLanguage = ScreensControllerLanguage or {}\n\nlocal TRANSLATIONS = {\n  en = {\n    qa_title = \"Screens Controller\",\n    qa_version = \"QA version\",\n    revision_date = \"Revision\",\n    lux_sensor_count = \"Lux sensors\",\n    lux_sensor_panel = \"Lux Sensor\",\n    lux_sensor_dropdown = \"Lux Sensor\",\n    save_lux_sensor = \"Save Lux Sensor\",\n    available_sensors = \"Available\",\n    saved_sensor = \"Saved sensor\",\n    current_lux_value = \"Current lux\",\n    last_value_update = \"Last update\",\n    waiting_for_event = \"Waiting for value\",\n    selected_sensor = \"Selected\",\n    last_scan = \"Last scan\",\n    status = \"Status\",\n    pending_save = \"Pending save\",\n    not_selected = \"Not selected\",\n    unselect = \"Unselect\",\n    missing_sensor = \"Missing sensor\",\n    no_lux_sensors = \"No lux sensors found\",\n    no_valid_lux_sensor = \"No valid lux sensor selected\",\n    wind_sensor_count = \"Wind sensors\",\n    wind_sensor_panel = \"Wind Sensor\",\n    wind_sensor_dropdown = \"Wind Sensor\",\n    save_wind_sensor = \"Save Wind Sensor\",\n    saved_wind_sensor = \"Saved wind sensor\",\n    no_wind_sensors = \"No wind sensors found\",\n    no_valid_wind_sensor = \"No valid wind sensor selected\",\n    screen_count = \"Screens\",\n    screen_panel = \"Screens\",\n    screen_dropdown = \"Screens\",\n    save_screens = \"Save Screens\",\n    saved_screens = \"Saved screens\",\n    selected_screens = \"Selected screens\",\n    no_screens = \"No screens found\",\n    no_valid_screens = \"No valid screens selected\",\n    settings = \"Settings\",\n    wind_speed = \"Wind Speed Above\",\n    wind_below_timer = \"Wind speed below timer\",\n    disable_timer = \"Disable Lux automation timer\",\n    screen_up_timer = \"Screen up timer\",\n    screen_down_timer = \"Screen down timer\",\n    seconds = \"seconds\",\n    language_panel = \"Language\",\n    language_dropdown = \"Language\",\n    save_language = \"Save Language\",\n    qa_language = \"QA language\",\n    hub_default_language = \"Hub default\",\n    selected_language = \"Selected\",\n    manual_title = \"Manual\",\n    manual_step_1 = \"Step 1\",\n    manual_step_2 = \"Step 2\",\n    manual_step_3 = \"Step 3\",\n    manual_select_lux = \"Select a lux and wind sensor in the dropdown\",\n    manual_save_lux = \"Press Save Sensors to store the choice\",\n    manual_startup_scan = \"Startup scans HC3 for all lux sensors\",\n    manual_adjust_lux = \"Change selects a setting, minus / plus adjusts the selected value\",\n    manual_how_it_works = \"How it works\",\n    manual_lux_logic = \"Lux Screen Up below runs when lux is below the up threshold and has been that for the screen up timer; Screen Down runs when lux is above the down threshold and has been that for the screen down timer\",\n    manual_wind_logic = \"Wind protection uses the saved wind sensor, forces screens up above the wind threshold, and resumes lux control after the wind below timer\",\n    manual_screen_label = \"Screens and will force the up position on the screen.\",\n    manual_screen_logic = \"Only saved screens are controlled\",\n    manual_auto_save = \"Changed settings are saved automatically after the countdown\",\n    automation_disabled = \"Lux automation disabled\",\n    automation_enabled = \"Lux automation enabled\",\n    lux_automation_on = \"Lux automation ON\",\n    lux_automation_off = \"Lux automation OFF\",\n    event_log = \"Events\",\n    no_events = \"Waiting for screen events\",\n    current_value = \"Current value\",\n    value_range = \"Value range\",\n    tap_step = \"Single click\",\n    hold_step = \"Hold 0-2 sec / over 2 sec\",\n    save_state = \"Save state\",\n    saved = \"Saved\",\n    lux_values = \"Lux values\",\n    lux_up = \"Lux Screen Up below\",\n    lux_down = \"Lux Screen Down Above\",\n    above = \"Above\",\n    below = \"Below\",\n    selected_value = \"Selected value\",\n    lux_threshold = \"Lux threshold\",\n    change_button = \"Change\",\n    diagnostics = \"Diagnostics\",\n    last_error = \"Last error\",\n    none = \"None\",\n  },\n  no = {\n    qa_title = \"Screens Controller\",\n    qa_version = \"QA versjon\",\n    revision_date = \"Revisjon\",\n    lux_sensor_count = \"Lux sensorer\",\n    lux_sensor_panel = \"Lux sensor\",\n    lux_sensor_dropdown = \"Lux sensor\",\n    save_lux_sensor = \"Lagre lux sensor\",\n    available_sensors = \"Tilgjengelige\",\n    saved_sensor = \"Lagret sensor\",\n    current_lux_value = \"Lux verdi\",\n    last_value_update = \"Siste oppdatering\",\n    waiting_for_event = \"Venter pa verdi\",\n    selected_sensor = \"Valgt\",\n    last_scan = \"Siste scan\",\n    status = \"Status\",\n    pending_save = \"Venter pa lagring\",\n    not_selected = \"Ikke valgt\",\n    unselect = \"Fjern valg\",\n    missing_sensor = \"Sensor mangler\",\n    no_lux_sensors = \"Fant ingen lux sensorer\",\n    no_valid_lux_sensor = \"Ingen gyldig lux sensor er valgt\",\n    wind_sensor_count = \"Wind sensorer\",\n    wind_sensor_panel = \"Wind sensor\",\n    wind_sensor_dropdown = \"Wind sensor\",\n    save_wind_sensor = \"Lagre wind sensor\",\n    saved_wind_sensor = \"Lagret wind sensor\",\n    no_wind_sensors = \"Fant ingen wind sensorer\",\n    no_valid_wind_sensor = \"Ingen gyldig wind sensor er valgt\",\n    screen_count = \"Screens\",\n    screen_panel = \"Screens\",\n    screen_dropdown = \"Screens\",\n    save_screens = \"Lagre screens\",\n    saved_screens = \"Lagrede screens\",\n    selected_screens = \"Valgte screens\",\n    no_screens = \"Fant ingen screens\",\n    no_valid_screens = \"Ingen gyldige screens er valgt\",\n    settings = \"Innstillinger\",\n    wind_speed = \"Vindhastighet over\",\n    wind_below_timer = \"Vindhastighet under timer\",\n    disable_timer = \"Deaktiver lux timer\",\n    screen_up_timer = \"Skjerm opp timer\",\n    screen_down_timer = \"Skjerm ned timer\",\n    seconds = \"sekunder\",\n    language_panel = \"Sprak\",\n    language_dropdown = \"Sprak\",\n    save_language = \"Lagre sprak\",\n    qa_language = \"QA sprak\",\n    hub_default_language = \"Hub standardsprak\",\n    selected_language = \"Valgt\",\n    manual_title = \"Manual\",\n    manual_step_1 = \"Steg 1\",\n    manual_step_2 = \"Steg 2\",\n    manual_step_3 = \"Steg 3\",\n    manual_select_lux = \"Select a lux and wind sensor in the dropdown\",\n    manual_save_lux = \"Press Save Sensors to store the choice\",\n    manual_startup_scan = \"Oppstart scanner HC3 etter alle lux sensorer\",\n    manual_adjust_lux = \"Change velger innstilling, minus / pluss justerer valgt verdi\",\n    manual_how_it_works = \"How it works\",\n    manual_lux_logic = \"Lux Screen Up below runs when lux is below the up threshold and has been that for the screen up timer; Screen Down runs when lux is above the down threshold and has been that for the screen down timer\",\n    manual_wind_logic = \"Wind protection uses the saved wind sensor, forces screens up above the wind threshold, and resumes lux control after the wind below timer\",\n    manual_screen_label = \"Screens and will force the up position on the screen.\",\n    manual_screen_logic = \"Only saved screens are controlled\",\n    manual_auto_save = \"Changed settings are saved automatically after the countdown\",\n    automation_disabled = \"Lux automatikk er deaktivert\",\n    automation_enabled = \"Lux automatikk er aktiv\",\n    lux_automation_on = \"Lux automatikk PA\",\n    lux_automation_off = \"Lux automatikk AV\",\n    event_log = \"Events\",\n    no_events = \"Waiting for screen events\",\n    current_value = \"Naverdi\",\n    value_range = \"Verdiomrade\",\n    tap_step = \"Enkelt trykk\",\n    hold_step = \"Hold 0-2 sek / over 2 sek\",\n    save_state = \"Lagringsstatus\",\n    saved = \"Lagret\",\n    lux_values = \"Lux verdier\",\n    lux_up = \"Screen Opp, under:\",\n    lux_down = \"Screen Ned, over:\",\n    above = \"Over\",\n    below = \"Under\",\n    selected_value = \"Valgt verdi\",\n    lux_threshold = \"Lux grense\",\n    change_button = \"Change\",\n    diagnostics = \"Diagnostikk\",\n    last_error = \"Siste feil\",\n    none = \"Ingen\",\n  },\n}\n\n-- Return one translated string with English fallback.\n-------------------------------------------------------------------------------------------\nfunction ScreensControllerLanguage.get(code, key, fallback)\n  local wanted_code = tostring(code or \"en\"):lower()\n  local wanted_key = tostring(key or \"\")\n  local selected = TRANSLATIONS[wanted_code] or TRANSLATIONS.en or {}\n  local english = TRANSLATIONS.en or {}\n  return selected[wanted_key] or english[wanted_key] or fallback or wanted_key\nend\n"},{"name":"Eventlib","isMain":false,"isOpen":false,"content":"------- examples/EventLib.lua ----------\r\n--[[\r\nEventLib - Advanced Event Handling Library for Fibaro HC3\r\nCopyright (c) 2024 Jan Gabrielsson\r\nEmail: jan@gabrielsson.com\r\n\r\nFeatures:\r\n  - Pattern matching with variable extraction ($var) and constraints ($var>10)\r\n  - Multiple event types: device, timer, cron, global variables, custom events, etc.\r\n  - Time specifications: relative (+/HH:MM), absolute (HH:MM), sunrise/sunset\r\n  - State tracking with trueFor() for debouncing and time-based conditions\r\n  - Event transformation and filtering\r\n  - Resource helpers (DEV, GLOB) for cleaner code\r\n  - Two API styles: Event_basic (functional) and Event_std (object-oriented)\r\n  - Automatic cleanup and resource management\r\n\r\nUsage:\r\n  Event = Event_std\r\n\r\n  Event.id = \"MyHandler\"\r\n  Event{type='device', id=123, property='value'}\r\n  function Event:handler(event)\r\n    self:debug(\"Device changed to: \" .. event.value)\r\n  end\r\n\r\n                    GNU GENERAL PUBLIC LICENSE\r\n                       Version 3, 29 June 2007\r\n\r\n Copyright (C) 2007 Free Software Foundation, Inc. <https://fsf.org/>\r\n Everyone is permitted to copy and distribute verbatim copies\r\n of this license document, but changing it is not allowed.\r\n--]]\r\nlocal _version = \"0.52\"\r\nlocal _author = \"jan@gabrielsson.com\"\r\nlocal _trigger = {}\r\nlocal _builtin = {}\r\nlocal _handler = {}\r\nlocal _eMap = {}\r\nlocal post,handleEvent,trueFor,again,toTime,transformEvent\r\nlocal _inited = false\r\nlocal Event\r\n\r\nfibaro.debugFlags = fibaro.debugFlags or {}\r\n\r\nlocal fmt = string.format\r\nlocal function map(f, t) local r = {}; for _,v in ipairs(t) do r[#r+1]= f(v) end  return r end\r\nlocal function equal(e1,e2)\r\n  if e1==e2 then return true\r\n  else\r\n    if type(e1) ~= 'table' or type(e2) ~= 'table' then return false\r\n    else\r\n      for k1,v1 in pairs(e1) do if e2[k1] == nil or not equal(v1,e2[k1]) then return false end end\r\n      for k2,_  in pairs(e2) do if e1[k2] == nil then return false end end\r\n      return true\r\n    end\r\n  end\r\nend\r\nlocal function copy(t) if type(t) ~= 'table' then return t end local r = {} for k,v in pairs(t) do r[k] = copy(v) end return r end\r\nlocal function append(a,...) \r\n  local r = copy(a); \r\n  for _,b in ipairs({...}) do \r\n    for _,v in ipairs(b) do r[#r+1]=v end \r\n  end\r\nreturn r end\r\n\r\nlocal function color(col,str) return fmt('<font color=\"%s\">%s</font>',col,str) end\r\nlocal function timeStr(time) \r\n  if type(time) == 'string' then time = toTime(time) end\r\n  -- Consider times under 35 days as relative times that need current time added\r\n  local MAX_RELATIVE_TIME = 35*24*3600  -- 35 days in seconds\r\n  if time < MAX_RELATIVE_TIME then time=time+os.time() end\r\n  return os.date(\"%H:%M:%S\",time),time\r\nend\r\n\r\nlocal function DEBUG(tag,...) \r\n  if fibaro.debugFlags[tag] then fibaro.trace(__TAG,color('skyblue',fmt(...))) end \r\nend\r\n\r\ntable.map = map\r\ntable.copy = copy\r\ntable.equal = equal\r\ntable.append = append\r\nfibaro.color = color\r\n\r\n---------------- Lua Table to String ---------------\r\nlocal function encTsort(a,b) return a[1] < b[1] end\r\nlocal sortKeys = {\"type\",\"device\",\"deviceID\",\"id\",\"value\",\"oldValue\",\"val\",\"key\",\"arg\",\"event\",\"events\",\"msg\",\"res\"}\r\nlocal sortOrder,sortF={},nil\r\nfor i,s in ipairs(sortKeys) do sortOrder[s]=\"\\n\"..string.char(i+64)..\" \"..s end\r\nlocal function encEsort(a,b)\r\n  a,b=a[1],b[1]; a,b = sortOrder[a] or a, sortOrder[b] or b\r\n  return a < b\r\nend\r\nfunction table.maxn(t) local c=0 for _ in pairs(t) do c=c+1 end return c end\r\nlocal encT={}\r\nencT['nil'] = function(n,out) out[#out+1]='nil' end\r\nfunction encT.number(n,out) out[#out+1]=tostring(n) end\r\nfunction encT.userdata(u,out) out[#out+1]=tostring(u) end\r\nfunction encT.thread(t,out) out[#out+1]=tostring(t) end\r\nencT['function'] = function(f,out) out[#out+1]=tostring(f) end\r\nfunction encT.string(str,out) out[#out+1]='\"' out[#out+1]=str out[#out+1]='\"' end\r\nfunction encT.boolean(b,out) out[#out+1]=b and \"true\" or \"false\" end\r\nfunction encT.table(t,out)\r\n  local mt = getmetatable(t) if t and t.__tostring then return tostring(t) end\r\n  if next(t)==nil then return \"{}\" -- Empty table\r\n  elseif t[1]==nil then -- key value table\r\n    local r = {}; for k,v in pairs(t) do r[#r+1]={k,v} end table.sort(r,sortF)\r\n    out[#out+1]='{'\r\n    local e = r[1]\r\n    out[#out+1]=e[1]; out[#out+1]='='; encT[type(e[2])](e[2],out)\r\n    for i=2,table.maxn(r) do local e = r[i]; out[#out+1]=','; out[#out+1]=e[1]; out[#out+1]='='; encT[type(e[2])](e[2],out) end\r\n    out[#out+1]='}'\r\n  else -- array table\r\n    out[#out+1]='['\r\n    encT[type(t[1])](t[1],out)\r\n    for i=2,table.maxn(t) do out[#out+1]=',' encT[type(t[ i])](t[i],out) end\r\n    out[#out+1]=']'\r\n  end\r\nend\r\n\r\nlocal function encode(o,sort)\r\n  local out = {}\r\n  sortF = (not sort) and encEsort or encTsort\r\n  encT[type(o)](o,out)\r\n  return table.concat(out)\r\nend\r\n\r\n---------------- SunCalc -----------------\r\nlocal function sunturnTime(date, rising, latitude, longitude, zenith, local_offset)\r\n  local rad,deg,floor = math.rad,math.deg,math.floor\r\n  local frac = function(n) return n - floor(n) end\r\n  local cos = function(d) return math.cos(rad(d)) end\r\n  local acos = function(d) return deg(math.acos(d)) end\r\n  local sin = function(d) return math.sin(rad(d)) end\r\n  local asin = function(d) return deg(math.asin(d)) end\r\n  local tan = function(d) return math.tan(rad(d)) end\r\n  local atan = function(d) return deg(math.atan(d)) end\r\n\r\n  local function day_of_year(date2)\r\n    local n1 = floor(275 * date2.month / 9)\r\n    local n2 = floor((date2.month + 9) / 12)\r\n    local n3 = (1 + floor((date2.year - 4 * floor(date2.year / 4) + 2) / 3))\r\n    return n1 - (n2 * n3) + date2.day - 30\r\n  end\r\n\r\n  local function fit_into_range(val, min, max)\r\n    local range,count = max - min,nil\r\n    if val < min then count = floor((min - val) / range) + 1; return val + count * range\r\n    elseif val >= max then count = floor((val - max) / range) + 1; return val - count * range\r\n    else return val end\r\n  end\r\n\r\n  -- Convert the longitude to hour value and calculate an approximate time\r\n  local n,lng_hour,t =  day_of_year(date), longitude / 15,nil\r\n  if rising then t = n + ((6 - lng_hour) / 24) -- Rising time is desired\r\n  else t = n + ((18 - lng_hour) / 24) end -- Setting time is desired\r\n  local M = (0.9856 * t) - 3.289 -- Calculate the Sun^s mean anomaly\r\n  -- Calculate the Sun^s true longitude\r\n  local L = fit_into_range(M + (1.916 * sin(M)) + (0.020 * sin(2 * M)) + 282.634, 0, 360)\r\n  -- Calculate the Sun^s right ascension\r\n  local RA = fit_into_range(atan(0.91764 * tan(L)), 0, 360)\r\n  -- Right ascension value needs to be in the same quadrant as L\r\n  local Lquadrant = floor(L / 90) * 90\r\n  local RAquadrant = floor(RA / 90) * 90\r\n  RA = RA + Lquadrant - RAquadrant; RA = RA / 15 -- Right ascension value needs to be converted into hours\r\n  local sinDec = 0.39782 * sin(L) -- Calculate the Sun's declination\r\n  local cosDec = cos(asin(sinDec))\r\n  local cosH = (cos(zenith) - (sinDec * sin(latitude))) / (cosDec * cos(latitude)) -- Calculate the Sun^s local hour angle\r\n  if rising and cosH > 1 then return -1 --\"N/R\" -- The sun never rises on this location on the specified date\r\n  elseif cosH < -1 then return -1 end --\"N/S\" end -- The sun never sets on this location on the specified date\r\n\r\n  local H -- Finish calculating H and convert into hours\r\n  if rising then H = 360 - acos(cosH)\r\n  else H = acos(cosH) end\r\n  H = H / 15\r\n  local T = H + RA - (0.06571 * t) - 6.622 -- Calculate local mean time of rising/setting\r\n  local UT = fit_into_range(T - lng_hour, 0, 24) -- Adjust back to UTC\r\n  local LT = UT + local_offset -- Convert UT value to local time zone of latitude/longitude\r\n---@diagnostic disable-next-line: missing-fields\r\n  return os.time({day = date.day,month = date.month,year = date.year,hour = floor(LT),min = math.modf(frac(LT) * 60)})\r\nend\r\n\r\n---@diagnostic disable-next-line: param-type-mismatch\r\nlocal function getTimezone() local now = os.time() return os.difftime(now, os.time(os.date(\"!*t\", now))) end\r\n\r\nlocal function sunCalc(time)\r\n  local hc3Location = api.get(\"/settings/location\")\r\n  local lat = hc3Location.latitude or 0\r\n  local lon = hc3Location.longitude or 0\r\n  local utc = getTimezone() / 3600\r\n  local zenith,zenith_twilight = 90.83, 96.0 -- sunset/sunrise 90°50′, civil twilight 96°0′\r\n\r\n  local date = os.date(\"*t\",time or os.time())\r\n  if date.isdst then utc = utc + 1 end\r\n  local rise_time = os.date(\"*t\", sunturnTime(date, true, lat, lon, zenith, utc))\r\n  local set_time = os.date(\"*t\", sunturnTime(date, false, lat, lon, zenith, utc))\r\n  local rise_time_t = os.date(\"*t\", sunturnTime(date, true, lat, lon, zenith_twilight, utc))\r\n  local set_time_t = os.date(\"*t\", sunturnTime(date, false, lat, lon, zenith_twilight, utc))\r\n  local sunrise = fmt(\"%.2d:%.2d\", rise_time.hour, rise_time.min)\r\n  local sunset = fmt(\"%.2d:%.2d\", set_time.hour, set_time.min)\r\n  local sunrise_t = fmt(\"%.2d:%.2d\", rise_time_t.hour, rise_time_t.min)\r\n  local sunset_t = fmt(\"%.2d:%.2d\", set_time_t.hour, set_time_t.min)\r\n  return sunrise, sunset, sunrise_t, sunset_t\r\nend\r\n\r\n----------------- Cron ------------------\r\nlocal function dateTest(dateStr0)\r\n  local days = {sun=1,mon=2,tue=3,wed=4,thu=5,fri=6,sat=7}\r\n  local months = {jan=1,feb=2,mar=3,apr=4,may=5,jun=6,jul=7,aug=8,sep=9,oct=10,nov=11,dec=12}\r\n  local last,month = {31,28,31,30,31,30,31,31,30,31,30,31},nil\r\n\r\n  local function seq2map(seq) local s = {} for _,v in ipairs(seq) do s[v] = true end return s; end\r\n\r\n  local function flatten(seq,res) -- flattens a table of tables\r\n    res = res or {}\r\n    if type(seq) == 'table' then for _,v1 in ipairs(seq) do flatten(v1,res) end else res[#res+1] = seq end\r\n    return res\r\n  end\r\n\r\n  local function _assert(test,msg,...) if not test then error(fmt(msg,...),3) end end\r\n\r\n  local function expandDate(w1,md)\r\n    local function resolve(id)\r\n      local res\r\n      if id == 'last' then month = md res=last[md] \r\n      elseif id == 'lastw' then month = md res=last[md]-6 \r\n      else res= type(id) == 'number' and id or days[id] or months[id] or tonumber(id) end\r\n      _assert(res,\"Bad date specifier '%s'\",id) return res\r\n    end\r\n    local step = tonumber(1)\r\n    local w,m = w1[1],w1[2]\r\n    local start,stop = w:match(\"(%w+)%p(%w+)\")\r\n    if (start == nil) then return resolve(w) end\r\n    start,stop = resolve(start), resolve(stop)\r\n    local res,res2 = {},{}\r\n    if w:find(\"/\") then\r\n      if not w:find(\"-\") then -- 10/2\r\n        step=stop; stop = m.max\r\n      else step=tonumber((w:match(\"/(%d+)\"))) end\r\n    end\r\n    step = tonumber(step)\r\n    _assert(start>=m.min and start<=m.max and stop>=m.min and stop<=m.max,\"illegal date intervall\")\r\n    while (start ~= stop) do -- 10-2\r\n      res[#res+1] = start\r\n      start = start+1; if start>m.max then start=m.min end  \r\n    end\r\n    res[#res+1] = stop\r\n    if step > 1 then for i=1,#res,step do res2[#res2+1]=res[i] end; res=res2 end\r\n    return res\r\n  end\r\n\r\n  local function parseDateStr(dateStr) --,last)\r\n    local seq = string.split(dateStr,\" \")   -- min,hour,day,month,wday\r\n    assert(seq,\"Bad date string '%s'\",dateStr)\r\n    local lim = {{min=0,max=59},{min=0,max=23},{min=1,max=31},{min=1,max=12},{min=1,max=7},{min=2000,max=3000}}\r\n    for i=1,6 do if seq[i]=='*' or seq[i]==nil then seq[i]=tostring(lim[i].min)..\"-\"..lim[i].max end end\r\n    seq = map(function(w) return string.split(w,\",\") end, seq)   -- split sequences \"3,4\"\r\n    local month0 = os.date(\"*t\",os.time()).month\r\n    seq = map(function(t) local m = table.remove(lim,1);\r\n        return flatten(map(function (g) return expandDate({g,m},month0) end, t))\r\n      end, seq) -- expand intervalls \"3-5\"\r\n    return map(seq2map,seq)\r\n  end\r\n  local sun,offs,day,sunPatch = dateStr0:match(\"^(sun%a+) ([%+%-]?%d+)\")\r\n  if sun then\r\n    sun = sun..\"Hour\"\r\n    dateStr0=dateStr0:gsub(\"sun%a+ [%+%-]?%d+\",\"0 0\")\r\n    sunPatch=function(dateSeq)\r\n      local h,m = (fibaro.getValue(1,sun)):match(\"(%d%d):(%d%d)\")\r\n      dateSeq[1]={[(tonumber(h)*60+tonumber(m)+tonumber(offs))%60]=true}\r\n      dateSeq[2]={[math.floor((tonumber(h)*60+tonumber(m)+tonumber(offs))/60)]=true}\r\n    end\r\n  end\r\n  local dateSeq = parseDateStr(dateStr0)\r\n  return function(currDate) -- Pretty efficient way of testing dates...\r\n    local t = currDate or os.date(\"*t\",os.time())\r\n    if month and month~=t.month then dateSeq=parseDateStr(dateStr0) end -- Recalculate 'last' every month\r\n    if sunPatch and (month and month~=t.month or day~=t.day) then sunPatch(dateSeq) day=t.day end -- Recalculate sunset/sunrise\r\n    return\r\n    dateSeq[1][t.min] and    -- min     0-59\r\n    dateSeq[2][t.hour] and   -- hour    0-23\r\n    dateSeq[3][t.day] and    -- day     1-31\r\n    dateSeq[4][t.month] and  -- month   1-12\r\n    dateSeq[5][t.wday] or false      -- weekday 1-7, 1=sun, 7=sat\r\n  end\r\nend\r\n\r\nlocal cronItems = {}\r\nlocal cronRef,nxt = nil,0\r\nlocal function addCronItem(event) -- {type='cron',id=k, time='* * * * *'}\r\n  local dateTest = dateTest(event.time)\r\n  cronItems[dateTest] = event\r\n  local function loop()\r\n    local date = os.date(\"*t\",os.time())\r\n    for dateTest,event in pairs(cronItems) do\r\n      if dateTest(date) then post(event) end\r\n    end\r\n    nxt = nxt + 60\r\n    cronRef = setTimeout(loop,1000*(nxt-os.time()))\r\n  end\r\n  if cronRef == nil then\r\n    nxt = (os.time() // 60 + 1) *60\r\n    cronRef = setTimeout(loop,1000*(nxt-os.time())) \r\n  end\r\nend \r\n\r\n------------------ Time ---------------------------------\r\nlocal function midnight() local t = os.date(\"*t\"); t.hour,t.min,t.sec = 0,0,0; return os.time(t) end\r\n\r\n--- Convert time string to seconds\r\n-- Supports formats: \"HH:MM\", \"HH:MM:SS\", \"sunrise\", \"sunset\", \"sunrise+/-offset\"\r\n-- @param hmstr string Time string to parse\r\n-- @param ns boolean If true, calculate next sunrise/sunset\r\n-- @return number Time in seconds\r\nlocal function hm2sec(hmstr,ns)\r\n  if type(hmstr) ~= 'string' then \r\n    error(fmt(\"hm2sec expects string, got %s\", type(hmstr)), 2) \r\n  end\r\n  local offs,sun\r\n  sun,offs = hmstr:match(\"^(%a+)([+-]?%d*)\")\r\n  if sun and (sun == 'sunset' or sun == 'sunrise') then\r\n    if ns then\r\n      local sunrise,sunset = sunCalc(os.time()+24*3600)\r\n      hmstr,offs = sun=='sunrise' and sunrise or sunset, tonumber(offs) or 0\r\n    else\r\n      hmstr,offs = fibaro.getValue(1,sun..\"Hour\"), tonumber(offs) or 0\r\n    end\r\n  end\r\n  local sg,h,m,s = hmstr:match(\"^(%-?)(%d+):(%d+):?(%d*)\")\r\n  if not (h and m) then \r\n    error(fmt(\"Invalid time format '%s'. Expected 'HH:MM', 'HH:MM:SS', 'sunrise', or 'sunset'\", hmstr), 2) \r\n  end\r\n  return (sg == '-' and -1 or 1)*(tonumber(h)*3600+tonumber(m)*60+(tonumber(s) or 0)+(tonumber(offs or 0))*60)\r\nend\r\n\r\n--- Convert time specification to absolute time in seconds\r\n-- Supports multiple formats:\r\n--   number: absolute time\r\n--   \"+/HH:MM\": relative time from now\r\n--   \"n/HH:MM\": next occurrence (today or tomorrow)\r\n--   \"t/HH:MM\": today at HH:MM\r\n--   \"h/SS\": seconds into next hour\r\n--   \"m/SS\": seconds into next minute\r\n--   \"HH:MM\": time as seconds from midnight\r\n-- @param time string|number Time specification\r\n-- @return number Absolute time in seconds since epoch\r\nfunction toTime(time)\r\n  if type(time) == 'number' then return time end\r\n  if type(time) ~= 'string' then\r\n    error(fmt(\"toTime expects string or number, got %s\", type(time)), 2)\r\n  end\r\n  if #time < 2 then\r\n    error(fmt(\"Invalid time string '%s'. Too short\", time), 2)\r\n  end\r\n  local p = time:sub(1,2)\r\n  if p == '+/' then return hm2sec(time:sub(3))+os.time()\r\n  elseif p == 'n/' then\r\n    local t1,t2 = midnight()+hm2sec(time:sub(3),true),os.time()\r\n    return t1 > t2 and t1 or t1+24*60*60\r\n  elseif p == 't/' then return  hm2sec(time:sub(3))+midnight()\r\n  elseif p == 'h/' then\r\n    local t1,t2 = hm2sec(time:sub(3))//60,os.date(\"*t\")\r\n    local t0 = t2.min*60+t2.sec\r\n    t2.min,t2.sec = 0,0\r\n    local th = os.time(t2)\r\n    return (t1 >= t0 and th+t1 or th+t1+3600)\r\n  elseif p == 'm/' then\r\n    local t1,t2 = tonumber(time:sub(3)),os.date(\"*t\")\r\n    return 60-t2.sec+t1+os.time()\r\n  else return hm2sec(time) end\r\nend\r\n\r\nfunction fibaro.between(start,stop,optTime)\r\n  __assert_type(start,\"string\" )\r\n  __assert_type(stop,\"string\" )\r\n  start,stop,optTime=toTime(start),toTime(stop),optTime and toTime(optTime) or toTime(os.date(\"%H:%M\"))\r\n  stop = stop>=start and stop or stop+24*3600\r\n  optTime = optTime>=start and optTime or optTime+24*3600\r\n  return start <= optTime and optTime <= stop\r\nend\r\n------------------\r\n\r\nlocal function isEvent(e) return type(e) == 'table' and type(e.type)=='string' end\r\nlocal eventMT = {\r\n  --__eq = function(e1,e2) return equal(e1,e2) end,\r\n  __tostring = function(e) return fmt(\"#%s{%s\",e.type,encode(e):match(\",(.*)\")) end\r\n}\r\nlocal function addEventMT(event) if not getmetatable(event) then setmetatable(event,eventMT) end return event end\r\n\r\nlocal managedEvent = {}\r\n--- Manage timer events with optional alignment\r\n-- @param k string Handler identifier\r\n-- @param event table Event with 'time' and optional 'aligned' fields\r\n-- @return table Modified event\r\nfunction managedEvent.timer(k,event)\r\n  assert(event and type(event) == 'table', \"Timer event must be a table\")\r\n  assert(event.time, \"Timer event must have 'time' property\")\r\n  event = addEventMT(copy(event))\r\n  event.id = k\r\n  local t = toTime(event.time)\r\n  if event.aligned and type(event.time) == 'string' and event.time:sub(1,2) == '+/' then\r\n    local t0 = toTime(event.time:sub(3))\r\n    t = ((t-t0) // t0 + 1)*t0\r\n  end\r\n  --if event.aligned then print(\"ALIGN\",os.date(\"%c\",t)) end\r\n  if fibaro.debugFlags.post then\r\n    local tstr,t = timeStr(t)\r\n    DEBUG('post',\"post %s at %s-%s\",event,os.date(\"%d/%m\",t),tstr) \r\n  end\r\n  post({type='schedule',event=event,_sh=true},t)\r\n  return event\r\nend\r\n--- Manage cron events\r\n-- @param k string Handler identifier\r\n-- @param event table Event with 'time' field containing cron expression\r\n-- @return table Modified event\r\nfunction managedEvent.cron(k,event)\r\n  assert(event and type(event) == 'table', \"Cron event must be a table\")\r\n  assert(event.time, \"Cron event must have 'time' property with cron expression\")\r\n  event = addEventMT(copy(event))\r\n  event.id = k\r\n  addCronItem(event)\r\n  return event\r\nend\r\n--- Register a custom managed event type\r\n-- Managed events handle their own scheduling (like timer and cron)\r\n-- @param typ string Event type name\r\n-- @param fun function Manager function(handlerId, event) -> modifiedEvent\r\nfunction _builtin:_managedEvent(typ,fun)\r\n  assert(type(typ)=='string',\"Type expected\")\r\n  assert(type(fun)=='function',\"Function expected\")\r\n  managedEvent[typ] = fun\r\nend\r\n\r\nlocal function coerce(x,y) local x1 = tonumber(x) if x1 then return x1,tonumber(y) else return x,y end end\r\nlocal constraints = {}\r\nconstraints['=='] = function(val) return function(x) x,val=coerce(x,val) return x == val end end\r\nconstraints['<>'] = function(val) return function(x) return tostring(x):match(val) end end\r\nconstraints['>='] = function(val) return function(x) x,val=coerce(x,val) return x >= val end end\r\nconstraints['<='] = function(val) return function(x) x,val=coerce(x,val) return x <= val end end\r\nconstraints['>'] = function(val) return function(x) x,val=coerce(x,val) return x > val end end\r\nconstraints['<'] = function(val) return function(x) x,val=coerce(x,val) return x < val end end\r\nconstraints['~='] = function(val) return function(x) x,val=coerce(x,val) return x ~= val end end\r\nconstraints[''] = function(_) return function(x) return x ~= nil end end\r\n\r\n--- Compile event pattern with variable extraction and constraints\r\n-- Variables: $var, $var==val, $var~=val, $var>val, $var<val, $var>=val, $var<=val, $var<>pattern\r\n-- @param pattern table Pattern to compile\r\n-- @return table Compiled pattern with constraint functions\r\nlocal function compilePattern(pattern)\r\n  if type(pattern) == 'table' then\r\n    if pattern._var_ then return end\r\n    for k,v in pairs(pattern) do\r\n      if type(v) == 'string' and v:sub(1,1) == '$' then\r\n        local var,op,val = v:match(\"^$([%w_]*)([<>=~]*)(.*)\") \r\n        if not var then\r\n          error(fmt(\"Invalid pattern variable syntax '%s'. Expected $var, $var==val, $var>val, etc.\", v), 2)\r\n        end\r\n        var = var ==\"\" and \"_\" or var\r\n        -- Validate operator\r\n        if not constraints[op] then\r\n          local validOps = \"==, ~=, >, <, >=, <=, <> (pattern match)\"\r\n          error(fmt(\"Unknown constraint operator '%s' in '%s'. Valid operators: %s\", op, v, validOps), 2)\r\n        end\r\n        local c = constraints[op](tonumber(val) or val)\r\n        pattern[k] = {_var_=var, _constr=c, _str=v}\r\n      else compilePattern(v) end\r\n    end\r\n  end\r\n  return pattern\r\nend\r\n\r\nlocal function unify(pattern,expr,matches)\r\n  if pattern == expr then return true\r\n  elseif type(pattern) == 'table' then\r\n    if pattern._var_ then\r\n      local var, constr = pattern._var_, pattern._constr\r\n      if var == '_' then return constr(expr)\r\n      elseif matches[var] then return constr(expr) and unify(matches[var],expr,matches) -- Hmm, equal?\r\n      else matches[var] = expr return constr(expr) end\r\n    end\r\n    if type(expr) ~= \"table\" then return false end\r\n    for k,v in pairs(pattern) do if not unify(v,expr[k],matches) then return false end end\r\n    return true\r\n  else return false end\r\nend\r\n\r\nlocal toHash,fromHash={},{}\r\ntoHash['device'] = function(e) return \"device\"..(e.id or \"\")..(e.property or \"\") end\r\ntoHash['global-variable'] = function(e) return 'global-variable'..(e.name or \"\") end\r\ntoHash['quickvar'] = function(e) return 'quickvar'..(e.id or \"\")..(e.name or \"\") end\r\ntoHash['profile'] = function(e) return 'profile'..(e.property or \"\") end\r\ntoHash['weather'] = function(e) return 'weather'..(e.property or \"\") end\r\ntoHash['custom-event'] = function(e) return 'custom-event'..(e.name or \"\") end\r\ntoHash['deviceEvent'] = function(e) return 'deviceEvent'..(e.id or \"\")..(e.value or \"\") end\r\ntoHash['sceneEvent'] = function(e) return 'sceneEvent'..(e.id or \"\")..(e.value or \"\") end\r\ntoHash['timer'] = function(e) return 'timer'..(e.id or \"\")..(e.time or \"\") end\r\ntoHash['cron'] = function(e) return 'cron'..(e.id or \"\")..(e.time or \"\") end\r\n\r\nfromHash['device'] = function(e)\r\n  if not e.property then return {\"device\"..e.id,\"device\"} \r\n  else return {\"device\"..e.id..e.property,\"device\"..e.id,\"device\"..e.property,\"device\"} end\r\nend\r\nfromHash['global-variable'] = function(e) return {'global-variable'..e.name,'global-variable'} end\r\nfromHash['quickvar'] = function(e) return {\"quickvar\"..e.id..e.name,\"quickvar\"..e.id,\"quickvar\"..e.name,\"quickvar\"} end\r\nfromHash['profile'] = function(e) return {'profile'..e.property,'profile'} end\r\nfromHash['weather'] = function(e) return {'weather'..e.property,'weather'} end\r\nfromHash['custom-event'] = function(e) return {'custom-event'..e.name,'custom-event'} end\r\nfromHash['deviceEvent'] = function(e) return {\"deviceEvent\"..e.id..e.value,\"deviceEvent\"..e.id,\"deviceEvent\"..e.value,\"deviceEvent\"} end\r\nfromHash['sceneEvent'] = function(e) return {\"sceneEvent\"..e.id..e.value,\"sceneEvent\"..e.id,\"sceneEvent\"..e.value,\"sceneEvent\"} end\r\nfromHash['timer'] = function(e) return {\"timer\"..e.id..e.time} end\r\nfromHash['cron'] = function(e) return {\"cron\"..e.id..e.time} end\r\n\r\n--- Register an event pattern for a handler\r\n-- Validates and adds an event to the event map, enabling pattern matching\r\n-- @param k string Handler identifier  \r\n-- @param event table Event pattern (must have 'type' field)\r\nlocal function addEvent(k,event)\r\n  assert(isEvent(event),\"Event expected: must be table with 'type' field\")\r\n  addEventMT(event)\r\n  if managedEvent[event.type] then event = managedEvent[event.type](k,event) or event end\r\n  local pattern = copy(event)\r\n  compilePattern(pattern)\r\n  local key = toHash[event.type] and toHash[event.type](event) or event.type\r\n  local em = _eMap[key] or {}; _eMap[key]=em\r\n  for _,eventGroup in ipairs(em) do\r\n    if equal(event,eventGroup.event) then table.insert(eventGroup.handlers, k) return end\r\n  end\r\n  em[#em+1] = {event=event, pattern=pattern, handlers={k}}\r\nend\r\n\r\nlocal BREAK = '%%BREAK%%'\r\nlocal function lookupEvent(e,handler)\r\n  local keys = fromHash[e.type] and fromHash[e.type](e) or {e.type}\r\n  for _,key in ipairs(keys) do\r\n    local em = _eMap[key]\r\n    if em then\r\n      for _,eventGroup in ipairs(em) do\r\n        local match = {}\r\n        if unify(eventGroup.pattern,e,match) then\r\n          for _,k in ipairs(eventGroup.handlers) do\r\n            if handler(k,match) == BREAK then return end\r\n          end\r\n        end\r\n      end\r\n    end\r\n  end\r\nend\r\n\r\n---------------------------------\r\nlocal function init()\r\n  fibaro.debug(__TAG,\"EventLib v\".._version,_author)\r\n  Event:post({type='QAstart', _sh=true})\r\n  _inited=true\r\nend\r\n\r\nlocal eventTransformers = {}\r\n--- Register a custom event transformer\r\n-- Transformers convert one event type into one or more other events\r\n-- @param typ string Event type to transform  \r\n-- @param fun function Transformer function(event) -> {event1, event2, ...} or false\r\nfunction _builtin:_transformEvent(typ,fun)\r\n  assert(type(typ)=='string',\"Type expected\")\r\n  assert(type(fun)=='function',\"Function expected\")\r\n  eventTransformers[typ] = eventTransformers[typ] or {}\r\n  table.insert(eventTransformers[typ],fun)\r\nend\r\n\r\n--- Transform a single event into a list of events\r\n-- Applies registered transformers recursively with depth limit to prevent infinite loops\r\n-- @param event table Event to transform\r\n-- @param depth number Current recursion depth (internal use)\r\n-- @return table List of transformed events\r\nfunction transformEvent(event, depth) \r\n  depth = depth or 0\r\n  -- Prevent infinite transformation loops\r\n  if depth > 10 then \r\n    fibaro.warning(__TAG, fmt(\"Event transformation depth limit reached for event type '%s'\", event.type or \"unknown\"))\r\n    return {event} \r\n  end\r\n  \r\n  local tr = eventTransformers[event.type or \"\"]\r\n  if not tr then return {event} end\r\n  for _,fun in ipairs(tr) do\r\n    local nevent = fun(event)\r\n    if nevent then \r\n      return append(table.unpack(map(function(e) return transformEvent(e, depth+1) end, nevent))) \r\n    end\r\n  end\r\n  return {event}\r\nend\r\n\r\n--- Wait for a condition to remain true for a specified duration\r\n-- Returns true only after the condition has been continuously true for the given time\r\n-- Useful for debouncing and avoiding false triggers\r\n-- @param self table Handler context\r\n-- @param time number|string Duration to wait (seconds or time specification)\r\n-- @param cond boolean Current condition state\r\n-- @return boolean True if condition has been true for the full duration\r\nfunction trueFor(self,time,cond)\r\n  if self._trueForRef==true then \r\n    self._trueForRef = nil\r\n    return true \r\n  end\r\n  if not cond then\r\n    if self._trueForRef then \r\n      fibaro.cancel(self._trueForRef)\r\n      self._trueForRef = nil\r\n      self._trueForEvent = nil\r\n      self._trueForMatch = nil\r\n      return false \r\n    end\r\n  else\r\n    if self._trueForRef then \r\n      self._trueForEvent = self._event\r\n      self._trueForMatch = self._match\r\n      return false\r\n    else\r\n      self._trueForTime  = toTime(time)\r\n      self._trueForEvent = self._event\r\n      self._trueForMatch = self._match\r\n      local function success()\r\n        self._trueForRef = true\r\n        _handler[self.id](self._trueForEvent,self._trueForMatch)\r\n      end\r\n      self._trueForRef = setTimeout(success,1000*time)\r\n      return false\r\n    end\r\n  end\r\nend\r\n\r\n--- Repeat the handler after elapsed time interval (used with trueFor)\r\n-- Allows a handler to retrigger itself multiple times at regular intervals\r\n-- @param self table Handler context\r\n-- @param n number Maximum number of repeats (default: unlimited)\r\n-- @return number Current repeat count\r\nfunction again(self,n)\r\n  n = n or math.maxinteger\r\n  self._trueForAgain = self._trueForAgain or 0\r\n  if self._trueForAgain >= n-1 then return self._trueForAgain+1 end\r\n  self._trueForAgain = self._trueForAgain + 1\r\n  local function success()\r\n    self._trueForRef = true\r\n    _handler[self.id](self._trueForEvent,self._trueForMatch)\r\n  end\r\n  self._trueForRef = setTimeout(success,1000*self._trueForTime)\r\n  return self._trueForAgain\r\nend\r\n\r\nlocal function debugfun(f,...)\r\n  local args = {...}\r\n  if #args==1 then f(__TAG,args[1])\r\n  else f(__TAG,fmt(...)) end\r\nend\r\n\r\nlocal handlerMT = {\r\n  BREAK = BREAK,\r\n  again = again, \r\n  trueFor = trueFor,\r\n  post = function(k,event,time)\r\n    local timers = k._timers\r\n    if not timers then timers = {}; k._timers=timers end\r\n    local ref\r\n    ref = post(event,time,nil,function(event) timers[ref]=nil end)\r\n    timers[ref] = true\r\n  end,\r\n  cancel = function(k,ref) \r\n    fibaro.cancel(ref) \r\n    local timers = k._timers\r\n    if timers then timers[ref] = nil end  \r\n  end,\r\n  cancelAll = function(k) \r\n    local timers = k._timers\r\n    if timers then for t,_ in pairs(timers) do k:cancel(t) end  return true end\r\n  end,\r\n  enable = function(k) return fibaro.enable(k.id) end,\r\n  disable = function(k) k:cancelAll(); return fibaro.disable(k.id) end,\r\n  timer = function(k,t,f,...)\r\n    local args = {...}\r\n    return k:post({type='function',fun=f, args=args},t) \r\n  end,\r\n  between = function(_,...) return fibaro.between(...) end,\r\n  debug = function(self,...) fibaro.debug(__TAG,self._tag,...) end,\r\n  trace = function(self,...) fibaro.trace(__TAG,self._tag,...) end,\r\n  warning = function(self,...) fibaro.warning(__TAG,self._tag,...) end,\r\n  error = function(self,...) fibaro.error(__TAG,self._tag,...) end,\r\n  debugf = function(self,fmt,...) debugfun(fibaro.debug,(self._tag or \"\")..fmt,...) end,\r\n  tracef = function(self,fmt,...) debugfun(fibaro.trace,(self._tag or \"\")..fmt,...) end,\r\n  warningf = function(self,fmt,...) debugfun(fibaro.warning,(self._tag or \"\")..fmt,...) end,\r\n  errorf = function(self,fmt,...) debugfun(fibaro.error,(self._tag or \"\")..fmt,...) end,\r\n}\r\n\r\nlocal function createHandler(k,f)\r\n  local ht = { id = k }\r\n  return setmetatable({},{\r\n    __newindex = function(t,k,v)\r\n      if k == '_tag' and v~=nil then v = \"[\"..color(ht._tagColor or 'green',v)..\"] \" end\r\n      ht[k] = v\r\n    end,\r\n    __index = function(t,k) return ht[k]==nil and handlerMT[k] or ht[k] end,\r\n    __call = function(t,e,match) return f(t,e,match) end\r\n  })\r\nend\r\n\r\nlocal anonEvent = 1;\r\nlocal anonEventName = \"event:\"\r\nEvent = setmetatable({},{\r\n    __index = function(t,k)\r\n      if k == '_' then k = anonEventName..anonEvent end\r\n      if _builtin[k] then return _builtin[k] end\r\n      if not _inited then init() end\r\n      return function(...)\r\n        local es = {...}\r\n        if not es[1] then es = {es} end\r\n        es = append(table.unpack(map(transformEvent,es)))\r\n        if _trigger[k] then _trigger[k]=append(_trigger[k],es) \r\n        else _trigger[k]=es end\r\n        map(function(e) addEvent(k,e) end, es)\r\n      end\r\n    end,\r\n    __newindex = function(t,k,f)\r\n      if k == '_' then k = anonEventName..anonEvent; anonEvent = anonEvent + 1 end\r\n      assert(not _builtin[k],\"Can't redefine builtin Event function:\"..k)\r\n      assert(_trigger[k],\"Event not defined for: \"..tostring(k))\r\n      assert(not _handler[k],\"Handler already defined for: \"..tostring(k))\r\n      _handler[k]=createHandler(k,f)\r\n    end,\r\n    __call = function(t,k,event,f)\r\n      if k == '_' then k = anonEventName..anonEvent; anonEvent = anonEvent + 1 end\r\n      t[k](event)\r\n      _handler[k]=createHandler(k,f)\r\n      -- return ??\r\n    end\r\n  })\r\n\r\n--- Process an incoming event and trigger matching handlers\r\n-- Looks up handlers that match the event pattern and executes them\r\n-- @param event table Event to handle (must have 'type' field)\r\n-- @return any Result from handlers, or nil\r\nfunction handleEvent(event)\r\n  addEventMT(event)\r\n  return lookupEvent(event,function(k,match) \r\n    local handler = _handler[k]\r\n    if handler._disabled then return end\r\n    handler.date = os.date(\"*t\")\r\n    handler._event = event\r\n    handler._match = match\r\n    return handler(event,match)\r\n  end)\r\nend\r\n\r\n--- Post an event for processing now or in the future\r\n-- @param event table Event to post (must have 'type' field)\r\n-- @param time number|string Optional delay in seconds or time specification (default: 0)\r\n-- @param silent boolean If true, suppress debug output\r\n-- @param guard function Optional guard function called before handling\r\n-- @return userdata Timer reference, or nil if time is in the past\r\nfunction post(event,time,silent,guard)\r\n  assert(isEvent(event),\"Event expected: must be table with 'type' field\")\r\n  addEventMT(event)\r\n  local now = os.time()\r\n  time = toTime(time or 0)\r\n  -- Consider times under 72 hours as relative delays\r\n  local MAX_FUTURE_TIME = 72*3600  -- 72 hours in seconds\r\n  time = time < MAX_FUTURE_TIME and now+time or time\r\n  time = time-now\r\n  if time < 0 then return nil end\r\n  if not (event._sh or silent) then DEBUG('post',\"post %s at %s\",event,timeStr(time)) end\r\n  local handler = handleEvent\r\n  if guard then handler = function(event) guard(event) return handleEvent(event) end end\r\n  return setTimeout(function() handler(event) end,1000*time)\r\nend\r\n\r\nfibaro.post = post\r\n\r\n--- Cancel a scheduled timer\r\n-- @param ref userdata Timer reference returned from post() or setTimeout()\r\nfunction fibaro.cancel(ref) clearTimeout(ref) end\r\n\r\nlocal function isEnabled(k) return not _handler[k]._disabled end\r\n\r\n--- Enable a disabled event handler\r\n-- @param k string Handler identifier\r\nfunction fibaro.enable(k) \r\n  if not _handler[k] then\r\n    fibaro.warning(__TAG, fmt(\"Handler '%s' not found\", tostring(k)))\r\n    return\r\n  end\r\n  _handler[k]._disabled = nil \r\nend\r\n\r\n--- Disable an event handler (prevents it from triggering)\r\n-- @param k string Handler identifier  \r\nfunction fibaro.disable(k) \r\n  if not _handler[k] then\r\n    fibaro.warning(__TAG, fmt(\"Handler '%s' not found\", tostring(k)))\r\n    return\r\n  end\r\n  _handler[k]._disabled = true \r\nend\r\n\r\n--- Remove an event handler and clean up all associated resources\r\n-- Cancels all timers, removes from event map, and cleans up handler state\r\n-- @param k string Handler identifier to remove\r\n-- @return boolean True if handler was found and removed\r\nfunction fibaro.remove(k)\r\n  if not _handler[k] then \r\n    fibaro.warning(__TAG, fmt(\"Handler '%s' not found\", tostring(k)))\r\n    return false \r\n  end\r\n  \r\n  -- Cancel all timers associated with this handler\r\n  if _handler[k]._timers then\r\n    for ref,_ in pairs(_handler[k]._timers) do\r\n      fibaro.cancel(ref)\r\n    end\r\n  end\r\n  \r\n  -- Remove handler\r\n  _handler[k] = nil\r\n  \r\n  -- Clean up event map entries\r\n  for _,em in pairs(_eMap) do\r\n    for i = #em, 1, -1 do\r\n      local eventGroup = em[i]\r\n      for j = #eventGroup.handlers, 1, -1 do\r\n        if eventGroup.handlers[j] == k then\r\n          table.remove(eventGroup.handlers, j)\r\n        end\r\n      end\r\n      -- Remove event group if no handlers left\r\n      if #eventGroup.handlers == 0 then\r\n        table.remove(em, i)\r\n      end\r\n    end\r\n  end\r\n  \r\n  -- Clean up trigger\r\n  _trigger[k] = nil\r\n  \r\n  return true\r\nend\r\n\r\nfunction _builtin:post(...) return post(...) end\r\nfunction _builtin:cancel(...) return clearTimeout(...) end\r\nfunction _builtin:cancelAll(k) return _handler[k]:cancelAll() end\r\nfunction _builtin:enable(k) _handler[k]._disabled = nil end\r\nfunction _builtin:disable(k) _handler[k]._disabled = true end\r\nfunction _builtin:remove(k) return fibaro.remove(k) end\r\n--- Attach EventLib to HC3's RefreshState event stream\r\n-- Automatically receives and processes all HC3 system events\r\n-- Requires Trigger lib to be included\r\nfunction _builtin:attachRefreshstate(...)\r\n  assert(fibaro._APP.trigger,\"Trigger lib not included. Cannot attach to RefreshState.\")\r\n  function fibaro._APP.trigger.post(event) \r\n    if event.type=='device' and event.property=='icon' then return end\r\n    Event:post(event)\r\n  end\r\n  fibaro._APP.trigger.start()\r\nend\r\n\r\nEvent:_transformEvent('device',\r\nfunction(event)\r\n  if type(event.id)=='table' then\r\n    local res = {}\r\n    for _,id in ipairs(event.id) do\r\n      local nevent = copy(event)\r\n      nevent.id = id\r\n      res[#res+1] = nevent\r\n    end\r\n    return res\r\n  else return false end\r\nend)\r\n\r\nEvent.scheduler{type='schedule'}\r\nfunction Event:scheduler(event)\r\n  if isEnabled(event.event.id) then\r\n    post(event.event,0,true) \r\n    local tstr,t = timeStr(event.event.time)\r\n    DEBUG('post',\"post %s at %s-%s\",event.event,os.date(\"%d/%m\",t),tstr) \r\n  end\r\n  post(event,event.event.time)\r\nend\r\nEvent.func{type='function'}\r\nfunction Event:func(event) \r\n  local stat,err = pcall(event.fun,table.unpack(event.args or {}))\r\n  if not stat then fibaro.error(err) end\r\nend\r\n\r\nlocal Event2\r\ndo\r\n  local ID,FID = nil,nil\r\n  local key = {}\r\n  local props,dprops = {},{tag='_tag',tagColor='_tagColor',debug='_debug'}\r\n  local builtin = {}\r\n  function key.id(t,k,v) FID=v; ID = v==\"_\" and (anonEventName..anonEvent) or v; props = {} end\r\n  function key.handler(t,k,v) \r\n    assert(FID,\"Event: no Event.id declared\")\r\n    Event[FID] = v\r\n    for k,v in pairs(props) do if k~='tag' then _handler[ID][dprops[k]] = v end end\r\n    _handler[ID]._tag = props.tag and tostring(props.tag) or props.tag==nil and ID or nil\r\n    if props.debug then\r\n      fibaro.trace(__TAG,color('yellow',ID..\" defined\"))\r\n    end\r\n    ID=nil  \r\n  end\r\n  Event2 = setmetatable({},{\r\n    __index = function(t,k)\r\n      return builtin[k]\r\n    end,\r\n    __newindex = function(t,k,v)\r\n      if key[k] then \r\n        if k=='id' then assert(ID==nil,\"Event: not closed previous Event declaration:\"..(ID or \"\"))\r\n        else assert(ID~=nil,\"Event: no Event.id declared\") end\r\n        key[k](t,k,v) \r\n        return \r\n      elseif dprops[k] then props[k]=v; return end\r\n      error(\"Invalid Event key: \"..k,2)\r\n    end,\r\n    __call = function(t,event)\r\n      Event[ID](event)\r\n      -- return ??\r\n    end\r\n  }\r\n)\r\nfunction builtin:post(event,time) return Event:post(event,time) end\r\nfunction builtin:cancel(ref) return Event:cancel(ref) end\r\nfunction builtin:cancelAll(k) return Event:cancelAll(k) end\r\nfunction builtin:enable(k) return Event:enable(k) end\r\nfunction builtin:disable(k) return Event:disable(k) end\r\nfunction builtin:remove(k) return Event:remove(k) end\r\nfunction builtin:attachRefreshstate() return Event:attachRefreshstate() end\r\nend\r\n\r\n-------------------------------------\r\nEvent_basic = Event\r\nEvent_std = Event2\r\n\r\n------- lib/Trigger.lua ----------\r\nlocal exports = {\r\n  GlobalSourceTriggerGV = \"gkjhkjdfhgjhdsfgjhsdfgjhfdkj\"\r\n}\r\n\r\nlocal function equal(e1,e2)\r\n  if e1==e2 then return true\r\n  else\r\n    if type(e1) ~= 'table' or type(e2) ~= 'table' then return false\r\n    else\r\n      for k1,v1 in pairs(e1) do if e2[k1] == nil or not equal(v1,e2[k1]) then return false end end\r\n      for k2,_  in pairs(e2) do if e1[k2] == nil then return false end end\r\n      return true\r\n    end\r\n  end\r\nend\r\n\r\nlocal function quickVarEvent(d,_,post)\r\n  local old={}; for _,v in ipairs(d.oldValue) do old[v.name] = v.value end\r\n  for _,v in ipairs(d.newValue) do\r\n    if not equal(v.value,old[v.name]) then\r\n      post({type='quickvar', id=d.id, name=v.name, value=v.value, old=old[v.name]})\r\n    end\r\n  end\r\nend\r\n\r\n-- There are more, but these are what I seen so far...\r\n--[[\r\n{type='alarm', property='armed', id = <partitionId>, value=<boolean>}\r\n{type='alarm', property='breached', id = <partitionId>, value=<boolean>}\r\n{type='alarm', property='homeArmed', value=<boolean>\r\n{type='alarm', property='homeBreached', value=<boolean>\r\n{type='weather',property=<string>, value=<number>, old=<number>}\r\n{type='global-variable', name=<string>, value=<string>, old=<string>}\r\n{type='quickvar', id=<number>, name=<string>, value=<value>, old=<value>}\r\n{type='device', id=<number>, property=<string>, value=<value>, old=<value>}\r\n{type='device', id=<number>, property='centralSceneEvent', value={keyId=<number>, keyAttribute=<number>}}\r\n{type='device', id=<number>, property='sceneActivationEvent', value={sceneId=<number>}}\r\n{type='device', id=<number>, property='accessControlEvent', value=<table>}\r\n{type='custom-event', name=<string>, value=<string>}\r\n{type='deviceEvent', id=<number>, value='removed'}\r\n{type='deviceEvent', id=<number>, value='changedRoom'}\r\n{type='deviceEvent', id=<number>, value='created'}\r\n{type='deviceEvent', id=<number>, value='modified'}\r\n{type='deviceEvent', id=<number>, value='crashed', error=<string>}\r\n{type='sceneEvent', id=<number>, value='started'}\r\n{type='sceneEvent', id=<number>, value='finished'}\r\n{type='sceneEvent', id=<number>, value='instance', instance=<value>}\r\n{type='sceneEvent', id=<number>, value='removed'}\r\n{type='sceneEvent', id=<number>, value='modified'}\r\n{type='sceneEvent', id=<number>, value='created'}\r\n{type='onlineEvent', value=<boolean>}\r\n{type='profile',property='activeProfile',value=<string>, old=<string>}\r\n{type='ClimateZone', id=<number>, type=<string>, value=<string>, old=<string>}\r\n{type='ClimateZoneSetpoint', id=<number>, type=<string>, value=<number>, old=<number>}\r\n{type='notification', id=<number>, value='created'}\r\n{type='notification', id=<number>, value='removed'}\r\n{type='notification', id=<number>, value='updated'}\r\n{type='room', id=<number>, value='created'}\r\n{type='room', id=<number>, value='removed'}\r\n{type='room', id=<number>, value='modified'}\r\n{type='section', id=<number>, value='created'}\r\n{type='section', id=<number>, value='removed'}\r\n{type='section', id=<number>, value='modified'}\r\n{type='location',id=<number>,property=<string>,value=<string>,timestamp=<number>}\r\n{type='user',id=<number>,value='action',data=<value>}\r\n{type='system',value='action',data=<value>}\r\n--]]\r\nlocal EventTypes = {\r\n  AlarmPartitionArmedEvent = function(d,_,post) post({type='alarm', property='armed', id = d.partitionId, value=d.armed}) end,\r\n  AlarmPartitionBreachedEvent = function(d,_,post) post({type='alarm', property='breached', id = d.partitionId, value=d.breached}) end,\r\n  AlarmPartitionModifiedEvent = function(d,_,post)  end,\r\n  HomeArmStateChangedEvent = function(d,_,post) post({type='alarm', property='homeArmed', value=d.newValue}) end,\r\n  HomeDisarmStateChangedEvent = function(d,_,post) post({type='alarm', property='homeArmed', value=not d.newValue}) end,\r\n  HomeBreachedEvent = function(d,_,post) post({type='alarm', property='homeBreached', value=d.breached}) end,\r\n  WeatherChangedEvent = function(d,_,post) post({type='weather',property=d.change, value=d.newValue, old=d.oldValue}) end,\r\n  GlobalVariableChangedEvent = function(d,_,post)\r\n    if d.variableName == exports.GlobalSourceTriggerGV then\r\n      local stat,va = pcall(json.decode,d.newValue)\r\n      if not stat then return end\r\n      va._transID = nil\r\n      post(va)\r\n    else\r\n      post({type='global-variable', name=d.variableName, value=d.newValue, old=d.oldValue})\r\n    end\r\n  end,\r\n  GlobalVariableAddedEvent = function(d,_,post) post({type='global-variable', name=d.variableName, value=d.value, old=nil}) end,\r\n  DevicePropertyUpdatedEvent = function(d,_,post)\r\n    if d.property=='quickAppVariables' then quickVarEvent(d,_,post)\r\n    else\r\n      post({type='device', id=d.id, property=d.property, value=d.newValue, old=d.oldValue})\r\n    end\r\n  end,\r\n  CentralSceneEvent = function(d,_,post)\r\n    d.id,d.icon = d.id or d.deviceId,nil\r\n    post({type='device', property='centralSceneEvent', id=d.id, value={keyId=d.keyId, keyAttribute=d.keyAttribute}})\r\n  end,\r\n  SceneActivationEvent = function(d,_,post)\r\n    d.id = d.id or d.deviceId\r\n    post({type='device', property='sceneActivationEvent', id=d.id, value={sceneId=d.sceneId}})\r\n  end,\r\n  AccessControlEvent = function(d,_,post)\r\n    post({type='device', property='accessControlEvent', id=d.id, value=d})\r\n  end,\r\n  CustomEvent = function(d,_,post)\r\n    local value = api.get(\"/customEvents/\"..d.name)\r\n    post({type='custom-event', name=d.name, value=value and value.userDescription})\r\n  end,\r\n  PluginChangedViewEvent = function(d,_,post) post({type='PluginChangedViewEvent', value=d}) end,\r\n  WizardStepStateChangedEvent = function(d,_,post) post({type='WizardStepStateChangedEvent', value=d})  end,\r\n  UpdateReadyEvent = function(d,_,post) post({type='updateReadyEvent', value=d}) end,\r\n  DeviceRemovedEvent = function(d,_,post)  post({type='deviceEvent', id=d.id, value='removed'}) end,\r\n  DeviceChangedRoomEvent = function(d,_,post)  post({type='deviceEvent', id=d.id, value='changedRoom'}) end,\r\n  DeviceCreatedEvent = function(d,_,post)  post({type='deviceEvent', id=d.id, value='created'}) end,\r\n  DeviceModifiedEvent = function(d,_,post) post({type='deviceEvent', id=d.id, value='modified'}) end,\r\n  PluginProcessCrashedEvent = function(d,_,post) post({type='deviceEvent', id=d.deviceId, value='crashed', error=d.error}) end,\r\n  SceneStartedEvent = function(d,_,post)   post({type='sceneEvent', id=d.id, value='started'}) end,\r\n  SceneFinishedEvent = function(d,_,post)  post({type='sceneEvent', id=d.id, value='finished'})end,\r\n  SceneRunningInstancesEvent = function(d,_,post) post({type='sceneEvent', id=d.id, value='instance', instance=d}) end,\r\n  SceneRemovedEvent = function(d,_,post)  post({type='sceneEvent', id=d.id, value='removed'}) end,\r\n  SceneModifiedEvent = function(d,_,post)  post({type='sceneEvent', id=d.id, value='modified'}) end,\r\n  SceneCreatedEvent = function(d,_,post)  post({type='sceneEvent', id=d.id, value='created'}) end,\r\n  OnlineStatusUpdatedEvent = function(d,_,post) post({type='onlineEvent', value=d.online}) end,\r\n  ActiveProfileChangedEvent = function(d,_,post)\r\n    post({type='profile',property='activeProfile',value=d.newActiveProfile, old=d.oldActiveProfile})\r\n  end,\r\n  ClimateZoneChangedEvent = function(d,_,post) --ClimateZoneChangedEvent\r\n    if d.changes and type(d.changes)=='table' then\r\n      for _,c in ipairs(d.changes) do\r\n        c.type,c.id='ClimateZone',d.id\r\n        post(c)\r\n      end\r\n    end\r\n  end,\r\n  ClimateZoneSetpointChangedEvent = function(d,_,post) d.type = 'ClimateZoneSetpoint' post(d,_,post) end,\r\n  NotificationCreatedEvent = function(d,_,post) post({type='notification', id=d.id, value='created'}) end,\r\n  NotificationRemovedEvent = function(d,_,post) post({type='notification', id=d.id, value='removed'}) end,\r\n  NotificationUpdatedEvent = function(d,_,post) post({type='notification', id=d.id, value='updated'}) end,\r\n  RoomCreatedEvent = function(d,_,post) post({type='room', id=d.id, value='created'}) end,\r\n  RoomRemovedEvent = function(d,_,post) post({type='room', id=d.id, value='removed'}) end,\r\n  RoomModifiedEvent = function(d,_,post) post({type='room', id=d.id, value='modified'}) end,\r\n  SectionCreatedEvent = function(d,_,post) post({type='section', id=d.id, value='created'}) end,\r\n  SectionRemovedEvent = function(d,_,post) post({type='section', id=d.id, value='removed'}) end,\r\n  SectionModifiedEvent = function(d,_,post) post({type='section', id=d.id, value='modified'}) end,\r\n  QuickAppFilesChangedEvent = function(_) end,\r\n  ZwaveDeviceParametersChangedEvent = function(_) end,\r\n  ZwaveNodeAddedEvent = function(_) end,\r\n  RefreshRequiredEvent = function(_) end,\r\n  DeviceFirmwareUpdateEvent = function(_) end,\r\n  GeofenceEvent = function(d,_,post) post({type='location',id=d.userId,property=d.locationId,value=d.geofenceAction,timestamp=d.timestamp}) end,\r\n  DeviceActionRanEvent = function(d,e,post)\r\n    if e.sourceType=='user' then\r\n      post({type='user',id=e.sourceId,value='action',data=d})\r\n    elseif e.sourceType=='system' then\r\n      post({type='system',value='action',data=d})\r\n    end\r\n  end,\r\n  DeviceNotificationState = function(d,_,post)\r\n    post({type='device', id=d.id, property=d.notificationType, value=d.value})\r\n  end,\r\n}\r\n\r\nlocal refresh = RefreshStateSubscriber()\r\nlocal function filter(ev) return exports.filter(ev) end\r\n\r\nlocal function handler(ev)\r\n  if EventTypes[ev.type] then\r\n    EventTypes[ev.type](ev.data,ev,exports.post)\r\n  end\r\nend\r\nrefresh:subscribe(filter,handler)\r\n\r\nexports.start = function() refresh:run() end\r\nexports.stop = function() refresh:stop() end\r\nexports.filter = function(ev) return true end\r\nexports.post = function(ev)  end\r\n\r\nfibaro._APP = fibaro._APP or {}\r\nfibaro._APP.trigger = exports\r\n\r\n------- lib/RsrcLib.lua ----------\r\nlocal Event = Event_std\r\n\r\nlocal globs = {}\r\nlocal gprops = {\r\n  value = function(t,k) return fibaro.getGlobalVariable(t._gd.name) end\r\n}\r\nlocal GLOBMT = {\r\n  __index = function(t,k)\r\n    if gprops[k] then return gprops[k](t,k)\r\n    else return t._gd[k] end\r\n  end,\r\n  __newindex = function (t, k, v)\r\n    if k=='watch' then\r\n      Event.id='_'\r\n      Event{type='global-variable',name=t._gd.name}\r\n      function Event:handler(event)\r\n        v(self,event.value,event.old,t)\r\n      end\r\n    else t._gd[k]=v end\r\n  end,\r\n  __tostring = function(t) return t._gd.name end\r\n}\r\n--- Create a global variable helper object\r\n-- Provides easy access to global variables with watch capability\r\n-- @param name string Global variable name\r\n-- @return table Global variable object with .value and .watch properties\r\n-- @usage local myVar = GLOB(\"MyVariable\"); myVar.watch = function(self, new, old) ... end\r\nfunction GLOB(name)\r\n  assert(type(name) == 'string', \"GLOB expects variable name as string\")\r\n  if globs[name] then return globs[name] end\r\n  local gd = { name = name }\r\n  local g = setmetatable({_gd = gd},GLOBMT)\r\n  globs[name] = g\r\n  return g\r\nend\r\n\r\nlocal devs = {}\r\nlocal DEVMT = {\r\n  __index = function(t,k)\r\n    return t._dd.rsrc[k] or t._dd.rsrc.properties[k]\r\n  end,\r\n  __newindex = function (t, k, v)\r\n    local p = k:match('watch_(%w+)')\r\n    if p then\r\n      Event.id='_'\r\n      Event{type='device',id=t._dd.id,property=p}\r\n      function Event:handler(event)\r\n        v(self,event,t)\r\n      end\r\n    else t._dd[k]=v end\r\n  end,\r\n  __tostring = function(t) return t._dd.name end\r\n}\r\n--- Create a device helper object\r\n-- Provides easy access to device properties with watch capability\r\n-- @param id number Device ID\r\n-- @return table Device object with property accessors and watch_<property> methods\r\n-- @usage local light = DEV(123); light.watch_value = function(self, event) ... end\r\nfunction DEV(id)\r\n  assert(type(id) == 'number', \"DEV expects device ID as number\")\r\n  if devs[id] then return devs[id] end\r\n  local dd = { id = id, rsrc = api.get(\"/devices/\"..id) }\r\n  assert(dd.rsrc,fmt(\"Device %d not found in HC3\", id))\r\n  local d = setmetatable({_dd = dd},DEVMT)\r\n  devs[id] = d\r\n  return d\r\nend"}]}